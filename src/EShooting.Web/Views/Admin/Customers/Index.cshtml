        document.getElementById("changePackageSaveBtn")?.addEventListener("click", async function () {
            if (!currentPaymentsAthleteId) return;
            var pkgId = document.getElementById("changePackageSelect")?.value || "";
            if (!pkgId) { alert("Yeni paket seçin."); return; }
            await refreshChangePackagePreview();
            if (!lastChangePreview) { alert("Hesablama alınmadı."); return; }
            var justRenew = isJustRenewChecked();
            var planOnly = justRenew || !lastChangePreview.requiresNewPayment;
            var fixedWeekly = isChangePackageFixedWeekly();
            if (fixedWeekly) {
                var days = getSelectedChangeWeekdays();
                var dayLimit = Number(lastChangePreview.weeklyDaysCount || 0);
                if (!dayLimit) {
                    var pkg = changePackagesCache.find(function (p) { return String(p.id) === String(pkgId); });
                    dayLimit = Number(pkg && pkg.weeklyDaysCount || 0);
                }
                if (!days.length) {
                    alert("Aylıq plan üçün həftə günlərini seçin.");
                    return;
                }
                if (dayLimit >= 1 && days.length !== dayLimit) {
                    alert("Bu paket həftədə " + dayLimit + " gün üçündür — " + dayLimit + " gün seçin.");
                    return;
                }
            }
            syncChangePackageEndDate();
            var end = getChangePackageEndIso();
            if (!end) {
                alert("Bitmə tarixi hesablanmadı. Həftə günlərini seçin.");
                return;
            }
            var months = Math.min(12, Math.max(1, Number(document.getElementById("changePackageMonths")?.value || 1) || 1));
            var msg = justRenew
                ? "Ödəniş etmədən yenilənsin?\nSeçilmiş paket və müddət yazılacaq. Ödəniş tarixçəsi dəyişməyəcək."
                : planOnly
                    ? "Yalnız paket planı yenilənəcək.\nÖdəniş və gəliş tarixçəsi saxlanılacaq.\n\nDavam edilsin?"
                    : ("Mövcud paket bitmişdir.\nYeni paket üçün ödəniş: " + money(lastChangePreview.newPayable)
                        + " AZN.\n\nDavam edilsin?");
            if (!window.confirm(msg)) return;

            var start = document.getElementById("changePackageStart")?.value || isoToday();
            var payload = {
                newServicePackageId: pkgId,
                periodStartLocal: start,
                periodEndLocal: end,
                periodMonths: months,
                discountAmount: planOnly ? 0 : Number(document.getElementById("changePackageDiscount")?.value || 0),
                amountPaidCash: planOnly ? 0 : Number(document.getElementById("changePackageCash")?.value || 0),
                amountPaidCard: planOnly ? 0 : Number(document.getElementById("changePackageCard")?.value || 0),
                isComplimentary: planOnly ? false : !!document.getElementById("changePackageComplimentary")?.checked,
                confirmDifference: true,
                skipPayment: justRenew,
                weeklyDaysOfWeek: fixedWeekly ? getSelectedChangeWeekdays() : null,
                weeklyStartTimeLocal: fixedWeekly
                    ? (document.getElementById("changePackageWeeklyTime")?.value || "18:00")
                    : null
            };
            var btn = document.getElementById("changePackageSaveBtn");
            if (btn) btn.disabled = true;
            try {
                var res = await fetch("/admin/customers/" + encodeURIComponent(currentPaymentsAthleteId) + "/change-package", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(data.error || data.message || "Dəyişilmədi.");
                alert(data.message || "Paket dəyişildi.");
                await openPackagePaymentsModal(currentPaymentsAthleteId, paymentsAthlete?.textContent || "");
                await loadList();
            } catch (err) {
                alert(err && err.message ? err.message : "Xəta.");
            } finally {
                if (btn) btn.disabled = false;
            }
        });

        async function loadList() {
            if (!form) return;
            AFS.save(STORAGE_KEY, form);
            syncExportUrl();
            if (tableCard) tableCard.classList.add("loading");
            try {
                var res = await fetch("/admin/customers/data?" + qsFromForm().toString(), { credentials: "same-origin" });
                if (!res.ok) throw new Error("load failed");
                var data = await res.json();
                var items = Array.isArray(data?.items) ? data.items : [];
                renderRows(items);
                if (countLabel) {
                    if (data && data.visitRowsMode) {
                        var uniq = Number(data.uniqueCustomerCount || 0);
                        countLabel.textContent = "Cəmi: " + items.length + " yazılma"
                            + (uniq ? " (" + uniq + " müştəri)" : "");
                    } else {
                        countLabel.textContent = "Cəmi: " + items.length + " müştəri";
                    }
                }
            } catch (e) {
                if (tbody) tbody.innerHTML = '<tr><td colspan="13" style="color:#b91c1c;">Siyahı yüklənmədi.</td></tr>';
            } finally {
                if (tableCard) tableCard.classList.remove("loading");
            }
        }

        function scheduleLoad(delayMs) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(loadList, delayMs);
        }

        function onStatusChange() {
            var activeEl = form.elements.namedItem("active");
            if (activeEl && activeEl.value === "inactive") {
                clearDateRange();
                markPresetActive("all");
            }
        }

        document.querySelectorAll(".preset-btn[data-preset]").forEach(function (btn) {
            btn.addEventListener("click", function () {
                applyPreset(btn.getAttribute("data-preset") || "today");
            });
        });

        if (form && AFS) {
            AFS.initForm(STORAGE_KEY, form, {
                applyDefaults: function (f) {
                    var active = f.elements.namedItem("active");
                    if (active && "value" in active) {
                        if (active.value !== "inactive") active.value = "active";
                    }
                    clearDateRange();
                    markPresetActive("all");
                }
            });

            // Status yalnız Aktiv | Silinmiş; boş/köhnə «Hamısı» → Aktiv.
            (function ensureStatusDefault() {
                var active = form.elements.namedItem("active");
                if (active && "value" in active && active.value !== "inactive") {
                    active.value = "active";
                }
            })();

            // Boş tarix → Hamısı (açılış default).
            (function syncPresetFromDates() {
                var from = fromEl && fromEl.value ? fromEl.value : "";
                var to = toEl && toEl.value ? toEl.value : "";
                if (!from && !to) {
                    markPresetActive("all");
                    return;
                }
                var todayIso = isoDate(new Date());
                if (from === todayIso && to === todayIso) {
                    markPresetActive("today");
                    return;
                }
                var monthStart = new Date();
                monthStart.setHours(0, 0, 0, 0);
                monthStart = new Date(monthStart.getFullYear(), monthStart.getMonth(), 1);
                var monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                if (from === isoDate(monthStart) && to === isoDate(monthEnd)) {
                    markPresetActive("month");
                    return;
                }
                markPresetActive("");
            })();

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                void loadList();
            });

            syncExportUrl();

            var searchInput = form.querySelector('input[name="search"]');
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    syncExportUrl();
                    scheduleLoad(300);
                });
            }

            for (var i = 0; i < form.elements.length; i++) {
                var el = form.elements[i];
                if (!el.name || el === searchInput) continue;
                if (el.tagName === "SELECT" || el.type === "date") {
                    el.addEventListener("change", function (ev) {
                        if (applyingPreset) return;
                        if (ev.target && ev.target.name === "active") onStatusChange();
                        if (ev.target && (ev.target.name === "registeredFrom" || ev.target.name === "registeredTo")) {
                            markPresetActive("");
                        }
                        syncExportUrl();
                        scheduleLoad(0);
                    });
                }
            }

            void loadList();
        } else if (tbody) {
            tbody.innerHTML = '<tr><td colspan="11" style="color:#b91c1c;">Səhifə skripti yüklənmədi.</td></tr>';
        }
    })();
</script>
