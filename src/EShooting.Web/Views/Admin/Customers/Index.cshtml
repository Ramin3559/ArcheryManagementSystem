                if (startEl) startEl.value = isoToday();
                if (monthsEl) monthsEl.value = "1";
                lastChangePreview = null;
                syncChangePackageWeeklyUi(null);
                var res = await fetch("/admin/customers/" + encodeURIComponent(athleteId) + "/package-payments", {
                    credentials: "same-origin"
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(data.error || "Yüklənmədi.");
                var items = Array.isArray(data.items) ? data.items : [];
