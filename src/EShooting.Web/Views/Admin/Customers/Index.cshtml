@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Müştərilər";
}

<style>
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 12px; align-items: end; }
    .filter-grid label.field { display: flex; flex-direction: column; gap: 6px; }
    .filter-grid .field span { color: var(--muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .filter-grid input:not([type="checkbox"]), .filter-grid select { width: 100%; min-width: 0; }
    .filter-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
    .field--presets { grid-column: span 2; min-width: 420px; }
    .field--presets > span { visibility: hidden; user-select: none; }
    .preset-inline { display: flex; gap: 8px; flex-wrap: nowrap; align-items: center; min-height: 38px; }
    .preset-btn {
        border-radius:999px;
        border:1px solid var(--border);
        background:#fff;
        padding:6px 14px;
        font-weight:700;
        cursor:pointer;
        font-size:13px;
        color:#253060;
    }
    .preset-btn:hover { background: rgba(79,70,229,0.08); border-color: rgba(79,70,229,0.18); }
    .preset-btn.active {
        background: rgba(79,70,229,0.12);
        border-color: rgba(79,70,229,0.28);
        color: #3730a3;
    }
    .card.loading { opacity: 0.65; pointer-events: none; }
    .cust-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .cust-actions .btn { padding: 4px 10px; font-size: 12px; }
    .row-deleted td { opacity: 0.78; }
    #customersTableCard .tableWrap {
        overflow: auto;
        max-height: 70vh;
    }
    #customersTableCard table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        table-layout: auto;
    }
    #customersTableCard th,
    #customersTableCard td {
        padding: 8px 10px;
        font-size: 13px;
        white-space: nowrap;
        vertical-align: middle;
    }
    #customersTableCard th {
        font-size: 11px;
        letter-spacing: .04em;
    }
    #customersTableCard tbody tr.cust-row {
        cursor: pointer;
    }
    #customersTableCard tbody tr.cust-row:hover {
        background: rgba(79, 70, 229, 0.05);
    }
    #customersTableCard td.col-actions {
        cursor: default;
        position: sticky;
        right: 0;
        background: #fff;
        box-shadow: -6px 0 8px -8px rgba(17, 24, 39, 0.25);
    }
    #customersTableCard tr.row-deleted td.col-actions {
        background: #fff;
    }
    #packagePaymentsModal .tableWrap th,
    #packagePaymentsModal .tableWrap td {
        padding: 8px 10px;
        font-size: 13px;
        white-space: nowrap;
    }
    #packagePaymentsModal tbody tr.pay-row {
        cursor: pointer;
    }
    #packagePaymentsModal tbody tr.pay-row:hover {
        background: rgba(79, 70, 229, 0.05);
    }
    #packagePaymentsModal tbody tr.pay-row.is-selected {
        background: rgba(79, 70, 229, 0.08);
    }
</style>

<div class="topbar">
    <h1>Müştərilər</h1>
    <a class="btn btn-excel" id="customersExportBtn" href="/admin/customers/export.xlsx">Excel-ə çıxart</a>
</div>

<form id="customersAntiForgery" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="card" style="margin-bottom:12px;">
    <form id="customersFilterForm" autocomplete="off">
        <div class="filter-grid">
            <label class="field">
                <span>Axtarış</span>
                <input name="search" placeholder="Ad, telefon, qeydiyyata alan…" />
            </label>
            <label class="field">
                <span>VIP</span>
                <select name="vip">
                    <option value="">Hamısı</option>
                    <option value="yes">VIP</option>
                    <option value="no">VIP deyil</option>
                </select>
            </label>
            <label class="field">
                <span>Paket növü</span>
                <select name="packageType">
                    <option value="">Hamısı</option>
                    <option value="birdefelik">Birdefəlik</option>
                    <option value="abune">Abunə</option>
                    <option value="vip">VIP abunə</option>
                </select>
            </label>
            <label class="field">
                <span>Oyun icarəsi</span>
                <select name="sessionRental">
                    <option value="">Hamısı</option>
                    <option value="any">Oyun icarəsi olub</option>
                    <option value="pending">Qaytarılmamış icarə</option>
                    <option value="none">Oyun icarəsi olmayıb</option>
                </select>
            </label>
            <label class="field">
                <span>Status</span>
                <select name="active">
                    <option value="active" selected>Aktiv</option>
                    <option value="inactive">Silinmiş</option>
                </select>
            </label>
            <label class="field">
                <span>Kateqoriya</span>
                <select name="category">
                    <option value="">Hamısı</option>
                    <option value="0">Həvəskar</option>
                    <option value="1">Peşəkar</option>
                    <option value="2">Məşqçi</option>
                </select>
            </label>
            <label class="field">
                <span>Son zolağa yazılma (başlanğıc)</span>
                <input type="date" name="registeredFrom" id="customersFromDate" value="" />
            </label>
            <label class="field">
                <span>Son zolağa yazılma (son)</span>
                <input type="date" name="registeredTo" id="customersToDate" value="" />
            </label>
            <div class="field field--presets">
                <span>Tarix</span>
                <div class="preset-inline">
                    <button type="button" class="preset-btn active" data-preset="today">Bu gün</button>
                    <button type="button" class="preset-btn" data-preset="yesterday">Dünən</button>
                    <button type="button" class="preset-btn" data-preset="last7">Son 7 gün</button>
                    <button type="button" class="preset-btn" data-preset="month">Cari ay</button>
                    <button type="button" class="preset-btn" data-preset="all">Hamısı</button>
                </div>
            </div>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Axtar</button>
        </div>
    </form>
</div>

<div class="card" id="customersTableCard">
    <div class="tableWrap">
        <table>
            <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Telefon</th>
                <th>VIP</th>
                <th>Paket</th>
                <th>Ödəniş</th>
                <th>Abunə müddəti</th>
                <th>Qeydiyyata alınma</th>
                <th>Qeydiyyata alan</th>
                <th>Son zolağa yazılma</th>
                <th>Oyun icarəsi</th>
                <th>Silən</th>
                <th></th>
            </tr>
            </thead>
            <tbody id="customersTableBody">
            <tr><td colspan="12" style="color:var(--muted);">Yüklənir…</td></tr>
            </tbody>
        </table>
    </div>
    <p class="statLabel" style="margin-top:10px;" id="customersCountLabel">Cəmi: — müştəri</p>
</div>

<div id="packagePaymentsModal"
     style="display:none; position:fixed; inset:0; background:rgba(11,18,32,0.45); z-index:9999; padding:16px; overflow:auto;">
    <div style="max-width:920px; margin:24px auto; background:#fff; border:1px solid var(--border); border-radius:14px; padding:16px;">
        <div style="display:flex; gap:10px; align-items:center; justify-content:space-between; flex-wrap:wrap;">
            <div>
                <div style="font-weight:900; color:#1a2650; font-size:18px;">Paket ödənişləri</div>
                <div id="packagePaymentsAthlete" style="color:var(--muted); font-size:13px; margin-top:4px;"></div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="packagePaymentsCloseBtn">Bağla</button>
        </div>
        <div class="tableWrap" style="margin-top:12px;">
            <table>
                <thead>
                <tr>
                    <th>Tarix</th>
                    <th>Paket</th>
                    <th>Qiymət</th>
                    <th>Endirim</th>
                    <th>Nağd</th>
                    <th>Kart</th>
                    <th>Cəm</th>
                </tr>
                </thead>
                <tbody id="packagePaymentsBody">
                <tr><td colspan="7" style="color:var(--muted);">Yüklənir…</td></tr>
                </tbody>
            </table>
        </div>
        <div id="packagePaymentEditPanel" style="display:none; margin-top:14px; padding-top:14px; border-top:1px solid var(--border);">
            <div style="font-weight:800; color:#1a2650; margin-bottom:4px;">Ödənişi düzəlt</div>
            <p id="editPaymentSelectedLabel" class="statLabel" style="margin:0 0 10px;">Siyahıdan seçin və ya dəyərləri dəyişin.</p>
            <input type="hidden" id="editPaymentRecordId" />
            <div class="filter-grid">
                <label class="field">
                    <span>Qiymət (AZN)</span>
                    <input id="editPaymentPriceDue" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Endirim (AZN)</span>
                    <input id="editPaymentDiscount" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Nağd (AZN)</span>
                    <input id="editPaymentCash" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Kart (AZN)</span>
                    <input id="editPaymentCard" type="number" min="0" step="0.01" />
                </label>
                <label class="field" style="flex-direction:row; align-items:center; gap:8px;">
                    <input id="editPaymentComplimentary" type="checkbox" />
                    <span style="text-transform:none; letter-spacing:0;">Pulsuz</span>
                </label>
            </div>
            <p id="editPaymentHint" class="statLabel" style="margin-top:8px;">Ödəniləcək = qiymət − endirim. Nağd və ya karta yazın — digəri avtomatik dolacaq.</p>
            <div class="filter-actions">
                <button type="button" class="btn btn-primary" id="editPaymentSaveBtn">Yadda saxla</button>
                <button type="button" class="btn btn-ghost" id="editPaymentCancelBtn">Sıfırla</button>
            </div>
        </div>
        <div id="packageChangePanel" style="margin-top:14px; padding-top:14px; border-top:1px solid var(--border);">
            <div style="font-weight:800; color:#1a2650; margin-bottom:8px;">Paketi dəyiş</div>
            <div class="filter-grid">
                <label class="field" style="grid-column:1/-1;">
                    <span>Yeni paket</span>
                    <select id="changePackageSelect"><option value="">Paket seçin</option></select>
                </label>
                <label class="field">
                    <span>Abunə başlanğıcı</span>
                    <input id="changePackageStart" type="date" />
                </label>
                <label class="field">
                    <span>Abunə bitməsi</span>
                    <input id="changePackageEnd" type="date" />
                </label>
                <label class="field">
                    <span>Endirim (AZN)</span>
                    <input id="changePackageDiscount" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field">
                    <span>Nağd (AZN)</span>
                    <input id="changePackageCash" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field">
                    <span>Kart (AZN)</span>
                    <input id="changePackageCard" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field" style="flex-direction:row; align-items:center; gap:8px;">
                    <input id="changePackageComplimentary" type="checkbox" />
                    <span style="text-transform:none; letter-spacing:0;">Pulsuz (əlavə ödəniş)</span>
                </label>
            </div>
            <p id="changePackagePreviewHint" class="statLabel" style="margin-top:8px;">Yeni paket seçin — ödəniş fərqi burada görünəcək.</p>
            <div class="filter-actions" style="margin-top:10px;">
                <button type="button" class="btn btn-primary" id="changePackageSaveBtn">Paketi dəyiş</button>
                <button type="button" class="btn btn-ghost" id="changePackagePreviewBtn">Fərqi hesabla</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // v2: köhnə sessionStorage (məcburi «bu gün» / dar tarix) sıfırlanır
        var STORAGE_KEY = "admin-customers-v4";
        var form = document.getElementById("customersFilterForm");
        var exportBtn = document.getElementById("customersExportBtn");
        var tbody = document.getElementById("customersTableBody");
        var countLabel = document.getElementById("customersCountLabel");
        var tableCard = document.getElementById("customersTableCard");
        var antiForm = document.getElementById("customersAntiForgery");
        var fromEl = document.getElementById("customersFromDate");
        var toEl = document.getElementById("customersToDate");
        var debounceTimer = null;
        var applyingPreset = false;
        var AFS = window.AdminFilterState;

        function isoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, "0");
            var day = String(d.getDate()).padStart(2, "0");
            return y + "-" + m + "-" + day;
        }

        function qsFromForm() {
            var params = new URLSearchParams(new FormData(form));
            // Boş tarixləri göndərmə — server hamısını qaytarsın
            if (!params.get("registeredFrom")) params.delete("registeredFrom");
            if (!params.get("registeredTo")) params.delete("registeredTo");
            return params;
        }

        function setDateInput(el, iso) {
            if (!(el instanceof HTMLInputElement)) return;
            el.value = iso || "";
            if (el._flatpickr) {
                if (iso) {
                    el._flatpickr.setDate(iso, false);
                } else {
                    el._flatpickr.clear();
                }
            }
        }

        function clearDateRange() {
            setDateInput(fromEl, "");
            setDateInput(toEl, "");
        }

        function markPresetActive(preset) {
            document.querySelectorAll(".preset-btn[data-preset]").forEach(function (btn) {
                btn.classList.toggle("active", (btn.getAttribute("data-preset") || "") === preset);
            });
        }

        function setTodayDateRange() {
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            setDateInput(fromEl, isoDate(today));
            setDateInput(toEl, isoDate(today));
            markPresetActive("today");
        }

        function applyPreset(preset) {
            if (!(fromEl instanceof HTMLInputElement) || !(toEl instanceof HTMLInputElement)) return;
            applyingPreset = true;
            if (preset === "all") {
                clearDateRange();
                markPresetActive("all");
                applyingPreset = false;
                void loadList();
                return;
            }
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            var from = new Date(today);
            var to = new Date(today);
            if (preset === "yesterday") {
                from.setDate(from.getDate() - 1);
                to = new Date(from);
            } else if (preset === "last7") {
                from.setDate(from.getDate() - 6);
            } else if (preset === "month") {
                from = new Date(today.getFullYear(), today.getMonth(), 1);
                to = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            }
            setDateInput(fromEl, isoDate(from));
            setDateInput(toEl, isoDate(to));
            markPresetActive(preset || "today");
            applyingPreset = false;
            void loadList();
        }

        function antiforgeryToken() {
            if (!antiForm) return "";
            var input = antiForm.querySelector('input[name="__RequestVerificationToken"]');
            return input && "value" in input ? input.value : "";
        }

        function syncExportUrl() {
            if (!exportBtn) return;
            exportBtn.href = "/admin/customers/export.xlsx?" + qsFromForm().toString();
        }

        function sessionRentalLabel(x) {
            if (x.hasPendingSessionRental) return "Qaytarılmamış icarə";
            if (x.hasSessionEquipmentRental) return "Bəli";
            return "—";
        }

        function deletedByLabel(x) {
            if (x.isActive) return "—";
            if (x.deletedByName && x.deletedByName !== "—") {
                var when = x.deletedAtLocal ? (" · " + x.deletedAtLocal) : "";
                return AFS.escapeHtml(x.deletedByName) + (when ? AFS.escapeHtml(when) : "");
            }
            return "—";
        }

        function actionCell(x) {
            if (x.isActive) {
                return '<div class="cust-actions"><button type="button" class="btn btn-danger" data-action="delete" data-id="'
                    + AFS.escapeHtml(x.id) + '">Sil</button></div>';
            }
            return '<div class="cust-actions">'
                + '<button type="button" class="btn btn-primary" data-action="restore" data-id="'
                + AFS.escapeHtml(x.id) + '">Bərpa</button>'
                + '<button type="button" class="btn btn-danger" data-action="hard-delete" data-id="'
                + AFS.escapeHtml(x.id) + '" data-name="' + AFS.escapeHtml(x.fullName || "")
                + '">Birdəfəlik sil</button>'
                + '</div>';
        }

        function renderRows(items) {
            if (!tbody) return;
            if (!items.length) {
                tbody.innerHTML = '<tr><td colspan="12" style="color:var(--muted);">Bu filtrə uyğun müştəri tapılmadı.</td></tr>';
                return;
            }
            tbody.innerHTML = items.map(function (x) {
                var sub = x.subscriptionFromLocal ? (AFS.escapeHtml(x.subscriptionFromLocal) + " — " + AFS.escapeHtml(x.subscriptionToLocal)) : "—";
                var lastLane = x.lastLaneVisitLocal
                    ? AFS.escapeHtml(x.lastLaneVisitLocal + (x.lastLaneNumber ? " · Zolaq " + x.lastLaneNumber : ""))
                    : "—";
                var name = AFS.escapeHtml(x.fullName) + (x.isVip ? " · VIP" : "");
                if (!x.isActive) name += ' <span style="color:#b91c1c;font-size:11px;">(silinmiş)</span>';
                var rowClass = "cust-row" + (x.isActive ? "" : " row-deleted");
                var payment = AFS.escapeHtml(x.latestPaymentLabel || "—");
                return '<tr class="' + rowClass + '" data-athlete-id="' + AFS.escapeHtml(x.id)
                    + '" data-athlete-name="' + AFS.escapeHtml(x.fullName || "") + '">'
                    + "<td>" + name + "</td>"
                    + "<td>" + AFS.escapeHtml(x.phoneNumber) + "</td>"
                    + "<td>" + (x.isVip ? "Bəli" : "—") + "</td>"
                    + "<td>" + AFS.escapeHtml(x.packageTypeLabel) + "</td>"
                    + "<td>" + payment + "</td>"
                    + "<td>" + sub + "</td>"
                    + "<td>" + AFS.escapeHtml(x.registeredAtLocal) + "</td>"
                    + "<td>" + AFS.escapeHtml(x.registeredByStaffName) + "</td>"
                    + "<td>" + lastLane + "</td>"
                    + "<td>" + AFS.escapeHtml(sessionRentalLabel(x)) + "</td>"
                    + "<td>" + deletedByLabel(x) + "</td>"
                    + '<td class="col-actions">' + actionCell(x) + "</td>"
                    + "</tr>";
            }).join("");
        }

        async function postCustomerAction(id, action) {
            var url = action === "delete"
                ? "/admin/customers/" + id + "/delete"
                : action === "hard-delete"
                    ? "/admin/customers/" + id + "/hard-delete"
                    : "/admin/customers/" + id + "/restore";
            var body = new URLSearchParams();
            body.set("__RequestVerificationToken", antiforgeryToken());
            var res = await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": antiforgeryToken()
                },
                body: body.toString()
            });
            var data = null;
            try { data = await res.json(); } catch (_) { /* ignore */ }
            if (!res.ok) {
                throw new Error((data && data.error) || "Əməliyyat alınmadı.");
            }
            return data;
        }

        if (tbody) {
            tbody.addEventListener("click", function (e) {
                var btn = e.target && e.target.closest ? e.target.closest("button[data-action]") : null;
                if (btn) {
                    var id = btn.getAttribute("data-id");
                    var action = btn.getAttribute("data-action");
                    if (!id || !action) return;
                    var confirmMsg;
                    if (action === "delete") {
                        confirmMsg = "Müştəri silinsin? (Silinmiş siyahısına düşəcək — bərpa etmək olar)";
                    } else if (action === "hard-delete") {
                        var nm = btn.getAttribute("data-name") || "bu müştəri";
                        confirmMsg = "«" + nm + "» birdəfəlik silinsin?";
                    } else {
                        confirmMsg = "Müştəri bərpa edilsin?";
                    }
                    if (!window.confirm(confirmMsg)) return;
                    btn.disabled = true;
                    postCustomerAction(id, action)
                        .then(function () { return loadList(); })
                        .catch(function (err) {
                            alert(err && err.message ? err.message : "Əməliyyat alınmadı.");
                        })
                        .finally(function () { btn.disabled = false; });
                    return;
                }

                var row = e.target && e.target.closest ? e.target.closest("tr.cust-row") : null;
                if (!row) return;
                openPackagePaymentsModal(
                    row.getAttribute("data-athlete-id") || "",
                    row.getAttribute("data-athlete-name") || ""
                );
            });
        }

        var paymentsModal = document.getElementById("packagePaymentsModal");
        var paymentsBody = document.getElementById("packagePaymentsBody");
        var paymentsAthlete = document.getElementById("packagePaymentsAthlete");
        var editPanel = document.getElementById("packagePaymentEditPanel");
        var currentPaymentsAthleteId = null;
        var paymentSplitSource = "cash";

        function money(v) {
            var n = Number(v || 0);
            return Number.isFinite(n) ? n.toFixed(2) : "0.00";
        }

        function readMoney(id) {
            var n = Number(document.getElementById(id)?.value || 0);
            return Number.isFinite(n) && n > 0 ? n : 0;
        }

        function payableAmount() {
            var price = readMoney("editPaymentPriceDue");
            var discount = Math.min(readMoney("editPaymentDiscount"), price);
            return Math.max(0, Math.round((price - discount) * 100) / 100);
        }

        function syncPaymentSplit(fromField) {
            var comp = document.getElementById("editPaymentComplimentary");
            if (comp && comp.checked) return;
            var payable = payableAmount();
            var cashEl = document.getElementById("editPaymentCash");
            var cardEl = document.getElementById("editPaymentCard");
            if (!(cashEl instanceof HTMLInputElement) || !(cardEl instanceof HTMLInputElement)) return;

            if (fromField === "cash") {
                paymentSplitSource = "cash";
                var cash = Math.min(readMoney("editPaymentCash"), payable);
                cashEl.value = money(cash);
                cardEl.value = money(Math.max(0, payable - cash));
            } else if (fromField === "card") {
                paymentSplitSource = "card";
                var card = Math.min(readMoney("editPaymentCard"), payable);
                cardEl.value = money(card);
                cashEl.value = money(Math.max(0, payable - card));
            } else if (paymentSplitSource === "card") {
                var keepCard = Math.min(readMoney("editPaymentCard"), payable);
                cardEl.value = money(keepCard);
                cashEl.value = money(Math.max(0, payable - keepCard));
            } else {
                var keepCash = Math.min(readMoney("editPaymentCash"), payable);
                cashEl.value = money(keepCash);
                cardEl.value = money(Math.max(0, payable - keepCash));
            }

            var hint = document.getElementById("editPaymentHint");
            if (hint) {
                hint.textContent = "Ödəniləcək: " + money(payable)
                    + " AZN — nağd və ya karta yazın, digəri avtomatik doldurulur.";
            }
        }

        function closePackagePaymentsModal() {
            if (paymentsModal) paymentsModal.style.display = "none";
            if (editPanel) editPanel.style.display = "none";
            currentPaymentsAthleteId = null;
        }

        function clearPaymentEditForm() {
            document.getElementById("editPaymentRecordId").value = "";
            document.getElementById("editPaymentPriceDue").value = "";
            document.getElementById("editPaymentDiscount").value = "";
            document.getElementById("editPaymentCash").value = "";
            document.getElementById("editPaymentCard").value = "";
            document.getElementById("editPaymentComplimentary").checked = false;
            var sel = document.getElementById("editPaymentSelectedLabel");
            if (sel) sel.textContent = "Ödəniş qeydi yoxdur.";
            if (paymentsBody) {
                paymentsBody.querySelectorAll("tr.pay-row").forEach(function (tr) {
                    tr.classList.remove("is-selected");
                });
            }
        }

        function resetPaymentEditToSelected() {
            if (!paymentsBody) return;
            var row = paymentsBody.querySelector("tr.pay-row.is-selected");
            var rid = row ? row.getAttribute("data-payment-id") : null;
            var items = paymentsBody._items || [];
            var item = rid
                ? items.find(function (x) { return String(x.id) === String(rid); })
                : items[0];
            if (item) {
                var targetRow = row || paymentsBody.querySelector('tr.pay-row[data-payment-id="' + item.id + '"]');
                openPaymentEdit(item, targetRow);
            }
        }

        function openPaymentEdit(item, rowEl) {
            if (!editPanel || !item) return;
            if (paymentsBody) {
                paymentsBody.querySelectorAll("tr.pay-row").forEach(function (tr) {
                    tr.classList.toggle("is-selected", tr === rowEl);
                });
            }
            document.getElementById("editPaymentRecordId").value = item.id || "";
            document.getElementById("editPaymentPriceDue").value = money(item.priceDue);
            document.getElementById("editPaymentDiscount").value = money(item.discountAmount);
            document.getElementById("editPaymentCash").value = money(item.amountPaidCash);
            document.getElementById("editPaymentCard").value = money(item.amountPaidCard);
            document.getElementById("editPaymentComplimentary").checked = !!item.isComplimentary;
            paymentSplitSource = Number(item.amountPaidCard || 0) > Number(item.amountPaidCash || 0) ? "card" : "cash";
            var sel = document.getElementById("editPaymentSelectedLabel");
            if (sel) {
                sel.textContent = (item.createdAtLocal || "")
                    + (item.packageName ? " · " + item.packageName : "")
                    + " — siyahıdan digər sətirə klikləyin, forma dəyişsin.";
            }
            editPanel.style.display = "block";
            syncComplimentaryFields();
            if (!(document.getElementById("editPaymentComplimentary")?.checked)) {
                syncPaymentSplit(paymentSplitSource);
            }
        }

        function syncComplimentaryFields() {
            var comp = document.getElementById("editPaymentComplimentary");
            var disabled = !!(comp && comp.checked);
            ["editPaymentDiscount", "editPaymentCash", "editPaymentCard"].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) {
                    el.disabled = disabled;
                    if (disabled) el.value = "0.00";
                }
            });
            if (!disabled) syncPaymentSplit(paymentSplitSource);
            else {
                var hint = document.getElementById("editPaymentHint");
                if (hint) hint.textContent = "Pulsuz seçilib — ödəniş 0 AZN.";
            }
        }

        async function openPackagePaymentsModal(athleteId, name, selectRecordId) {
            if (!athleteId) return;
            currentPaymentsAthleteId = athleteId;
            if (paymentsAthlete) paymentsAthlete.textContent = name || "";
            if (paymentsBody) paymentsBody.innerHTML = '<tr><td colspan="7" style="color:var(--muted);">Yüklənir…</td></tr>';
            if (editPanel) editPanel.style.display = "block";
            if (paymentsModal) paymentsModal.style.display = "block";
            try {
                await ensureChangePackagesLoaded();
                var startEl = document.getElementById("changePackageStart");
                var endEl = document.getElementById("changePackageEnd");
                if (startEl) startEl.value = isoToday();
                if (endEl) endEl.value = isoPlusDays(30);
                var res = await fetch("/admin/customers/" + encodeURIComponent(athleteId) + "/package-payments", {
                    credentials: "same-origin"
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(data.error || "Yüklənmədi.");
                var items = Array.isArray(data.items) ? data.items : [];
                if (!items.length) {
                    paymentsBody.innerHTML = '<tr><td colspan="7" style="color:var(--muted);">Ödəniş qeydi yoxdur.</td></tr>';
                    paymentsBody._items = [];
                    clearPaymentEditForm();
                    return;
                }
                paymentsBody.innerHTML = items.map(function (p) {
                    var label = p.isComplimentary ? "Pulsuz" : money(p.amountPaid);
                    return '<tr class="pay-row" data-payment-id="' + AFS.escapeHtml(p.id) + '">'
                        + "<td>" + AFS.escapeHtml(p.createdAtLocal || "") + "</td>"
                        + "<td>" + AFS.escapeHtml(p.packageName || "") + "</td>"
                        + "<td>" + money(p.priceDue) + "</td>"
                        + "<td>" + money(p.discountAmount) + "</td>"
                        + "<td>" + money(p.amountPaidCash) + "</td>"
                        + "<td>" + money(p.amountPaidCard) + "</td>"
                        + "<td>" + AFS.escapeHtml(label) + "</td>"
                        + "</tr>";
                }).join("");
                paymentsBody._items = items;
                var pick = selectRecordId
                    ? (items.find(function (x) { return String(x.id) === String(selectRecordId); }) || items[0])
                    : items[0];
                var pickRow = paymentsBody.querySelector('tr.pay-row[data-payment-id="' + pick.id + '"]');
                openPaymentEdit(pick, pickRow);
            } catch (err) {
                paymentsBody.innerHTML = '<tr><td colspan="7" style="color:#b91c1c;">'
                    + AFS.escapeHtml(err && err.message ? err.message : "Xəta") + "</td></tr>";
                clearPaymentEditForm();
            }
        }

        if (paymentsBody) {
            paymentsBody.addEventListener("click", function (e) {
                var row = e.target && e.target.closest ? e.target.closest("tr.pay-row") : null;
                if (!row) return;
                var rid = row.getAttribute("data-payment-id");
                var items = paymentsBody._items || [];
                var item = items.find(function (x) { return String(x.id) === String(rid); });
                if (item) openPaymentEdit(item, row);
            });
        }

        document.getElementById("packagePaymentsCloseBtn")?.addEventListener("click", closePackagePaymentsModal);
        document.getElementById("editPaymentCancelBtn")?.addEventListener("click", resetPaymentEditToSelected);
        document.getElementById("editPaymentComplimentary")?.addEventListener("change", syncComplimentaryFields);
        document.getElementById("editPaymentPriceDue")?.addEventListener("input", function () { syncPaymentSplit("price"); });
        document.getElementById("editPaymentDiscount")?.addEventListener("input", function () { syncPaymentSplit("price"); });
        document.getElementById("editPaymentCash")?.addEventListener("input", function () { syncPaymentSplit("cash"); });
        document.getElementById("editPaymentCard")?.addEventListener("input", function () { syncPaymentSplit("card"); });
        paymentsModal?.addEventListener("click", function (e) {
            if (e.target === paymentsModal) closePackagePaymentsModal();
        });

        document.getElementById("editPaymentSaveBtn")?.addEventListener("click", async function () {
            var recordId = document.getElementById("editPaymentRecordId")?.value || "";
            if (!recordId) return;
            if (!(document.getElementById("editPaymentComplimentary")?.checked)) {
                syncPaymentSplit(paymentSplitSource);
            }
            var payload = {
                priceDue: Number(document.getElementById("editPaymentPriceDue")?.value || 0),
                discountAmount: Number(document.getElementById("editPaymentDiscount")?.value || 0),
                amountPaidCash: Number(document.getElementById("editPaymentCash")?.value || 0),
                amountPaidCard: Number(document.getElementById("editPaymentCard")?.value || 0),
                isComplimentary: !!document.getElementById("editPaymentComplimentary")?.checked
            };
            var btn = document.getElementById("editPaymentSaveBtn");
            if (btn) btn.disabled = true;
            try {
                var res = await fetch("/admin/customers/package-payments/" + encodeURIComponent(recordId), {
                    method: "PUT",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(data.error || "Yadda saxlanılmadı.");
                if (currentPaymentsAthleteId) {
                    await openPackagePaymentsModal(
                        currentPaymentsAthleteId,
                        paymentsAthlete?.textContent || "",
                        recordId);
                }
                await loadList();
                alert(data.message || "Ödəniş yeniləndi.");
            } catch (err) {
                alert(err && err.message ? err.message : "Yadda saxlanılmadı.");
            } finally {
                if (btn) btn.disabled = false;
            }
        });

        var changePackagesCache = [];
        var lastChangePreview = null;

        function isoToday() {
            var d = new Date();
            return isoDate(d);
        }

        function isoPlusDays(days) {
            var d = new Date();
            d.setDate(d.getDate() + days);
            return isoDate(d);
        }

        async function ensureChangePackagesLoaded() {
            if (changePackagesCache.length) return;
            var res = await fetch("/packages/active", { credentials: "same-origin" });
            var data = await res.json().catch(function () { return []; });
            changePackagesCache = Array.isArray(data) ? data : [];
            var sel = document.getElementById("changePackageSelect");
            if (!sel) return;
            sel.innerHTML = '<option value="">Paket seçin</option>' + changePackagesCache.map(function (p) {
                return '<option value="' + AFS.escapeHtml(p.id) + '">'
                    + AFS.escapeHtml(p.name || "") + " · " + money(p.price) + "</option>";
            }).join("");
        }

        async function refreshChangePackagePreview() {
            lastChangePreview = null;
            var hint = document.getElementById("changePackagePreviewHint");
            var pkgId = document.getElementById("changePackageSelect")?.value || "";
            if (!currentPaymentsAthleteId || !pkgId) {
                if (hint) hint.textContent = "Yeni paket seçin — ödəniş fərqi burada görünəcək.";
                return;
            }
            var discount = Number(document.getElementById("changePackageDiscount")?.value || 0);
            var res = await fetch(
                "/admin/customers/" + encodeURIComponent(currentPaymentsAthleteId)
                + "/change-package/preview?newServicePackageId=" + encodeURIComponent(pkgId)
                + "&discountAmount=" + encodeURIComponent(discount),
                { credentials: "same-origin" });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) {
                if (hint) hint.textContent = data.error || "Hesablama alınmadı.";
                return;
            }
            lastChangePreview = data;
            var kind = data.differenceKind || "even";
            var text = "Köhnə ödənilən: " + money(data.oldAmountPaid)
                + " · Yeni qiymət: " + money(data.newListPrice)
                + " · Ödəniləcək: " + money(data.newPayable) + ". ";
            if (kind === "additional") {
                text += "ƏLAVƏ ALINACAQ: " + money(data.additionalDue) + " AZN — nağd və/və ya karta yazın.";
            } else if (kind === "refund") {
                text += "QAYTARILACAQ: " + money(data.refundDue) + " AZN — nağd/kart qaytarma məbləğini yazın.";
            } else {
                text += "Ödəniş fərqi yoxdur.";
            }
            if (hint) hint.textContent = text;
        }

        document.getElementById("changePackageSelect")?.addEventListener("change", refreshChangePackagePreview);
        document.getElementById("changePackageDiscount")?.addEventListener("change", refreshChangePackagePreview);
        document.getElementById("changePackagePreviewBtn")?.addEventListener("click", refreshChangePackagePreview);
        document.getElementById("changePackageSaveBtn")?.addEventListener("click", async function () {
            if (!currentPaymentsAthleteId) return;
            var pkgId = document.getElementById("changePackageSelect")?.value || "";
            if (!pkgId) { alert("Yeni paket seçin."); return; }
            await refreshChangePackagePreview();
            if (!lastChangePreview) { alert("Ödəniş fərqi hesablanmadı."); return; }
            var kind = lastChangePreview.differenceKind || "even";
            var msg;
            if (kind === "additional") {
                msg = "Köhnə: " + money(lastChangePreview.oldAmountPaid)
                    + " · Yeni: " + money(lastChangePreview.newPayable)
                    + " · Əlavə alınacaq: " + money(lastChangePreview.additionalDue)
                    + " AZN.\n\nDavam edilsin?";
            } else if (kind === "refund") {
                msg = "Köhnə: " + money(lastChangePreview.oldAmountPaid)
                    + " · Yeni: " + money(lastChangePreview.newPayable)
                    + " · Qaytarılacaq: " + money(lastChangePreview.refundDue)
                    + " AZN.\n\nDavam edilsin?";
            } else {
                msg = "Ödəniş fərqi yoxdur. Paket dəyişilsin?";
            }
            if (!window.confirm(msg)) return;

            var start = document.getElementById("changePackageStart")?.value || isoToday();
            var end = document.getElementById("changePackageEnd")?.value || isoPlusDays(30);
            var payload = {
                newServicePackageId: pkgId,
                periodStartLocal: start,
                periodEndLocal: end,
                discountAmount: Number(document.getElementById("changePackageDiscount")?.value || 0),
                amountPaidCash: Number(document.getElementById("changePackageCash")?.value || 0),
                amountPaidCard: Number(document.getElementById("changePackageCard")?.value || 0),
                isComplimentary: !!document.getElementById("changePackageComplimentary")?.checked,
                confirmDifference: true
            };
            var btn = document.getElementById("changePackageSaveBtn");
            if (btn) btn.disabled = true;
            try {
                var res = await fetch("/admin/customers/" + encodeURIComponent(currentPaymentsAthleteId) + "/change-package", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(data.error || data.message || "Dəyişilmədi.");
                alert(data.message || "Paket dəyişildi.");
                await openPackagePaymentsModal(currentPaymentsAthleteId, paymentsAthlete?.textContent || "");
                await loadList();
            } catch (err) {
                alert(err && err.message ? err.message : "Xəta.");
            } finally {
                if (btn) btn.disabled = false;
            }
        });

        async function loadList() {
            if (!form) return;
            AFS.save(STORAGE_KEY, form);
            syncExportUrl();
            if (tableCard) tableCard.classList.add("loading");
            try {
                var res = await fetch("/admin/customers/data?" + qsFromForm().toString(), { credentials: "same-origin" });
                if (!res.ok) throw new Error("load failed");
                var data = await res.json();
                var items = Array.isArray(data?.items) ? data.items : [];
                renderRows(items);
                if (countLabel) countLabel.textContent = "Cəmi: " + items.length + " müştəri";
            } catch (e) {
                if (tbody) tbody.innerHTML = '<tr><td colspan="12" style="color:#b91c1c;">Siyahı yüklənmədi.</td></tr>';
            } finally {
                if (tableCard) tableCard.classList.remove("loading");
            }
        }

        function scheduleLoad(delayMs) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(loadList, delayMs);
        }

        function onStatusChange() {
            var activeEl = form.elements.namedItem("active");
            if (activeEl && activeEl.value === "inactive") {
                clearDateRange();
                markPresetActive("all");
            }
        }

        document.querySelectorAll(".preset-btn[data-preset]").forEach(function (btn) {
            btn.addEventListener("click", function () {
                applyPreset(btn.getAttribute("data-preset") || "today");
            });
        });

        if (form && AFS) {
            AFS.initForm(STORAGE_KEY, form, {
                applyDefaults: function (f) {
                    var active = f.elements.namedItem("active");
                    if (active && "value" in active) {
                        if (active.value !== "inactive") active.value = "active";
                    }
                    setTodayDateRange();
                }
            });

            // Status yalnız Aktiv | Silinmiş; boş/köhnə «Hamısı» → Aktiv.
            (function ensureStatusDefault() {
                var active = form.elements.namedItem("active");
                if (active && "value" in active && active.value !== "inactive") {
                    active.value = "active";
                }
            })();

            // Boş tarix → bu gün (açılış default).
            (function syncPresetFromDates() {
                var from = fromEl && fromEl.value ? fromEl.value : "";
                var to = toEl && toEl.value ? toEl.value : "";
                if (!from && !to) {
                    setTodayDateRange();
                    return;
                }
                var todayIso = isoDate(new Date());
                if (from === todayIso && to === todayIso) {
                    markPresetActive("today");
                    return;
                }
                markPresetActive("");
            })();

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                void loadList();
            });

            syncExportUrl();

            var searchInput = form.querySelector('input[name="search"]');
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    syncExportUrl();
                    scheduleLoad(300);
                });
            }

            for (var i = 0; i < form.elements.length; i++) {
                var el = form.elements[i];
                if (!el.name || el === searchInput) continue;
                if (el.tagName === "SELECT" || el.type === "date") {
                    el.addEventListener("change", function (ev) {
                        if (applyingPreset) return;
                        if (ev.target && ev.target.name === "active") onStatusChange();
                        if (ev.target && (ev.target.name === "registeredFrom" || ev.target.name === "registeredTo")) {
                            markPresetActive("");
                        }
                        syncExportUrl();
                        scheduleLoad(0);
                    });
                }
            }

            void loadList();
        } else if (tbody) {
            tbody.innerHTML = '<tr><td colspan="11" style="color:#b91c1c;">Səhifə skripti yüklənmədi.</td></tr>';
        }
    })();
</script>
