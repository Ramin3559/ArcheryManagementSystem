        var paymentsModal = document.getElementById("packagePaymentsModal");
        var paymentsBody = document.getElementById("packagePaymentsBody");
        var paymentsAthlete = document.getElementById("packagePaymentsAthlete");
        var editPanel = document.getElementById("packagePaymentEditPanel");
        var currentPaymentsAthleteId = null;
        var paymentSplitSource = "cash";

        function money(v) {
            var n = Number(v || 0);
            return Number.isFinite(n) ? n.toFixed(2) : "0.00";
        }

        function readMoney(id) {
            var n = Number(document.getElementById(id)?.value || 0);
            return Number.isFinite(n) && n > 0 ? n : 0;
        }

        function payableAmount() {
            var price = readMoney("editPaymentPriceDue");
            var discount = Math.min(readMoney("editPaymentDiscount"), price);
            return Math.max(0, Math.round((price - discount) * 100) / 100);
        }

        function syncPaymentSplit(fromField) {
            var comp = document.getElementById("editPaymentComplimentary");
            if (comp && comp.checked) return;
            var payable = payableAmount();
            var cashEl = document.getElementById("editPaymentCash");
            var cardEl = document.getElementById("editPaymentCard");
            if (!(cashEl instanceof HTMLInputElement) || !(cardEl instanceof HTMLInputElement)) return;

            if (fromField === "cash") {
                paymentSplitSource = "cash";
                var cash = Math.min(readMoney("editPaymentCash"), payable);
                cashEl.value = money(cash);
                cardEl.value = money(Math.max(0, payable - cash));
            } else if (fromField === "card") {
                paymentSplitSource = "card";
                var card = Math.min(readMoney("editPaymentCard"), payable);
                cardEl.value = money(card);
                cashEl.value = money(Math.max(0, payable - card));
            } else if (paymentSplitSource === "card") {
                var keepCard = Math.min(readMoney("editPaymentCard"), payable);
                cardEl.value = money(keepCard);
                cashEl.value = money(Math.max(0, payable - keepCard));
            } else {
                var keepCash = Math.min(readMoney("editPaymentCash"), payable);
                cashEl.value = money(keepCash);
                cardEl.value = money(Math.max(0, payable - keepCash));
            }

            var hint = document.getElementById("editPaymentHint");
            if (hint) {
                hint.textContent = "Ödəniləcək: " + money(payable)
                    + " AZN — nağd və ya karta yazın, digəri avtomatik doldurulur.";
            }
        }

        function closePackagePaymentsModal() {
