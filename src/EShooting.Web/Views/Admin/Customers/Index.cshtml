            if (paymentsBody) {
                paymentsBody.querySelectorAll("tr.pay-row").forEach(function (tr) {
                    tr.classList.remove("is-selected");
                });
            }
        }

        function resetPaymentEditToSelected() {
            if (!paymentsBody) return;
            var row = paymentsBody.querySelector("tr.pay-row.is-selected");
            var rid = row ? row.getAttribute("data-payment-id") : null;
            var items = paymentsBody._items || [];
            var item = rid
                ? items.find(function (x) { return String(x.id) === String(rid); })
                : items[0];
            if (item) {
                var targetRow = row || paymentsBody.querySelector('tr.pay-row[data-payment-id="' + item.id + '"]');
                openPaymentEdit(item, targetRow);
            }
        }

        function openPaymentEdit(item, rowEl) {
            if (!editPanel || !item) return;
            if (paymentsBody) {
                paymentsBody.querySelectorAll("tr.pay-row").forEach(function (tr) {
                    tr.classList.toggle("is-selected", tr === rowEl);
                });
            }
            document.getElementById("editPaymentRecordId").value = item.id || "";
            document.getElementById("editPaymentPriceDue").value = money(item.priceDue);
            document.getElementById("editPaymentDiscount").value = money(item.discountAmount);
            document.getElementById("editPaymentCash").value = money(item.amountPaidCash);
            document.getElementById("editPaymentCard").value = money(item.amountPaidCard);
            document.getElementById("editPaymentComplimentary").checked = !!item.isComplimentary;
            paymentSplitSource = Number(item.amountPaidCard || 0) > Number(item.amountPaidCash || 0) ? "card" : "cash";
            var sel = document.getElementById("editPaymentSelectedLabel");
            if (sel) {
                sel.textContent = (item.createdAtLocal || "")
                    + (item.packageName ? " · " + item.packageName : "")
                    + " — siyahıdan digər sətirə klikləyin, forma dəyişsin.";
            }
            editPanel.style.display = "block";
            syncComplimentaryFields();
            if (!(document.getElementById("editPaymentComplimentary")?.checked)) {
                syncPaymentSplit(paymentSplitSource);
            }
        }

        function syncComplimentaryFields() {
            var comp = document.getElementById("editPaymentComplimentary");
            var disabled = !!(comp && comp.checked);
            ["editPaymentDiscount", "editPaymentCash", "editPaymentCard"].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) {
                    el.disabled = disabled;
                    if (disabled) el.value = "0.00";
                }
            });
            if (!disabled) syncPaymentSplit(paymentSplitSource);
            else {
                var hint = document.getElementById("editPaymentHint");
                if (hint) hint.textContent = "Pulsuz seçilib — ödəniş 0 AZN.";
            }
        }

        async function openPackagePaymentsModal(athleteId, name, selectRecordId) {
            if (!athleteId) return;
            currentPaymentsAthleteId = athleteId;
            if (paymentsAthlete) paymentsAthlete.textContent = name || "";
            if (paymentsBody) paymentsBody.innerHTML = '<tr><td colspan="7" style="color:var(--muted);">Yüklənir…</td></tr>';
