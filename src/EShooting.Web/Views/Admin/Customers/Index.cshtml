        var changePackagesCache = [];
        var lastChangePreview = null;
        var weekdayLabels = ["Bazar", "B.e", "Ç.a", "Ç", "C.a", "C", "Ş"];

        function isoToday() {
            var d = new Date();
            return isoDate(d);
        }

        function isoPlusDays(days) {
            var d = new Date();
            d.setDate(d.getDate() + days);
            return isoDate(d);
        }

        function formatDateDisplayAz(iso) {
            var s = String(iso || "").trim();
            if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return "";
            var parts = s.split("-");
            return parts[2] + "." + parts[1] + "." + parts[0];
        }

        function addMakeupBonusMonthsIso(iso, bonusMonths) {
            if (!iso) return "";
            var d = new Date(iso + "T12:00:00");
            if (Number.isNaN(d.getTime())) return "";
            d.setMonth(d.getMonth() + Math.max(0, Number(bonusMonths) || 0));
            return isoDate(d);
        }

        function isChangePackageFixedWeekly() {
            if (lastChangePreview && lastChangePreview.isFixedWeekly) return true;
            var pkgId = document.getElementById("changePackageSelect")?.value || "";
            var pkg = changePackagesCache.find(function (p) { return String(p.id) === String(pkgId); });
            if (!pkg) return false;
            if (String(pkg.schedulingMode || "") === "FlexibleMonthly") return false;
            if (String(pkg.schedulingMode || "") === "FixedWeekly") return true;
            var billing = String(pkg.billingType || "");
            if (billing !== "Monthly" && billing !== "Yearly" && billing !== "Gym") return false;
            var n = Number(pkg.weeklyDaysCount || 0);
            if (Number.isInteger(n) && n >= 1 && n <= 7) return true;
            return !!(pkg.weeklyDaysCsv && String(pkg.weeklyDaysCsv).trim());
        }

        function calcNthWeeklyOccurrenceEndIso(startIso, weekdays, visitCount) {
            if (!startIso || !visitCount || !weekdays || !weekdays.length) return "";
            var daySet = {};
            weekdays.forEach(function (n) {
                if (Number.isInteger(n) && n >= 0 && n <= 6) daySet[n] = true;
            });
            var d = new Date(startIso + "T12:00:00");
            if (Number.isNaN(d.getTime())) return "";
            var found = 0;
            for (var i = 0; i < 800; i++) {
                if (daySet[d.getDay()]) {
                    found++;
                    if (found >= visitCount) return isoDate(d);
                }
                d.setDate(d.getDate() + 1);
            }
            return "";
        }

        function getChangePackageEndIso() {
            var end = document.getElementById("changePackageEnd");
            if (!end) return "";
            var fromData = String(end.dataset.iso || "").trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(fromData)) return fromData;
            var v = String(end.value || "").trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(v)) return v;
            var m = /^(\d{2})\.(\d{2})\.(\d{4})$/.exec(v);
            if (m) return m[3] + "-" + m[2] + "-" + m[1];
            return "";
        }

        function syncChangePackageEndDate() {
            var endEl = document.getElementById("changePackageEnd");
            var start = document.getElementById("changePackageStart")?.value || "";
            var months = Math.min(12, Math.max(1, Number(document.getElementById("changePackageMonths")?.value || 1) || 1));
            var endIso = "";
            if (start) {
                if (isChangePackageFixedWeekly()) {
                    var days = getSelectedChangeWeekdays();
                    if (!days.length && lastChangePreview && lastChangePreview.defaultWeeklyDaysCsv) {
                        setChangeWeekdaysFromCsv(lastChangePreview.defaultWeeklyDaysCsv);
                        days = getSelectedChangeWeekdays();
                    }
                    if (!days.length) {
                        var pkgId = document.getElementById("changePackageSelect")?.value || "";
                        var pkg = changePackagesCache.find(function (p) { return String(p.id) === String(pkgId); });
                        if (pkg && pkg.weeklyDaysCsv) {
                            setChangeWeekdaysFromCsv(pkg.weeklyDaysCsv);
                            days = getSelectedChangeWeekdays();
                        }
                    }
                    if (days.length) {
                        var visitCount = Math.max(1, days.length) * 4 * months;
                        endIso = calcNthWeeklyOccurrenceEndIso(start, days, visitCount);
                    }
                } else {
                    var d = new Date(start + "T12:00:00");
                    d.setMonth(d.getMonth() + months);
                    endIso = isoDate(d);
                }
            }
            if (endEl) {
                endEl.dataset.iso = endIso || "";
                endEl.value = endIso ? formatDateDisplayAz(endIso) : "";
            }
        }

        function syncChangePackageWeekdayLimit() {
            var limitRaw = Number(lastChangePreview && lastChangePreview.weeklyDaysCount);
            var limit = Number.isInteger(limitRaw) && limitRaw >= 1 && limitRaw <= 7 ? limitRaw : null;
            ensureChangeWeekdayChips();
            var boxes = Array.from(document.querySelectorAll(".change-pkg-dow"));
            if (limit == null) {
                boxes.forEach(function (b) { b.disabled = false; });
                return;
            }
            var checked = boxes.filter(function (b) { return b.checked; });
            if (checked.length > limit) {
                for (var i = limit; i < checked.length; i++) checked[i].checked = false;
                checked = boxes.filter(function (b) { return b.checked; });
            }
            var atLimit = checked.length >= limit;
            boxes.forEach(function (b) { b.disabled = atLimit && !b.checked; });
        }

        function ensureChangeWeekdayChips() {
            var box = document.getElementById("changePackageWeekdays");
            if (!box || box.dataset.ready === "1") return;
            box.innerHTML = weekdayLabels.map(function (label, dow) {
                return '<label style="display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;color:#253060;">'
                    + '<input type="checkbox" class="change-pkg-dow" value="' + dow + '" /> ' + label + '</label>';
            }).join("");
            box.dataset.ready = "1";
        }

        function setChangeWeekdaysFromCsv(csv) {
            ensureChangeWeekdayChips();
            var set = {};
            String(csv || "").split(",").forEach(function (p) {
                var n = Number(String(p).trim());
                if (Number.isInteger(n) && n >= 0 && n <= 6) set[n] = true;
            });
            document.querySelectorAll(".change-pkg-dow").forEach(function (cb) {
                cb.checked = !!set[Number(cb.value)];
            });
        }

        function getSelectedChangeWeekdays() {
            return Array.from(document.querySelectorAll(".change-pkg-dow:checked"))
                .map(function (cb) { return Number(cb.value); })
                .filter(function (n) { return Number.isInteger(n); });
        }

        function syncChangePackageWeeklyUi(preview) {
            var row = document.getElementById("changePackageWeeklyRow");
            var fixed = isChangePackageFixedWeekly() || !!(preview && preview.isFixedWeekly);
            if (row) row.style.display = fixed ? "block" : "none";
            if (fixed) {
                ensureChangeWeekdayChips();
                if (!getSelectedChangeWeekdays().length) {
                    var csv = (preview && preview.defaultWeeklyDaysCsv) || "";
                    if (!csv) {
                        var pkgId = document.getElementById("changePackageSelect")?.value || "";
                        var pkg = changePackagesCache.find(function (p) { return String(p.id) === String(pkgId); });
                        csv = (pkg && pkg.weeklyDaysCsv) || "";
                    }
                    if (csv) setChangeWeekdaysFromCsv(csv);
                }
                syncChangePackageWeekdayLimit();
            }
            syncChangePackageEndDate();
        }

        function isJustRenewChecked() {
            return !!document.getElementById("changePackageSkipPayment")?.checked;
        }

        function syncChangePaymentFieldsDisabled() {
            var justRenew = isJustRenewChecked();
            var requiresPay = !!(lastChangePreview && lastChangePreview.requiresNewPayment) && !justRenew;
            var skipWrap = document.getElementById("changePackageSkipPaymentWrap");
            var payFields = document.getElementById("changePackagePayFields");
            var skip = document.getElementById("changePackageSkipPayment");
            if (skipWrap) skipWrap.style.display = "";
            if (skip) skip.disabled = false;
            if (payFields) {
                payFields.style.display = requiresPay ? "" : "none";
            }
            ["changePackageDiscount", "changePackageCash", "changePackageCard", "changePackageComplimentary"].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.disabled = !requiresPay;
            });
        }

        async function ensureChangePackagesLoaded() {
            if (changePackagesCache.length) return;
            var res = await fetch("/packages/active", { credentials: "same-origin" });
            var data = await res.json().catch(function () { return []; });
            changePackagesCache = Array.isArray(data) ? data : [];
            var sel = document.getElementById("changePackageSelect");
            if (!sel) return;
            sel.innerHTML = '<option value="">Paket seçin</option>' + changePackagesCache.map(function (p) {
                return '<option value="' + AFS.escapeHtml(p.id) + '">'
                    + AFS.escapeHtml(p.name || "") + " · " + money(p.price) + "</option>";
            }).join("");
        }

        async function refreshChangePackagePreview() {
            lastChangePreview = null;
            var hint = document.getElementById("changePackagePreviewHint");
            var pkgId = document.getElementById("changePackageSelect")?.value || "";
            if (!currentPaymentsAthleteId || !pkgId) {
                if (hint) hint.textContent = "Yeni paket seçin.";
                syncChangePackageWeeklyUi(null);
                syncChangePaymentFieldsDisabled();
                return;
            }
            var justRenew = isJustRenewChecked();
            var discount = justRenew ? 0 : Number(document.getElementById("changePackageDiscount")?.value || 0);
            var res = await fetch(
                "/admin/customers/" + encodeURIComponent(currentPaymentsAthleteId)
                + "/change-package/preview?newServicePackageId=" + encodeURIComponent(pkgId)
                + "&discountAmount=" + encodeURIComponent(discount)
                + "&justRenew=" + (justRenew ? "true" : "false"),
                { credentials: "same-origin" });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) {
                if (hint) hint.textContent = data.error || "Hesablama alınmadı.";
                return;
            }
            lastChangePreview = data;
            syncChangePackageWeeklyUi(data);
            syncChangePaymentFieldsDisabled();
            if (justRenew || !data.requiresNewPayment) {
                if (hint) hint.textContent = data.lifecycleHint
                    || (justRenew
                        ? "Sadəcə yenilə — ödəniş etmədən seçilmiş paket və müddət yazılacaq."
                        : "Aktiv paket — yalnız plan yenilənəcək. Ödəniş qeydi dəyişməyəcək.");
                return;
            }
            if (hint) {
                hint.textContent = (data.lifecycleHint ? data.lifecycleHint + " " : "")
                    + "Ödəniləcək: " + money(data.newPayable) + " AZN — nağd və/və ya karta yazın.";
            }
        }

        document.getElementById("changePackageSelect")?.addEventListener("change", refreshChangePackagePreview);
        document.getElementById("changePackageDiscount")?.addEventListener("change", refreshChangePackagePreview);
        document.getElementById("changePackageSkipPayment")?.addEventListener("change", refreshChangePackagePreview);
        document.getElementById("changePackagePreviewBtn")?.addEventListener("click", refreshChangePackagePreview);
