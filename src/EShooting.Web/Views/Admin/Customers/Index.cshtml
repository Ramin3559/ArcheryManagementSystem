@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Müştərilər";
}

<style>
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 12px; align-items: end; }
    .filter-grid label.field { display: flex; flex-direction: column; gap: 6px; }
    .filter-grid .field span { color: var(--muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .filter-grid input:not([type="checkbox"]), .filter-grid select { width: 100%; min-width: 0; }
    .filter-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
    .field--presets { grid-column: span 2; min-width: 420px; }
    .field--presets > span { visibility: hidden; user-select: none; }
    .preset-inline { display: flex; gap: 8px; flex-wrap: nowrap; align-items: center; min-height: 38px; }
    .preset-btn {
        border-radius:999px;
        border:1px solid var(--border);
        background:#fff;
        padding:6px 14px;
        font-weight:700;
        cursor:pointer;
        font-size:13px;
        color:#253060;
    }
    .preset-btn:hover { background: rgba(79,70,229,0.08); border-color: rgba(79,70,229,0.18); }
    .preset-btn.active {
        background: rgba(79,70,229,0.12);
        border-color: rgba(79,70,229,0.28);
        color: #3730a3;
    }
    .card.loading { opacity: 0.65; pointer-events: none; }
    .cust-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .cust-actions .btn { padding: 4px 10px; font-size: 12px; min-height: 32px; }
    .row-deleted td { opacity: 0.78; }
    #customersTableCard .tableWrap {
        overflow: auto;
        max-height: 70vh;
    }
    #customersTableCard table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        table-layout: auto;
    }
    #customersTableCard th,
    #customersTableCard td {
        padding: 8px 10px;
        font-size: 13px;
        white-space: nowrap;
        vertical-align: middle;
    }
    #customersTableCard th {
        font-size: 11px;
        letter-spacing: .04em;
    }
    #customersTableCard tbody tr.cust-row {
        cursor: pointer;
    }
    #customersTableCard tbody tr.cust-row:hover {
        background: rgba(79, 70, 229, 0.05);
    }
    #customersTableCard td.col-actions {
        cursor: default;
        position: sticky;
        right: 0;
        background: #fff;
        box-shadow: -6px 0 8px -8px rgba(17, 24, 39, 0.25);
    }
    #customersTableCard tr.row-deleted td.col-actions {
        background: #fff;
    }
    #packagePaymentsModal .tableWrap th,
    #packagePaymentsModal .tableWrap td {
        padding: 8px 10px;
        font-size: 13px;
        white-space: nowrap;
    }
    #packagePaymentsModal tbody tr.pay-row {
        cursor: pointer;
    }
    #packagePaymentsModal tbody tr.pay-row:hover {
        background: rgba(79, 70, 229, 0.05);
    }
    #packagePaymentsModal tbody tr.pay-row.is-selected {
        background: rgba(79, 70, 229, 0.08);
    }
</style>

<div class="topbar">
    <h1>Müştərilər</h1>
    <a class="btn btn-excel" id="customersExportBtn" href="/admin/customers/export.xlsx"><svg class="btn-ico" aria-hidden="true"><use href="#ai-excel"/></svg><span class="btn-label">Excel-ə çıxart</span></a>
</div>

<form id="customersAntiForgery" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="card" style="margin-bottom:12px;">
    <form id="customersFilterForm" autocomplete="off">
        <div class="filter-grid">
            <label class="field">
                <span>Axtarış</span>
                <input name="search" placeholder="Ad, telefon, qeydiyyata alan…" />
            </label>
            <label class="field">
                <span>VIP</span>
                <select name="vip">
                    <option value="">Hamısı</option>
                    <option value="yes">VIP</option>
                    <option value="no">VIP deyil</option>
                </select>
            </label>
            <label class="field">
                <span>Paket növü</span>
                <select name="packageType">
                    <option value="">Hamısı</option>
                    <option value="birdefelik">Birdefəlik</option>
                    <option value="abune">Abunə</option>
                    <option value="vip">VIP abunə</option>
                </select>
            </label>
            <label class="field">
                <span>Oyun icarəsi</span>
                <select name="sessionRental">
                    <option value="">Hamısı</option>
                    <option value="any">Oyun icarəsi olub</option>
                    <option value="pending">Qaytarılmamış icarə</option>
                    <option value="none">Oyun icarəsi olmayıb</option>
                </select>
            </label>
            <label class="field">
                <span>Status</span>
                <select name="active">
                    <option value="active" selected>Aktiv</option>
                    <option value="inactive">Silinmiş</option>
                </select>
            </label>
            <label class="field">
                <span>Kateqoriya</span>
                <select name="category">
                    <option value="">Hamısı</option>
                    <option value="0">Həvəskar</option>
                    <option value="1">Peşəkar</option>
                    <option value="2">Məşqçi</option>
                </select>
            </label>
            <label class="field">
                <span>Son zolağa yazılma (başlanğıc)</span>
                <input type="date" name="registeredFrom" id="customersFromDate" value="" />
            </label>
            <label class="field">
                <span>Son zolağa yazılma (son)</span>
                <input type="date" name="registeredTo" id="customersToDate" value="" />
            </label>
            <div class="field field--presets">
                <span>Tarix</span>
                <div class="preset-inline">
                    <button type="button" class="preset-btn" data-preset="today">Bu gün</button>
                    <button type="button" class="preset-btn" data-preset="yesterday">Dünən</button>
                    <button type="button" class="preset-btn" data-preset="last7">Son 7 gün</button>
                    <button type="button" class="preset-btn" data-preset="month">Cari ay</button>
                    <button type="button" class="preset-btn active" data-preset="all">Hamısı</button>
                </div>
            </div>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit"><svg class="btn-ico" aria-hidden="true"><use href="#ai-search"/></svg><span class="btn-label">Axtar</span></button>
        </div>
    </form>
</div>

<div class="card" id="customersTableCard">
    <div class="tableWrap">
        <table>
            <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Telefon</th>
                <th>VIP</th>
                <th>Paket növü</th>
                <th>Paket adı</th>
                <th>Ödəniş</th>
                <th>Abunə müddəti</th>
                <th>Qeydiyyata alınma</th>
                <th>Qeydiyyata alan</th>
                <th>Son zolağa yazılma</th>
                <th>Oyun icarəsi</th>
                <th>Silən</th>
                <th></th>
            </tr>
            </thead>
            <tbody id="customersTableBody">
            <tr><td colspan="13" style="color:var(--muted);">Yüklənir…</td></tr>
            </tbody>
        </table>
    </div>
    <p class="statLabel" style="margin-top:10px;" id="customersCountLabel">Cəmi: — müştəri</p>
</div>

<div id="packagePaymentsModal"
     style="display:none; position:fixed; inset:0; background:rgba(11,18,32,0.45); z-index:9999; padding:16px; overflow:auto;">
    <div style="max-width:920px; margin:24px auto; background:#fff; border:1px solid var(--border); border-radius:14px; padding:16px;">
        <div style="display:flex; gap:10px; align-items:center; justify-content:space-between; flex-wrap:wrap;">
            <div>
                <div style="font-weight:900; color:#1a2650; font-size:18px;">Paket ödənişləri</div>
                <div id="packagePaymentsAthlete" style="color:var(--muted); font-size:13px; margin-top:4px;"></div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="packagePaymentsCloseBtn"><svg class="btn-ico" aria-hidden="true"><use href="#ai-x"/></svg><span class="btn-label">Bağla</span></button>
        </div>
        <div class="tableWrap" style="margin-top:12px;">
            <table>
                <thead>
                <tr>
                    <th>Tarix</th>
                    <th>Paket</th>
                    <th>Qiymət</th>
                    <th>Endirim</th>
                    <th>Nağd</th>
                    <th>Kart</th>
                    <th>Cəm</th>
                </tr>
                </thead>
                <tbody id="packagePaymentsBody">
                <tr><td colspan="7" style="color:var(--muted);">Yüklənir…</td></tr>
                </tbody>
            </table>
        </div>
        <div id="packagePaymentEditPanel" style="display:none; margin-top:14px; padding-top:14px; border-top:1px solid var(--border);">
            <div style="font-weight:800; color:#1a2650; margin-bottom:4px;">Ödənişi düzəlt</div>
            <p id="editPaymentSelectedLabel" class="statLabel" style="margin:0 0 10px;">Siyahıdan seçin və ya dəyərləri dəyişin.</p>
            <input type="hidden" id="editPaymentRecordId" />
            <div class="filter-grid">
                <label class="field">
                    <span>Qiymət (AZN)</span>
                    <input id="editPaymentPriceDue" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Endirim (AZN)</span>
                    <input id="editPaymentDiscount" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Nağd (AZN)</span>
                    <input id="editPaymentCash" type="number" min="0" step="0.01" />
                </label>
                <label class="field">
                    <span>Kart (AZN)</span>
                    <input id="editPaymentCard" type="number" min="0" step="0.01" />
                </label>
                <label class="field" style="flex-direction:row; align-items:center; gap:8px;">
                    <input id="editPaymentComplimentary" type="checkbox" />
                    <span style="text-transform:none; letter-spacing:0;">Pulsuz</span>
                </label>
            </div>
            <p id="editPaymentHint" class="statLabel" style="margin-top:8px;">Ödəniləcək = qiymət − endirim. Nağd və ya karta yazın — digəri avtomatik dolacaq.</p>
            <div class="filter-actions">
                <button type="button" class="btn btn-primary" id="editPaymentSaveBtn"><svg class="btn-ico" aria-hidden="true"><use href="#ai-check"/></svg><span class="btn-label">Yadda saxla</span></button>
                <button type="button" class="btn btn-ghost" id="editPaymentDeleteBtn" style="color:#b91c1c;"><svg class="btn-ico" aria-hidden="true"><use href="#ai-trash"/></svg><span class="btn-label">Sil</span></button>
            </div>
        </div>
        <div id="packageChangePanel" style="margin-top:14px; padding-top:14px; border-top:1px solid var(--border);">
            <div style="font-weight:800; color:#1a2650; margin-bottom:8px;">Paketi dəyiş</div>
            <div class="filter-grid">
                <label class="field" style="grid-column:1/-1;">
                    <span>Yeni paket</span>
                    <select id="changePackageSelect"><option value="">Paket seçin</option></select>
                </label>
                <label class="field">
                    <span>Abunə başlanğıcı</span>
                    <input id="changePackageStart" type="date" />
                </label>
                <label class="field">
                    <span>Neçə AY</span>
                    <select id="changePackageMonths">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == 1)">@m</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Abunə bitməsi (avtomatik)</span>
                    <input id="changePackageEnd" type="text" readonly tabindex="-1" data-no-flatpickr="1"
                           placeholder="—" title="Seçilmiş günlərə görə N-ci gediş günü"
                           style="background:rgba(0,0,0,0.04); cursor:default;" />
                </label>
                <div id="changePackageWeeklyRow" style="grid-column:1/-1; display:none;">
                    <div class="statLabel" style="margin-bottom:6px;">Həftə günləri (aylıq plan)</div>
                    <div id="changePackageWeekdays" style="display:flex; flex-wrap:wrap; gap:8px;"></div>
                    <label class="field" style="margin-top:8px; max-width:160px;">
                        <span>Saat</span>
                        <input id="changePackageWeeklyTime" class="hhmm-time" type="text" inputmode="numeric" placeholder="HH:mm" value="18:00" maxlength="5" />
                    </label>
                </div>
                <label class="field" style="grid-column:1/-1; flex-direction:row; align-items:center; gap:8px;" id="changePackageSkipPaymentWrap">
                    <input id="changePackageSkipPayment" type="checkbox" />
                    <span style="text-transform:none; letter-spacing:0;">Sadəcə yenilə (ödənişsiz — bitməyə baxılmır)</span>
                </label>
                <div id="changePackagePayFields">
                <label class="field">
                    <span>Endirim (AZN)</span>
                    <input id="changePackageDiscount" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field">
                    <span>Nağd (AZN)</span>
                    <input id="changePackageCash" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field">
                    <span>Kart (AZN)</span>
                    <input id="changePackageCard" type="number" min="0" step="0.01" value="0" />
                </label>
                <label class="field" style="flex-direction:row; align-items:center; gap:8px;">
                    <input id="changePackageComplimentary" type="checkbox" />
                    <span style="text-transform:none; letter-spacing:0;">Pulsuz</span>
                </label>
                </div>
            </div>
            <p id="changePackagePreviewHint" class="statLabel" style="margin-top:8px;">Yeni paket seçin — ödəniş fərqi burada görünəcək.</p>
            <div class="filter-actions" style="margin-top:10px;">
                <button type="button" class="btn btn-primary" id="changePackageSaveBtn"><svg class="btn-ico" aria-hidden="true"><use href="#ai-package"/></svg><span class="btn-label">Paketi dəyiş</span></button>
                <button type="button" class="btn btn-ghost" id="changePackagePreviewBtn"><svg class="btn-ico" aria-hidden="true"><use href="#ai-calc"/></svg><span class="btn-label">Fərqi hesabla</span></button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // v2: köhnə sessionStorage (məcburi «bu gün» / dar tarix) sıfırlanır
        var STORAGE_KEY = "admin-customers-v5";
        var form = document.getElementById("customersFilterForm");
        var exportBtn = document.getElementById("customersExportBtn");
        var tbody = document.getElementById("customersTableBody");
        var countLabel = document.getElementById("customersCountLabel");
        var tableCard = document.getElementById("customersTableCard");
        var antiForm = document.getElementById("customersAntiForgery");
        var fromEl = document.getElementById("customersFromDate");
        var toEl = document.getElementById("customersToDate");
        var debounceTimer = null;
        var applyingPreset = false;
        var AFS = window.AdminFilterState;

        function isoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, "0");
            var day = String(d.getDate()).padStart(2, "0");
            return y + "-" + m + "-" + day;
        }

        function qsFromForm() {
            var params = new URLSearchParams(new FormData(form));
            // Boş tarixləri göndərmə — server hamısını qaytarsın
            if (!params.get("registeredFrom")) params.delete("registeredFrom");
            if (!params.get("registeredTo")) params.delete("registeredTo");
            return params;
        }

        function setDateInput(el, iso) {
            if (!(el instanceof HTMLInputElement)) return;
            el.value = iso || "";
            if (el._flatpickr) {
                if (iso) {
                    el._flatpickr.setDate(iso, false);
                } else {
                    el._flatpickr.clear();
                }
            }
        }

        function clearDateRange() {
            setDateInput(fromEl, "");
            setDateInput(toEl, "");
        }

        function markPresetActive(preset) {
            document.querySelectorAll(".preset-btn[data-preset]").forEach(function (btn) {
                btn.classList.toggle("active", (btn.getAttribute("data-preset") || "") === preset);
            });
        }

        function setTodayDateRange() {
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            setDateInput(fromEl, isoDate(today));
            setDateInput(toEl, isoDate(today));
            markPresetActive("today");
        }

        function applyPreset(preset) {
            if (!(fromEl instanceof HTMLInputElement) || !(toEl instanceof HTMLInputElement)) return;
            applyingPreset = true;
            if (preset === "all") {
                clearDateRange();
                markPresetActive("all");
                applyingPreset = false;
                void loadList();
                return;
            }
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            var from = new Date(today);
            var to = new Date(today);
            if (preset === "yesterday") {
                from.setDate(from.getDate() - 1);
                to = new Date(from);
            } else if (preset === "last7") {
                from.setDate(from.getDate() - 6);
            } else if (preset === "month") {
                from = new Date(today.getFullYear(), today.getMonth(), 1);
                to = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            }
            setDateInput(fromEl, isoDate(from));
            setDateInput(toEl, isoDate(to));
            markPresetActive(preset || "today");
            applyingPreset = false;
            void loadList();
        }

        function antiforgeryToken() {
            if (!antiForm) return "";
            var input = antiForm.querySelector('input[name="__RequestVerificationToken"]');
            return input && "value" in input ? input.value : "";
        }

        function syncExportUrl() {
            if (!exportBtn) return;
            exportBtn.href = "/admin/customers/export.xlsx?" + qsFromForm().toString();
        }

        function sessionRentalLabel(x) {
            if (x.hasPendingSessionRental) return "Qaytarılmamış icarə";
            if (x.hasSessionEquipmentRental) return "Bəli";
            return "—";
        }

        function deletedByLabel(x) {
            if (x.isActive) return "—";
            if (x.deletedByName && x.deletedByName !== "—") {
                var when = x.deletedAtLocal ? (" · " + x.deletedAtLocal) : "";
                return AFS.escapeHtml(x.deletedByName) + (when ? AFS.escapeHtml(when) : "");
            }
            return "—";
        }

        function adminBtnIco(id) {
            return '<svg class="btn-ico" aria-hidden="true"><use href="#' + id + '"></use></svg>';
        }

        function actionCell(x) {
            if (x.isActive) {
                return '<div class="cust-actions"><button type="button" class="btn btn-danger" data-action="delete" data-id="'
                    + AFS.escapeHtml(x.id) + '">' + adminBtnIco("ai-trash") + '<span class="btn-label">Sil</span></button></div>';
            }
            return '<div class="cust-actions">'
                + '<button type="button" class="btn btn-primary" data-action="restore" data-id="'
                + AFS.escapeHtml(x.id) + '">' + adminBtnIco("ai-undo") + '<span class="btn-label">Bərpa</span></button>'
                + '<button type="button" class="btn btn-danger" data-action="hard-delete" data-id="'
                + AFS.escapeHtml(x.id) + '" data-name="' + AFS.escapeHtml(x.fullName || "")
                + '">' + adminBtnIco("ai-trash") + '<span class="btn-label">Birdəfəlik sil</span></button>'
                + '</div>';
        }

        function renderRows(items) {
            if (!tbody) return;
            if (!items.length) {
                tbody.innerHTML = '<tr><td colspan="13" style="color:var(--muted);">Bu filtrə uyğun qeyd tapılmadı.</td></tr>';
                return;
            }
            tbody.innerHTML = items.map(function (x) {
                var sub = x.subscriptionFromLocal ? (AFS.escapeHtml(x.subscriptionFromLocal) + " — " + AFS.escapeHtml(x.subscriptionToLocal)) : "—";
                var lastLane = x.lastLaneVisitLocal
                    ? AFS.escapeHtml(x.lastLaneVisitLocal + (x.lastVisitPlaceLabel ? " · " + x.lastVisitPlaceLabel : (x.lastLaneNumber ? " · Zolaq " + x.lastLaneNumber : "")))
                    : "—";
                var name = AFS.escapeHtml(x.fullName) + (x.isVip ? " · VIP" : "");
                if (!x.isActive) name += ' <span style="color:#b91c1c;font-size:11px;">(silinmiş)</span>';
                var rowClass = "cust-row" + (x.isActive ? "" : " row-deleted");
                var payment = AFS.escapeHtml(x.latestPaymentLabel || "—");
                return '<tr class="' + rowClass + '" data-athlete-id="' + AFS.escapeHtml(x.id)
                    + '" data-athlete-name="' + AFS.escapeHtml(x.fullName || "") + '">'
                    + "<td>" + name + "</td>"
                    + "<td>" + AFS.escapeHtml(x.phoneNumber) + "</td>"
                    + "<td>" + (x.isVip ? "Bəli" : "—") + "</td>"
                    + "<td>" + AFS.escapeHtml(x.packageTypeLabel) + "</td>"
                    + "<td>" + AFS.escapeHtml(x.currentPackageName || "—") + "</td>"
                    + "<td>" + payment + "</td>"
                    + "<td>" + sub + "</td>"
                    + "<td>" + AFS.escapeHtml(x.registeredAtLocal) + "</td>"
                    + "<td>" + AFS.escapeHtml(x.registeredByStaffName) + "</td>"
                    + "<td>" + lastLane + "</td>"
                    + "<td>" + AFS.escapeHtml(sessionRentalLabel(x)) + "</td>"
                    + "<td>" + deletedByLabel(x) + "</td>"
                    + '<td class="col-actions">' + actionCell(x) + "</td>"
                    + "</tr>";
            }).join("");
        }

        async function postCustomerAction(id, action) {
            var url = action === "delete"
                ? "/admin/customers/" + id + "/delete"
                : action === "hard-delete"
                    ? "/admin/customers/" + id + "/hard-delete"
                    : "/admin/customers/" + id + "/restore";
            var body = new URLSearchParams();
            body.set("__RequestVerificationToken", antiforgeryToken());
            var res = await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": antiforgeryToken()
                },
                body: body.toString()
            });
            var data = null;
            try { data = await res.json(); } catch (_) { /* ignore */ }
            if (!res.ok) {
                throw new Error((data && data.error) || "Əməliyyat alınmadı.");
            }
            return data;
        }

        if (tbody) {
            tbody.addEventListener("click", function (e) {
                var btn = e.target && e.target.closest ? e.target.closest("button[data-action]") : null;
                if (btn) {
                    var id = btn.getAttribute("data-id");
                    var action = btn.getAttribute("data-action");
                    if (!id || !action) return;
                    var confirmMsg;
                    if (action === "delete") {
                        confirmMsg = "Müştəri silinsin? (Silinmiş siyahısına düşəcək — bərpa etmək olar)";
                    } else if (action === "hard-delete") {
                        var nm = btn.getAttribute("data-name") || "bu müştəri";
                        confirmMsg = "«" + nm + "» birdəfəlik silinsin?";
                    } else {
                        confirmMsg = "Müştəri bərpa edilsin?";
                    }
                    if (!window.confirm(confirmMsg)) return;
                    btn.disabled = true;
                    postCustomerAction(id, action)
                        .then(function () { return loadList(); })
                        .catch(function (err) {
                            alert(err && err.message ? err.message : "Əməliyyat alınmadı.");
                        })
                        .finally(function () { btn.disabled = false; });
                    return;
                }

