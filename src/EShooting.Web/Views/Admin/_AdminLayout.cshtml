@{
    Layout = null;
    var title = (string?)ViewData["Title"] ?? "Admin";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <title>@title — Target Admin</title>
    <style>
        :root {
            --bg: #f6f7fb;
            --panel: #ffffff;
            --text: #111827;
            --muted: #6b7280;
            --border: rgba(17, 24, 39, 0.12);
            --primary: #4f46e5;
            --green: #16a34a;
        }
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            max-width: 100%;
            overflow-x: hidden;
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
        }
        a { color: inherit; text-decoration: none; }
        .shell {
            display: grid;
            grid-template-columns: 232px minmax(0, 1fr);
            min-height: 100vh;
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
        }
        .side {
            background: var(--panel);
            border-right: 1px solid var(--border);
            padding: 16px 12px;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            flex-shrink: 0;
        }
        .brand { font-weight: 900; letter-spacing: .02em; margin-bottom: 14px; font-size: 15px; }
        .nav { display:flex; flex-direction: column; gap: 6px; margin-top: 12px; }
        .nav a, .nav button {
            display:flex;
            align-items:center;
            justify-content: flex-start;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 12px;
            border: 1px solid transparent;
            background: transparent;
            cursor:pointer;
            font-weight: 700;
            font-size: 13px;
            color: #253060;
            text-transform: none;
            line-height: 1.3;
            word-break: break-word;
        }
        .nav-ico {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            display: block;
            color: #3a4a7a;
        }
        .nav a:hover,
        .nav button:hover,
        .nav a.is-active {
            background: rgba(79,70,229,0.08);
            border-color: rgba(79,70,229,0.18);
        }
        .nav a.is-active {
            color: #4f46e5;
        }
        .nav a.is-active .nav-ico {
            color: #4f46e5;
        }
        .nav a.nav-logout {
            color: #9f1239;
            margin-top: 4px;
        }
        .nav a.nav-logout .nav-ico {
            color: #9f1239;
        }
        .nav a.nav-logout:hover {
            background: rgba(159, 18, 57, 0.08);
            border-color: rgba(159, 18, 57, 0.18);
            color: #9f1239;
        }
        .content {
            padding: 18px 16px 22px;
            min-width: 0;
            max-width: 100%;
            overflow-x: hidden;
        }
        .topbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom: 14px; }
        .topbar h1 { margin:0; font-size: 22px; font-weight: 900; }
        .card { background: var(--panel); border:1px solid var(--border); border-radius: 16px; padding: 14px; }
        .grid4 { display:grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
        @@media (max-width: 1100px){ .grid4{ grid-template-columns: repeat(2, minmax(0,1fr)); } .shell{ grid-template-columns: 1fr; } .side{ position:relative; height:auto; } }
        .statLabel { color: var(--muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
        .statValue { font-weight: 900; font-size: 26px; margin-top: 4px; }
        .row { display:flex; flex-wrap: wrap; gap: 10px; align-items: end; }
        input:not([type="checkbox"]):not([type="radio"]) { border-radius: 12px; border: 1px solid var(--border); padding: 10px 12px; min-height: 42px; background:#fff; min-width: 160px; }
        select { border-radius: 12px; border: 1px solid var(--border); padding: 10px 12px; min-height: 42px; background:#fff; min-width: 160px; }
        input[type="checkbox"] { width: 18px; height: 18px; min-width: 18px; min-height: 18px; margin: 0; accent-color: var(--primary); cursor: pointer; }
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 12px;
            border: 1px solid var(--border);
            padding: 10px 12px;
            min-height: 42px;
            font-weight: 800;
            cursor: pointer;
            background: #fff;
            color: inherit;
            text-decoration: none;
            line-height: 1.2;
            white-space: nowrap;
        }
        .btn-ico {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            display: block;
        }
        .btn-sm .btn-ico,
        .btn-row .btn-ico,
        .actions .btn-ico,
        .cust-actions .btn-ico {
            width: 14px;
            height: 14px;
        }
        .btn-primary { background: var(--primary); border-color: rgba(79,70,229,0.35); color:#fff; }
        .btn-excel { background: var(--green); border-color: rgba(22,163,74,0.35); color:#fff; }
        .btn-warning { background: #f59e0b; border-color: rgba(245,158,11,0.45); color:#111827; }
        .btn-danger { background: #ef4444; border-color: rgba(239,68,68,0.45); color:#fff; }
        .actions {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 8px;
            width: max-content;
        }
        .actions form {
            display: inline-flex;
            margin: 0;
            flex: 0 0 auto;
        }
        .actions .btn {
            min-height: 36px;
            padding: 6px 12px;
            font-size: 13px;
        }
        .tableWrap td:has(> .actions) {
            width: 1%;
            white-space: nowrap;
            vertical-align: middle;
        }
        .admin-icon-sprite {
            position: absolute;
            width: 0;
            height: 0;
            overflow: hidden;
        }
        table { width:100%; border-collapse: collapse; }
        th, td { padding: 10px 10px; border-bottom: 1px solid rgba(17,24,39,0.10); text-align: left; }
        .tableWrap th, .tableWrap td { white-space: nowrap; }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
        .tableWrap { overflow: auto; max-height: 70vh; max-width: 100%; border-radius: 14px; border:1px solid var(--border); }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/az.js"></script>
    <script src="/js/admin-filter-state.js"></script>
</head>
<body>
<svg class="admin-icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="ai-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></symbol>
    <symbol id="ai-excel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></symbol>
    <symbol id="ai-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></symbol>
    <symbol id="ai-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></symbol>
    <symbol id="ai-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></symbol>
    <symbol id="ai-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="ai-undo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M3 13a9 9 0 1 0 3-7.7L3 8"/></symbol>
    <symbol id="ai-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></symbol>
    <symbol id="ai-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></symbol>
    <symbol id="ai-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
    <symbol id="ai-filter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></symbol>
    <symbol id="ai-journal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></symbol>
    <symbol id="ai-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></symbol>
    <symbol id="ai-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
    <symbol id="ai-package" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></symbol>
    <symbol id="ai-calc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></symbol>
</svg>
<div class="shell">
    <aside class="side">
        <div class="brand">Target Admin</div>
        <div class="nav">
            <a href="/admin"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Əsas səhifə</a>
            <a href="/admin/analytics"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>Hesabat</a>
            <a href="/admin/packages"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>Paketlər</a>
            <a href="/admin/club-cards"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>Kartlar</a>
            <a href="/admin/equipment"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Avadanlıqlar</a>
            <a href="/admin/positions"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>Vəzifələr</a>
            <a href="/admin/access-profiles"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>İcazə profilləri</a>
            <a href="/admin/employees"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>İşçilər</a>
            <a href="/admin/customers"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Müştərilər</a>
            <a href="/Account/Logout" class="nav-logout"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>Çıxış</a>
        </div>
    </aside>
    <main class="content">
        @RenderBody()
    </main>
</div>
<script>
    window.setAdminButtonLabel = function (btn, text) {
        if (!btn) return;
        var label = btn.querySelector(".btn-label");
        if (label) label.textContent = text;
        else btn.textContent = text;
    };
    (function () {
        function normalizePath(value) {
            var p = String(value || "").toLowerCase().split("?")[0].replace(/\/+$/, "");
            return p || "/";
        }

        function isNavActive(currentPath, linkPath) {
            if (linkPath === "/admin") return currentPath === "/admin";
            return currentPath === linkPath || currentPath.indexOf(linkPath + "/") === 0;
        }

        function markActiveNav() {
            var currentPath = normalizePath(window.location.pathname);
            document.querySelectorAll(".nav a[href]").forEach(function (link) {
                if (!(link instanceof HTMLAnchorElement)) return;
                var href = link.getAttribute("href") || "";
                if (!href || href.toLowerCase().indexOf("/account/logout") >= 0) return;
                var linkPath = normalizePath(href);
                link.classList.toggle("is-active", isNavActive(currentPath, linkPath));
            });
        }

        function ready() {
            markActiveNav();
            try {
                if (typeof window.flatpickr !== "function") return;
                if (window.flatpickr.l10ns && window.flatpickr.l10ns.az) {
                    window.flatpickr.localize(window.flatpickr.l10ns.az);
                }
                document.querySelectorAll('input[type="date"], input[type="time"], input[type="datetime-local"]').forEach(function (el) {
                    if (!(el instanceof HTMLInputElement)) return;
                    if (el.dataset.fpBound === "1") return;
                    var t = (el.getAttribute("type") || "").toLowerCase();
                    var opts = { locale: "az", allowInput: true, time_24hr: true, altInput: true };
                    if (t === "time") {
                        opts.enableTime = true;
                        opts.noCalendar = true;
                        opts.dateFormat = "H:i";
                        opts.altFormat = "H:i";
                    } else if (t === "datetime-local") {
                        opts.enableTime = true;
                        opts.dateFormat = "Y-m-d H:i";
                        opts.altFormat = "d.m.Y H:i";
                    } else {
                        opts.dateFormat = "Y-m-d";
                        opts.altFormat = "d.m.Y";
                    }
                    try { window.flatpickr(el, opts); el.dataset.fpBound = "1"; } catch (e) { /* ignore */ }
                });
            } catch (e) { /* ignore */ }
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", ready);
        } else {
            ready();
        }
    })();
</script>
</body>
</html>

