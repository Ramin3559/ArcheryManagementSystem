    function parseEquipmentQtyValue(raw, maxStock) {
        const text = String(raw ?? "").trim();
        if (!text) return null;
        const n = parseInt(text, 10);
        if (!Number.isFinite(n) || n < 1) return null;
        if (maxStock > 0) return Math.min(n, maxStock);
        return n;
    }

    function renderEquipmentPickerList() {
        if (!(equipmentPickerList instanceof HTMLElement)) return;
        equipmentPickerList.innerHTML = "";
        if (!equipmentCatalogCache.length) {
            equipmentPickerList.innerHTML = '<div class="notice">Aktiv avadanlıq tapılmadı. Admin panelindən əlavə edin.</div>';
            return;
        }

        const canApplyLineDiscount = receptionPermissions.canApplyDiscount;
        if (canApplyLineDiscount) {
            const head = document.createElement("div");
            head.style.display = "grid";
            head.style.gridTemplateColumns = "auto 1fr auto auto";
            head.style.gap = "10px";
            head.style.alignItems = "end";
            head.style.padding = "4px 12px 8px";
            head.style.fontSize = "11px";
            head.style.fontWeight = "700";
            head.style.color = "#667395";
            head.innerHTML = '<div></div><div></div><label class="field-mini"><span>Say</span></label><label class="field-mini"><span>Endirim (AZN)</span></label>';
            equipmentPickerList.appendChild(head);
        }

        for (const item of equipmentCatalogCache) {
            const saleStock = Number(item.saleQuantity ?? item.quantity ?? 0);
            if (saleStock <= 0) continue;
            const draft = equipmentPickerDraft.find(x => String(x.equipmentItemId) === String(item.id));
            const checked = Boolean(draft);
            const qty = Math.max(1, Number(draft?.quantity) || 1);
            const stock = saleStock;
            const outOfStock = stock <= 0;
            const unitPrice = Number(item.unitPrice ?? item.price) || 0;

            const row = document.createElement("div");
            row.style.display = "grid";
            row.style.gridTemplateColumns = canApplyLineDiscount ? "auto 1fr auto auto" : "auto 1fr auto";
            row.style.gap = "10px";
            row.style.alignItems = "center";
            row.style.padding = "10px 12px";
            row.style.border = "1px solid rgba(41,55,89,0.16)";
            row.style.borderRadius = "12px";
            row.style.background = "rgba(255,255,255,0.95)";

            const cb = document.createElement("input");
            cb.type = "checkbox";
            cb.checked = checked;
            cb.disabled = outOfStock;
            cb.dataset.equipmentId = item.id;

            const body = document.createElement("div");
            const title = document.createElement("div");
            title.style.fontWeight = "800";
            title.innerHTML = `<strong>${item.name}</strong> <span style="font-weight:600;color:#667395;">${item.category ? "(" + item.category + ")" : ""} · stok: ${stock} · vahid: ${unitPrice.toFixed(2)} AZN</span>`;
            body.appendChild(title);
            const linePayableEl = document.createElement("div");
            linePayableEl.style.fontSize = "12px";
            linePayableEl.style.fontWeight = "700";
            linePayableEl.style.color = "#2f4a7a";
            linePayableEl.style.marginTop = "6px";
            linePayableEl.style.display = "none";
            body.appendChild(linePayableEl);

            const qtyWrap = document.createElement("label");
            qtyWrap.style.display = "flex";
            qtyWrap.style.flexDirection = "column";
            qtyWrap.style.alignItems = "center";
            qtyWrap.style.gap = "4px";
            if (!canApplyLineDiscount) {
                const qtyLabel = document.createElement("span");
                qtyLabel.style.fontSize = "11px";
                qtyLabel.style.fontWeight = "700";
                qtyLabel.style.color = "#667395";
                qtyLabel.textContent = "Say";
                qtyWrap.appendChild(qtyLabel);
            }
            const qtyInput = document.createElement("input");
            qtyInput.type = "number";
            qtyInput.min = "1";
            qtyInput.max = String(Math.max(1, stock));
            qtyInput.step = "1";
            qtyInput.inputMode = "numeric";
            qtyInput.placeholder = "1";
            qtyInput.value = checked ? String(qty) : "";
            qtyInput.disabled = !checked || outOfStock;
            qtyInput.style.width = "64px";
            qtyInput.style.minHeight = "38px";
            qtyInput.style.textAlign = "center";
            qtyWrap.appendChild(qtyInput);

            let discountWrap = null;
            let discountInput = null;
            if (canApplyLineDiscount) {
                discountWrap = document.createElement("label");
                discountWrap.style.display = "flex";
                discountWrap.style.flexDirection = "column";
                discountWrap.style.alignItems = "center";
                discountWrap.style.gap = "4px";
                discountInput = document.createElement("input");
                discountInput.className = "discount-input";
                discountInput.type = "number";
                discountInput.min = "0";
                discountInput.step = "0.01";
                discountInput.inputMode = "decimal";
                discountInput.placeholder = "0.00";
                discountInput.title = "Bu sətir üzrə endirim (AZN) - seçilmiş sayın cəmi qiymətindən çıxılır";
                discountInput.value = checked && draft ? String(Number(draft.discountAmount || 0).toFixed(2)) : "";
                discountInput.disabled = !checked || outOfStock;
                discountInput.style.width = "72px";
                discountInput.style.minHeight = "38px";
                discountInput.style.textAlign = "center";
                discountWrap.appendChild(discountInput);
            }

            function getLineListTotal(q) {
                return unitPrice * Math.max(1, q);
            }

            function updateLinePayableDisplay(q, discount) {
                if (!cb.checked) {
                    linePayableEl.style.display = "none";
                    linePayableEl.textContent = "";
                    return;
                }
                const lineList = getLineListTotal(q);
                const net = Math.max(0, lineList - Math.max(0, discount));
                linePayableEl.style.display = "";
                linePayableEl.textContent = `Ödəniləcək: ${net.toFixed(2)} AZN${discount > 0.009 ? ` (əsas ${lineList.toFixed(2)} - endirim ${discount.toFixed(2)})` : ""}`;
            }

            const pushDraft = () => {
                if (!cb.checked) return;
                const q = parseEquipmentQtyValue(qtyInput.value, stock) ?? 1;
                qtyInput.value = String(q);
                const lineList = getLineListTotal(q);
                const discount = discountInput instanceof HTMLInputElement
                    ? Math.min(PaymentSplit.parseAmount(discountInput), lineList)
                    : 0;
                if (discountInput instanceof HTMLInputElement && discount !== PaymentSplit.parseAmount(discountInput)) {
                    discountInput.value = discount > 0 ? discount.toFixed(2) : "";
                }
                updateLinePayableDisplay(q, discount);
                equipmentPickerDraft = equipmentPickerDraft.filter(x => String(x.equipmentItemId) !== String(item.id));
                equipmentPickerDraft.push({
                    equipmentItemId: item.id,
                    issueType: "Sale",
                    quantity: q,
                    discountAmount: discount
                });
            };

            cb.addEventListener("change", () => {
                qtyInput.disabled = !cb.checked || outOfStock;
                if (discountInput instanceof HTMLInputElement) {
                    discountInput.disabled = !cb.checked || outOfStock;
                }
                equipmentPickerDraft = equipmentPickerDraft.filter(x => String(x.equipmentItemId) !== String(item.id));
                if (!cb.checked) {
                    qtyInput.value = "";
                    if (discountInput instanceof HTMLInputElement) discountInput.value = "";
                    updateLinePayableDisplay(0, 0);
                } else {
                    pushDraft();
                }
            });

            qtyInput.addEventListener("input", () => {
                if (!cb.checked) return;
                const text = String(qtyInput.value ?? "").trim();
                if (!text) {
                    equipmentPickerDraft = equipmentPickerDraft.filter(x => String(x.equipmentItemId) !== String(item.id));
                    updateLinePayableDisplay(0, 0);
                    return;
                }
                const q = parseEquipmentQtyValue(qtyInput.value, stock);
                if (q === null) return;
                if (String(q) !== qtyInput.value.trim()) {
                    qtyInput.value = String(q);
                }
                pushDraft();
            });
            qtyInput.addEventListener("blur", () => {
                if (!cb.checked) return;
                const q = parseEquipmentQtyValue(qtyInput.value, stock);
                if (q === null) {
                    cb.checked = false;
                    qtyInput.disabled = true;
                    qtyInput.value = "";
                    if (discountInput instanceof HTMLInputElement) {
                        discountInput.disabled = true;
                        discountInput.value = "";
                    }
                    equipmentPickerDraft = equipmentPickerDraft.filter(x => String(x.equipmentItemId) !== String(item.id));
                    updateLinePayableDisplay(0, 0);
                    return;
                }
                qtyInput.value = String(q);
                pushDraft();
            });
            discountInput?.addEventListener("input", () => pushDraft());
            discountInput?.addEventListener("blur", () => pushDraft());

            row.appendChild(cb);
            row.appendChild(body);
            row.appendChild(qtyWrap);
            if (discountWrap instanceof HTMLElement) row.appendChild(discountWrap);
            equipmentPickerList.appendChild(row);

            if (checked) {
                const disc = draft ? Number(draft.discountAmount) || 0 : 0;
                updateLinePayableDisplay(qty, disc);
            }
        }
    }



