    async function saveInfoProfile() {
        if (!_currentInfoAthleteId) {
            alert("Əvvəlcə müştərini axtarın.");
            return false;
        }

        const firstName = infoFirstName?.value?.trim() ?? "";
        const lastName = infoLastName?.value?.trim() ?? "";
        const phoneNumber = infoPhoneEdit?.value?.trim() ?? "";
        const email = infoEmailEdit?.value?.trim() ?? "";
        const idCardNumber = infoIdCardEdit?.value?.trim() ?? "";
        const clubCardNumber = infoClubCardEdit?.value?.trim() ?? "";
        const clubCardType = readClubCardTypeValue(infoClubCardType);
        const categoryRaw = infoCategory?.value ?? "";
        const membershipTypeRaw = infoMembershipType?.value || "0";
        if (!firstName || !lastName || !phoneNumber || !idCardNumber) {
            alert(customerRequiredFieldsMessage);
            return false;
        }
        if (!validateClubCardFields(clubCardNumber, clubCardType)) return false;
        if (!categoryRaw) { alert("Kateqoriya seçin."); return false; }

        const response = await apiFetch(`/athletes/${encodeURIComponent(_currentInfoAthleteId)}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                firstName,
                lastName,
                phoneNumber,
                email,
                idCardNumber,
                clubCardNumber,
                clubCardType,
                category: Number(categoryRaw),
                isSubscriber: Boolean(dataIsSubscriberForInfo()),
                membershipType: Number(membershipTypeRaw),
                isVip: Boolean(infoIsVip?.checked)
            })
        });

        if (!response.ok) {
            const message = await readErrorMessage(response);
            alert(message);
            return false;
        }

        const data = await response.json().catch(() => ({}));
        const successMessage = data?.message || "Məlumatlar uğurla yeniləndi.";

        receptionMatchedAthleteId = _currentInfoAthleteId;
        await applyAthleteToReception({
            id: _currentInfoAthleteId,
            firstName,
            lastName,
            fullName: `${firstName} ${lastName}`.trim(),
            phoneNumber,
            email,
            idCardNumber,
            clubCardNumber,
            clubCardType,
            category: Number(categoryRaw),
            membershipType: Number(membershipTypeRaw),
            isSubscriber: dataIsSubscriberForInfo(),
            isVip: Boolean(infoIsVip?.checked)
        });
        allAthletesCache = [];
        athletesCacheLoadedAtMs = 0;
        receptionMatchedSnapshot = buildReceptionCurrentSnapshot();
        syncUpdateAthleteButton();
        refreshSelectedCustomerCard();
        if (customerSearchInput instanceof HTMLInputElement) {
            customerSearchInput.value = `${firstName} ${lastName}`.trim();
        }
        closeInfoModal();
        setLookupHint(successMessage);
        showSessionNotice(successMessage, "ok");
        return true;
    }

    function dataIsSubscriberForInfo() {
        return Boolean(_currentInfoIsSubscriber);
    }

    const customerRequiredFieldsMessage = "Ad, Soyad, Telefon və Ş/V nömrəsi mütləqdir.";

    function clubCardTypeToSelectValue(value) {
        if (value === null || value === undefined || value === "") return "";
        if (typeof value === "number" && Number.isFinite(value)) return String(value);
        const s = String(value).trim().toLowerCase();
        if (s === "0" || s === "boz") return "0";
        if (s === "1" || s === "qirmizi" || s === "qırmızı") return "1";
        if (s === "2" || s === "qara") return "2";
        if (s === "3" || s === "vipqizili" || s === "vip-qızılı" || s === "vip-qizili") return "3";
        const n = Number(value);
        return Number.isFinite(n) ? String(n) : "";
    }

    function clubCardTypeLabel(value) {
        const v = clubCardTypeToSelectValue(value);
        if (v === "0") return "Boz";
        if (v === "1") return "Qırmızı";
        if (v === "2") return "Qara";
        if (v === "3") return "VIP-Qızılı";
        return "";
    }

    function formatClubCardDisplay(type, number) {
        const card = (number ?? "").toString().trim();
        if (!card) return "";
        const label = clubCardTypeLabel(type);
        return label ? `${label} · ${card}` : card;
    }

    function readClubCardTypeValue(selectEl) {
        const raw = selectEl?.value ?? "";
        if (raw === "" || raw === null || raw === undefined) return null;
        const n = Number(raw);
        return Number.isFinite(n) ? n : null;
    }

    function validateClubCardFields(cardNumber, cardType) {
        const card = (cardNumber ?? "").toString().trim();
        if (!card) return true;
        if (cardType === null || cardType === undefined || cardType === "") {
            alert("Kart növü seçin.");
            return false;
        }
        return true;
    }

    function receptionHasClubCardAssigned() {
        const card = (clubCardNumberInput?.value ?? "").toString().trim();
        const type = readClubCardTypeValue(clubCardTypeInput);
        return Boolean(card) && type !== null;
    }

    function athletePayloadHasClubCard(data) {
        const card = (data?.clubCardNumber ?? "").toString().trim();
        if (!card) return false;
        const type = readClubCardTypeValue({ value: clubCardTypeToSelectValue(data?.clubCardType) });
        return type !== null;
    }

    function promptClubCardRequired(detailMessage) {
        alert(detailMessage || "Kart təqdim edilməyib");
        try {
            const row = document.getElementById("instantLaneRow");
            if (row instanceof HTMLElement) row.scrollIntoView({ behavior: "smooth", block: "center" });
            if (clubCardTypeInput instanceof HTMLSelectElement) clubCardTypeInput.focus();
            else if (clubCardNumberInput instanceof HTMLInputElement) clubCardNumberInput.focus();
        } catch { /* ignore */ }
    }

    async function fetchAthleteClubCardStatus(athleteId) {
        if (!athleteId) return { hasCard: false, category: null };
        try {
            const res = await apiFetch(`/athletes/${encodeURIComponent(athleteId)}`, { timeoutMs: 20000 });
            if (!res.ok) return { hasCard: false, category: null };
            const data = await res.json();
            return {
                hasCard: athletePayloadHasClubCard(data),
                clubCardNumber: data?.clubCardNumber ?? "",
                clubCardType: data?.clubCardType,
                category: data?.category ?? null,
                categoryLabel: formatAthleteCategoryLabel(data?.category, null)
            };
        } catch {
            return { hasCard: false, category: null };
        }
    }

    async function persistReceptionClubCardToAthlete(athleteId) {
        if (!athleteId || !receptionHasClubCardAssigned()) return false;
        try {
            const res = await apiFetch(`/athletes/${encodeURIComponent(athleteId)}`, { timeoutMs: 20000 });
            if (!res.ok) return false;
            const data = await res.json();
            const put = await apiFetch(`/athletes/${encodeURIComponent(athleteId)}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    firstName: data?.firstName ?? "",
                    lastName: data?.lastName ?? "",
                    phoneNumber: data?.phoneNumber ?? "",
                    email: data?.email ?? "",
                    idCardNumber: data?.idCardNumber ?? "",
                    clubCardNumber: (clubCardNumberInput?.value ?? "").toString().trim(),
                    clubCardType: readClubCardTypeValue(clubCardTypeInput),
                    category: Number(data?.category ?? 0),
                    isSubscriber: Boolean(data?.isSubscriber),
                    membershipType: Number(data?.membershipType ?? 0),
                    isVip: Boolean(data?.isVip)
                })
            });
            return put.ok;
        } catch {
            return false;
        }
    }

    async function ensureClubCardBeforeLaneWrite(athleteId) {
        if (receptionHasClubCardAssigned()) {
            const id = athleteId || receptionMatchedAthleteId;
            if (id) {
                await persistReceptionClubCardToAthlete(id);
            }
            return true;
        }

        const id = athleteId || receptionMatchedAthleteId;
        if (id) {
            const status = await fetchAthleteClubCardStatus(id);
            if (status.hasCard) {
                if (clubCardNumberInput instanceof HTMLInputElement) {
                    clubCardNumberInput.value = status.clubCardNumber || "";
                }
                if (clubCardTypeInput instanceof HTMLSelectElement) {
                    clubCardTypeInput.value = clubCardTypeToSelectValue(status.clubCardType);
                }
                try { refreshSelectedCustomerCard(); } catch { }
                return true;
            }
        }

        promptClubCardRequired();
        return false;
    }

    function memberHasClubCard(m) {
        return Boolean(
            m?.clubCardNumber
            && m.clubCardType !== null
            && m.clubCardType !== undefined
            && m.clubCardType !== ""
        );
    }

    // Qrup üçün ən azı bir üzvdə kart kifayətdir.
    async function ensureGroupMembersHaveClubCards() {
        for (const m of groupMembers) {
            if (memberHasClubCard(m)) continue;
            if (!m.athleteId) continue;
            const status = await fetchAthleteClubCardStatus(m.athleteId);
            if (status.hasCard) {
                m.clubCardNumber = status.clubCardNumber;
                m.clubCardType = status.clubCardType;
            }
        }

        if (groupMembers.some(memberHasClubCard)) return true;

        promptClubCardRequired("Kart təqdim edilməyib");
        return false;
    }

    function hasRequiredCustomerContactFields() {
        const first = firstNameInput?.value?.trim() ?? "";
        const last = lastNameInput?.value?.trim() ?? "";
        const phone = phoneNumberInput?.value?.trim() ?? "";
        const idCard = idCardNumberInput?.value?.trim() ?? "";
        return Boolean(first && last && phone && idCard);
    }

    function syncGroupBookingUi() {
        const isSubscription = (registrationModeInput?.value ?? "") === "subscription";
        const groupAllowed = !isSubscription;

        if (groupModeRow instanceof HTMLElement) {
            groupModeRow.style.display = groupAllowed ? "" : "none";
        }
        if (!groupAllowed && groupModeToggle instanceof HTMLInputElement) {
            groupModeToggle.checked = false;
        }

        const groupOn = groupAllowed && groupModeToggle instanceof HTMLInputElement && groupModeToggle.checked;
        if (groupBookingPanel instanceof HTMLElement) {
            groupBookingPanel.style.display = groupOn ? "block" : "none";
        }
        renderGroupMembersList();
        syncGroupAddButtonUi();
        refreshSelectedCustomerCard();

        const btn = document.getElementById("scheduleBtn");
        if (btn instanceof HTMLButtonElement && !isSubscription) {
            updateScheduleButtonForGroup();
        }
    }

    function renderGroupMembersList() {
        if (!(groupMembersList instanceof HTMLElement)) return;
        groupMembersList.innerHTML = "";
        for (let i = 0; i < groupMembers.length; i++) {
            const m = groupMembers[i];
            const li = document.createElement("li");
            li.className = "group-member-item";
            const cardMeta = memberHasClubCard(m)
                ? ` · Kart: ${formatClubCardDisplay(m.clubCardType, m.clubCardNumber)}`
                : "";
            li.innerHTML = `
                <div>
                    <div class="group-member-item__name">${escapeHtml2(m.fullName || "—")}</div>
                    <div class="group-member-item__meta">${escapeHtml2((m.phone || "") + cardMeta)}</div>
                </div>
                <button type="button" class="btn btn-warning btn-sm" data-remove-group-member="${i}" title="Qrup siyahısından çıxart">Çıxart</button>`;
            groupMembersList.appendChild(li);
        }
        if (groupMembersEmpty instanceof HTMLElement) {
            groupMembersEmpty.style.display = groupMembers.length ? "none" : "block";
        }
        updateScheduleButtonForGroup();
    }

    function countGroupParticipantsForBooking() {
        return collectGroupNamesForBooking().length;
    }

    function getScheduleButtonBaseLabel() {
        const isSubscription = (registrationModeInput?.value ?? "") === "subscription";
        const vipActive = isActiveVipReception();
        const gymMode = isGymBookingMode();
        const groupOn = groupModeToggle instanceof HTMLInputElement && groupModeToggle.checked;
        if (gymMode) return "Trenajora yaz";
        if (isSubscription && !vipActive) return "Abunə qeyd et";
        if (groupOn && countGroupParticipantsForBooking() >= 2) return "Qrupu zolağa yaz";
        return "Zolağa yaz";
    }

    function getScheduleButtonPaymentLabel() {
        const base = getScheduleButtonBaseLabel();
        if (base === "Trenajora yaz") return "Ödəniş et və Trenajora yaz";
        if (base === "Abunə qeyd et") return "Ödəniş et və abunə qeyd et";
        if (base === "Qrupu zolağa yaz") return "Ödəniş et və qrupu zolağa yaz";
        return "Ödəniş et və zolağa yaz";
    }

    function shouldShowSchedulePaymentLabel() {
        const pkg = getSelectedBookingPackage();
        if (!isBillableBookingPackage(pkg)) return false;
        if (isOneTimeBookingPackage(pkg)
            && bookingComplimentaryInput instanceof HTMLInputElement
            && bookingComplimentaryInput.checked) {
            return false;
        }
        return (parseCashPaidInput() + parseCardPaidInput()) > 0.0001;
    }

    function syncScheduleButtonLabel() {
        const btn = document.getElementById("scheduleBtn");
        if (!(btn instanceof HTMLButtonElement)) return;
        if (btn.disabled && btn.textContent === "Gözləyin...") return;
        btn.textContent = shouldShowSchedulePaymentLabel()
            ? getScheduleButtonPaymentLabel()
            : getScheduleButtonBaseLabel();
    }

    function updateScheduleButtonForGroup() {
        syncScheduleButtonLabel();
    }

    function removeGroupMemberAt(index) {
        if (!Number.isInteger(index) || index < 0 || index >= groupMembers.length) return;
        const removed = groupMembers[index];
        groupMembers.splice(index, 1);
        renderGroupMembersList();
        syncGroupAddButtonUi();
        if (removed?.fullName) {
            setLookupHint(`${removed.fullName} qrup siyahısından çıxarıldı.`);
        }
    }

    function hasSelectedCustomerInForm() {
        return hasRequiredCustomerContactFields();
    }

    function isSameGroupMember(a, b) {
        if (!a || !b) return false;
        if (a.athleteId && b.athleteId && String(a.athleteId) === String(b.athleteId)) return true;
        const phoneA = normalizeDigits(a.phone);
        const phoneB = normalizeDigits(b.phone);
        return Boolean(phoneA && phoneB && phoneA === phoneB);
    }

    function buildGroupMemberProbeFromForm() {
        const first = (firstNameInput?.value ?? "").trim();
        const last = (lastNameInput?.value ?? "").trim();
        const phone = (phoneNumberInput?.value ?? "").trim();
        return {
            athleteId: receptionMatchedAthleteId,
            fullName: `${first} ${last}`.trim(),
            phone
        };
    }

    function hasGroupAddCandidate() {
        const probe = buildGroupMemberProbeFromForm();
        if (receptionMatchedAthleteId && probe.fullName && probe.phone) {
            return true;
        }
        return hasRequiredCustomerContactFields();
    }

    function isCurrentFormCustomerInGroup() {
        const probe = buildGroupMemberProbeFromForm();
        if (!probe.fullName && !probe.phone && !probe.athleteId) {
            return false;
        }
        return groupMembers.some(x => isSameGroupMember(x, probe));
    }

    function syncGroupAddButtonUi() {
        const groupOn = groupModeToggle instanceof HTMLInputElement && groupModeToggle.checked;
        if (groupAddRow instanceof HTMLElement) {
            groupAddRow.style.display = groupOn ? "" : "none";
        }
        const canAdd = groupOn && hasGroupAddCandidate() && !isCurrentFormCustomerInGroup();
        if (addToGroupBtn instanceof HTMLButtonElement) {
            addToGroupBtn.style.display = canAdd ? "" : "none";
            addToGroupBtn.disabled = !canAdd;
        }
    }

    function clearReceptionCustomerSelection() {
        if (firstNameInput instanceof HTMLInputElement) firstNameInput.value = "";
        if (lastNameInput instanceof HTMLInputElement) lastNameInput.value = "";
        if (phoneNumberInput instanceof HTMLInputElement) phoneNumberInput.value = "";
        if (emailInput instanceof HTMLInputElement) emailInput.value = "";
        if (idCardNumberInput instanceof HTMLInputElement) idCardNumberInput.value = "";
        if (clubCardNumberInput instanceof HTMLInputElement) clubCardNumberInput.value = "";
        if (clubCardTypeInput instanceof HTMLSelectElement) clubCardTypeInput.value = "";
        if (categoryInput instanceof HTMLSelectElement) categoryInput.value = "";
        if (membershipTypeInput instanceof HTMLSelectElement) membershipTypeInput.value = "";
        if (isVipInput instanceof HTMLInputElement) isVipInput.checked = false;
        if (customerSearchInput instanceof HTMLInputElement) customerSearchInput.value = "";
        receptionMatchedAthleteId = null;
        receptionMatchedSnapshot = null;
        _receptionMonthlyActive = null;
        hideAthleteSuggest();
        syncUpdateAthleteButton();
        refreshSelectedCustomerCard();
        syncGroupAddButtonUi();
        try { syncVipReceptionBookingUi(); } catch { /* ignore */ }
    }

    function pushGroupMember(member, { clearForm = false } = {}) {
        if (groupMembers.some(x => isSameGroupMember(x, member))) {
            return false;
        }
        groupMembers.push(member);
        renderGroupMembersList();
        if (clearForm) {
            clearReceptionCustomerSelection();
        } else {
            syncGroupAddButtonUi();
        }
        return true;
    }

    async function addCurrentCustomerToGroup() {
        if (!(groupModeToggle instanceof HTMLInputElement) || !groupModeToggle.checked) {
            alert("Qrup rejimini aktiv edin.");
            return;
        }
        if (!hasGroupAddCandidate()) {
            alert("Müştəri axtarışından seçin və ya tam məlumat daxil edin.");
            return;
        }
        if (isCurrentFormCustomerInGroup()) {
            alert("Bu müştəri artıq qrupdadır.");
            return;
        }

        const ensured = await ensureAthleteFromReceptionFields();
        if (!ensured.ok) {
            alert(ensured.error || "Müştəri əlavə edilə bilmədi.");
            return;
        }

        const member = {
            athleteId: ensured.athleteId,
            fullName: ensured.fullName,
            phone: ensured.phone,
            clubCardNumber: clubCardNumberInput?.value?.trim() || "",
            clubCardType: readClubCardTypeValue(clubCardTypeInput)
        };
        // Kart məcburi deyil — zolağa yazanda qrupda ən azı bir kart yoxlanılır.
        if (!pushGroupMember(member, { clearForm: true })) {
            alert("Bu müştəri artıq qrupdadır.");
            return;
        }
        const cardNote = memberHasClubCard(member) ? " (kartlı)" : "";
        setLookupHint(`${member.fullName} qrupa əlavə edildi${cardNote}. Növbəti müştərini axtarın.`);
        try { customerSearchInput?.focus(); } catch { }
    }

    function collectGroupNamesForBooking() {
        return groupMembers
            .map(m => String(m.fullName || "").trim())
            .filter(Boolean);
    }

    function clearGroupMembers() {
        groupMembers = [];
        renderGroupMembersList();
        syncGroupAddButtonUi();
        if (groupInfo instanceof HTMLElement) {
            groupInfo.style.display = "none";
            groupInfo.textContent = "";
        }
    }

    async function ensureAthleteFromReceptionFields() {
        if (receptionMatchedAthleteId) {
            const firstName = firstNameInput?.value?.trim() ?? "";
            const lastName = lastNameInput?.value?.trim() ?? "";
            const phoneNumber = phoneNumberInput?.value?.trim() ?? "";
            const fullName = `${firstName} ${lastName}`.trim();
            if (fullName && phoneNumber) {
                return {
                    ok: true,
                    athleteId: receptionMatchedAthleteId,
                    fullName,
                    phone: phoneNumber
                };
            }
        }
        if (!hasRequiredCustomerContactFields()) {
            return { ok: false, error: customerRequiredFieldsMessage };
        }

        const firstName = firstNameInput?.value?.trim() ?? "";
        const lastName = lastNameInput?.value?.trim() ?? "";
        const phoneNumber = phoneNumberInput?.value?.trim() ?? "";
        const membershipTypeRaw = membershipTypeInput?.value ?? "";
        const categoryRaw = categoryInput?.value ?? "";

        if (receptionMatchedAthleteId) {
            return {
                ok: true,
                athleteId: receptionMatchedAthleteId,
                fullName: `${firstName} ${lastName}`.trim(),
                phone: phoneNumber
            };
        }

        try {
            const phoneQ = normalizeDigits(phoneNumber);
            const emailQ = normalizeText(emailInput?.value);
            const idQ = normalizeText(idCardNumberInput?.value);
            const qs = new URLSearchParams();
            if (phoneQ) qs.set("phone", phoneQ);
            if (emailQ) qs.set("email", emailQ);
            if (idQ) qs.set("idCardNumber", idQ);
            const lookupRes = await apiFetch(`/athletes/lookup?${qs.toString()}`, { timeoutMs: 30000 });
            if (lookupRes.ok) {
                const found = await lookupRes.json();
                if (found?.id) {
                    receptionMatchedAthleteId = found.id;
                    syncUpdateAthleteButton();
                    return {
                        ok: true,
                        athleteId: found.id,
                        fullName: found.fullName || `${firstName} ${lastName}`.trim(),
                        phone: found.phoneNumber || phoneNumber
                    };
                }
            }
        } catch { /* ignore */ }

        const wantsCreate = window.confirm(
            "Bu müştəri sistemdə tapılmadı.\n\nQeydiyyata alınıb qrupa əlavə edilsin?"
        );
        if (!wantsCreate) {
            return { ok: false, error: "Müştəri qeydiyyatdan keçməyib." };
        }
        if (!categoryRaw) {
            openCustomerModal(false);
            return { ok: false, error: "Kateqoriya «Müştəri əlavə et» pəncərəsindən seçin." };
        }
        const resolvedMembership = membershipTypeRaw || membershipValueFromPackage(getSelectedBookingPackage()) || "0";
        if (membershipTypeInput instanceof HTMLSelectElement) membershipTypeInput.value = resolvedMembership;
        if (!validateClubCardFields(clubCardNumberInput?.value, readClubCardTypeValue(clubCardTypeInput))) {
            return { ok: false, error: "Kart növü seçin." };
        }

        const athleteResponse = await apiFetch("/athletes", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            timeoutMs: 60000,
            body: JSON.stringify({
                firstName,
                lastName,
                phoneNumber,
                email: emailInput?.value?.trim() || "",
                idCardNumber: idCardNumberInput?.value?.trim() || "",
                clubCardNumber: clubCardNumberInput?.value?.trim() || "",
                clubCardType: readClubCardTypeValue(clubCardTypeInput),
                category: Number(categoryRaw),
                isSubscriber: false,
                membershipType: Number(resolvedMembership),
                isVip: Boolean(isVipInput?.checked)
            })
        });

        if (!athleteResponse.ok) {
            if (athleteResponse.status === 409) {
                let payload = null;
                try { payload = await athleteResponse.json(); } catch { }
                const existingId = payload?.existingId ?? null;
                if (existingId) {
                    receptionMatchedAthleteId = existingId;
                    syncUpdateAthleteButton();
                    return {
                        ok: true,
                        athleteId: existingId,
                        fullName: `${firstName} ${lastName}`.trim(),
                        phone: phoneNumber
                    };
                }
            }
            const message = await readErrorMessage(athleteResponse);
            return { ok: false, error: message || "Müştəri qeydə alınmadı." };
        }

        const athleteData = await athleteResponse.json();
        receptionMatchedAthleteId = athleteData?.id ?? null;
        syncUpdateAthleteButton();
        allAthletesCache = [];
        athletesCacheLoadedAtMs = 0;
        return {
            ok: true,
            athleteId: receptionMatchedAthleteId,
            fullName: `${firstName} ${lastName}`.trim(),
            phone: phoneNumber
        };
    }

    function syncRegistrationModeUi() {
        const mode = registrationModeInput?.value ?? "";
        const isSubscription = mode === "subscription";
        const vipActive = isActiveVipReception();
        const vipPkgSelected = isVipBillingPackage(getSelectedBookingPackage());
        const gymMode = isGymBookingMode();
        const hideInstantControls = isSubscription && !vipActive;

        if (groupInfo instanceof HTMLElement) groupInfo.style.display = "none";

        if (sessionStartRow instanceof HTMLElement) {
            sessionStartRow.style.display = hideInstantControls ? "none" : "";
        }

        if (instantLaneRow instanceof HTMLElement) {
            instantLaneRow.style.display = "";
        }

        if (laneNumberInput instanceof HTMLSelectElement) {
            laneNumberInput.style.display = (hideInstantControls || isGymPackageSelected() || (isSubscription && vipPkgSelected && !vipActive)) ? "none" : "";
        }

        syncGroupBookingUi();
        const btn = document.getElementById("scheduleBtn");
        if (btn instanceof HTMLButtonElement) {
            btn.style.display = "";
            btn.disabled = false;
            syncScheduleButtonLabel();
        }
        if (sessionInfo instanceof HTMLElement && gymMode && !vipActive) {
            sessionInfo.textContent = "";
        }
        syncVipReceptionBookingUi();
    }

    function applyReceptionWalkInFromAthlete(athlete) {
        _receptionWalkIn = null;
        if (!athlete) {
            syncReceptionWalkInUi();
            return;
        }
        if (athlete.hasActiveWalkIn) {
            const dur = Number(athlete.walkInSessionDurationMinutes ?? 0);
            const openEnded = dur === 0;
            // VIP yalnız müştəri VIP bayrağı + müddətsiz abunə; əks haldır Limitsiz (vaxtlı və ya müddətsiz).
            const isVip = openEnded && Boolean(athlete.isVip);
            const isUnlimited = !isVip;
            _receptionWalkIn = {
                isActive: true,
                isVip: isVip,
                isUnlimited: isUnlimited,
                expiresLocal: athlete.walkInExpiresLocal ?? "",
                sessionDurationMinutes: dur
            };
            _receptionMonthlyActive = null;
            if (durationMinutesInput instanceof HTMLInputElement) {
                durationMinutesInput.value = String(dur);
            }
        }
        syncReceptionWalkInUi();
    }

    async function refreshReceptionMonthlyStatus(athleteId) {
        _receptionMonthlyActive = null;
        if (!athleteId) {
            syncVipReceptionBookingUi();
            return;
        }
        // VIP / Limitsiz walk-in artıq paket əvəzini verir.
        if (_receptionWalkIn?.isActive) {
            syncVipReceptionBookingUi();
            return;
        }
        try {
            const res = await apiFetch(`/subscriptions/schedules?athleteId=${encodeURIComponent(athleteId)}`, { timeoutMs: 30000 });
            if (!res.ok) {
                syncVipReceptionBookingUi();
                return;
            }
            const schedules = await res.json().catch(() => []);
            const active = (Array.isArray(schedules) ? schedules : [])
                .filter(s => s?.isEnabled !== false && !s?.isFullPackage);
            if (!active.length) {
                syncVipReceptionBookingUi();
                return;
            }

            let visitStats = null;
            let futureOccurrences = [];
            try {
                const infoRes = await apiFetch(`/info/athlete?id=${encodeURIComponent(athleteId)}`, { timeoutMs: 30000 });
                if (infoRes.ok) {
                    const info = await infoRes.json().catch(() => ({}));
                    visitStats = info?.visitStats ?? null;
                    const todayIso = getTodayLocalIso();
                    futureOccurrences = (Array.isArray(info?.occurrencesFlat) ? info.occurrencesFlat : [])
                        .filter(o => String(o?.dateLocal ?? "") > todayIso)
                        .sort((a, b) => String(a.dateLocal).localeCompare(String(b.dateLocal)));
                }
            } catch { /* ignore */ }

            // Gediş limiti bitibsə — paket bitmiş sayılır (yenidən paket/birdəfəlik).
            if (visitStats?.packageEnded || (visitStats?.remaining != null && Number(visitStats.remaining) <= 0)) {
                _receptionMonthlyActive = null;
                syncVipReceptionBookingUi();
                return;
            }

            const todayDow = new Date().getDay();
            const prefer = active.find(s => Number(s.dayOfWeek) === todayDow)
                || active[0];
            const dur = Number(prefer?.durationMinutes || 0);
            const laneNo = Number(prefer?.laneNumber || 0);
            const membershipGym = Number(membershipTypeInput?.value ?? -1) === 1;
            const isGym = membershipGym
                || laneNo === GYM_LANE_NUMBER
                || String(prefer?.preferredLaneTypeLabel || "").toLowerCase().includes("trenajor")
                || String(prefer?.laneLabel || "").toLowerCase().includes("trenajor");
            const dayOfWeeks = [...new Set(active.map(s => Number(s.dayOfWeek)).filter(d => Number.isInteger(d)))].sort((a, b) => a - b);
            const dayLabels = formatWeeklyDayLabels(dayOfWeeks.join(","));
            _receptionMonthlyActive = {
                durationMinutes: dur > 0 ? dur : 60,
                isGym: Boolean(isGym),
                dayOfWeeks,
                dayLabels,
                periodFrom: visitStats?.periodFromLocal || active[0]?.activeFromDateLocal || "",
                periodTo: visitStats?.periodToLocal || active[0]?.activeToDateLocal || "",
                visitLimit: visitStats?.visitLimit ?? null,
                visited: visitStats?.visited ?? null,
                remaining: visitStats?.remaining ?? null,
                periodExpired: Boolean(visitStats?.periodExpired),
                hasCarryover: Boolean(visitStats?.hasCarryover),
                futureOccurrences,
                schedules: active
            };
            if (durationMinutesInput instanceof HTMLInputElement) {
                durationMinutesInput.value = String(_receptionMonthlyActive.durationMinutes);
            }
        } catch { /* ignore */ }
        syncVipReceptionBookingUi();
    }

    function weekdayLabelAz(dow) {
        const labels = { 0: "Bazar", 1: "B.e", 2: "Ç.a", 3: "Ç", 4: "C.a", 5: "C", 6: "Ş" };
        return labels[Number(dow)] ?? String(dow);
    }

    async function ensureMonthlyReceptionWriteAllowed() {
        const monthly = _receptionMonthlyActive;
        if (!monthly) return { ok: true };

        const remaining = monthly.remaining;
        if (remaining != null && Number(remaining) <= 0) {
            _receptionMonthlyActive = null;
            syncVipReceptionBookingUi();
            return {
                ok: false,
                renew: true,
                message: "Bu müştərinin paketi bitib (gediş limiti dolub).\n\nPaketi yeniləmək, birdəfəlik almaq və ya yeni paket seçmək üçün paket seçib ödəniş edin."
            };
        }

        // Qalıq gediş + dövr bitibsə — istənilən gün yaza bilərik (gün əvəzi lazım deyil).
        if (monthly.hasCarryover || monthly.periodExpired) {
            return { ok: true };
        }

        const todayDow = new Date().getDay();
        const allowed = Array.isArray(monthly.dayOfWeeks) ? monthly.dayOfWeeks.map(Number) : [];
        if (!allowed.length || allowed.includes(todayDow)) {
            return { ok: true };
        }

        const daysText = monthly.dayLabels || allowed.map(weekdayLabelAz).join(", ");
        const wantsSwap = window.confirm(
            `Bu müştərinin gəlmə günləri ${daysText}-dür.\n\n` +
            "Gələcək planlardan birini bu günlə əvəz etmək istəyirsiniz?"
        );
        if (!wantsSwap) {
            return { ok: false, message: null };
        }

        const future = (Array.isArray(monthly.futureOccurrences) ? monthly.futureOccurrences : [])
            .filter(o => o?.scheduleId && o?.dateLocal);
        if (!future.length) {
            return { ok: false, message: "Əvəz ediləcək gələcək plan günü yoxdur." };
        }

        const lines = future.slice(0, 12).map((o, i) =>
            `${i + 1}) ${formatDateOnly(o.dateLocal)} ${o.dayLabel || ""} ${o.startTime || ""}`.trim()
        ).join("\n");
        const pickRaw = window.prompt(`Hansı planı bu günlə əvəz edək? Nömrə yazın:\n${lines}`, "1");
        if (pickRaw == null) return { ok: false, message: null };
        const pick = Number(String(pickRaw).trim());
        if (!Number.isInteger(pick) || pick < 1 || pick > Math.min(12, future.length)) {
            return { ok: false, message: "Düzgün nömrə seçin." };
        }

        const source = future[pick - 1];
        const todayIso = getTodayLocalIso();
        const startTime = String(source.startTime || getBookingStartTimeLocal()).slice(0, 5);
        const duration = Number(source.durationMinutes || monthly.durationMinutes || 60);
        const res = await apiFetch(
            `/subscriptions/schedules/${encodeURIComponent(source.scheduleId)}/reschedule-occurrence`,
            {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    sourceDateLocal: source.dateLocal,
                    targetDateLocal: todayIso,
                    startTimeLocal: startTime,
                    laneNumber: 0,
                    durationMinutes: duration > 0 ? duration : 60
                })
            }
        );
        if (!res.ok) {
            return { ok: false, message: await readErrorMessage(res) || "Gün əvəzlənmədi." };
        }
        return { ok: true };
    }

    async function refreshReceptionWalkInStatus(athleteId) {
        if (!athleteId) {
            applyReceptionWalkInFromAthlete(null);
            _receptionMonthlyActive = null;
            syncVipReceptionBookingUi();
            return;
        }
        try {
            const phoneQ = normalizeDigits(phoneNumberInput?.value);
            const emailQ = normalizeText(emailInput?.value);
            const idQ = normalizeText(idCardNumberInput?.value);
            const qs = new URLSearchParams();
            if (phoneQ) qs.set("phone", phoneQ);
            if (emailQ) qs.set("email", emailQ);
            if (idQ) qs.set("idCardNumber", idQ);
            if (qs.toString()) {
                const res = await apiFetch(`/athletes/lookup?${qs.toString()}`, { timeoutMs: 15000 });
                if (res.ok) {
                    const data = await res.json();
                    if (String(data?.id) === String(athleteId)) {
                        applyReceptionWalkInFromAthlete(data);
                        if (!_receptionWalkIn?.isActive) {
                            await refreshReceptionMonthlyStatus(athleteId);
                        }
                        return;
                    }
                }
            }
        } catch { /* ignore */ }

        const info = await getActiveWalkInSubscriptionInfo(athleteId);
        if (info) {
            _receptionWalkIn = {
                isActive: true,
                isVip: info.isVip,
                isUnlimited: info.isUnlimited || false,
                expiresLocal: info.expiresLocal,
                sessionDurationMinutes: info.durationMinutes
            };
            if (durationMinutesInput instanceof HTMLInputElement) {
                durationMinutesInput.value = info.isUnlimited ? String(info.durationMinutes) : "0";
            }
            _receptionMonthlyActive = null;
            syncReceptionWalkInUi();
            return;
        }

        _receptionWalkIn = null;
        syncReceptionWalkInUi();
        await refreshReceptionMonthlyStatus(athleteId);
    }

