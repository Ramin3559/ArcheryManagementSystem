        return pkg.billingType === "Vip" || pkg.scope === "Vip";
    }

    function isUnlimitedBillingPackage(pkg) {
        if (!pkg) return false;
        if (isVipBillingPackage(pkg)) return false;
        if (pkg.billingType === "Unlimited") return true;
        return pkg.schedulingMode === "WalkInFlexible";
    }

    function isGymPackage(pkg) {
        return pkg?.scope === "Gym" || pkg?.billingType === "Gym";
    }

    function isFullAccessPackage(pkg) {
        if (!pkg) return false;
        if (pkg.scope === "Full" || pkg.scope === "Vip") return true;
        if (isVipBillingPackage(pkg)) return true;
        // Aylıq/illik/limitsiz oxatma — Trenajor hüququ avtomatik.
        if (!isGymPackage(pkg) && (pkg.billingType === "Monthly" || pkg.billingType === "Yearly" || pkg.billingType === "Unlimited")) {
            return true;
        }
        return Boolean(pkg.unlimitedGym);
    }

    function membershipValueFromPackage(pkg) {
        if (!pkg) return "0";
        if (isGymPackage(pkg)) return "1";
        if (isFullAccessPackage(pkg)) return "2";
        return "0";
    }

    function membershipLabelFromValue(val) {
        const v = String(val ?? "");
        if (v === "1") return "Yalnız Trenajor";
        if (v === "2") return "Hər ikisi (oxatma + Trenajor)";
        if (v === "0") return "Yalnız oxatma";
        return "—";
    }

    function applyMembershipFromPackage(pkg) {
        const val = membershipValueFromPackage(pkg);
        if (membershipTypeInput instanceof HTMLSelectElement) {
            membershipTypeInput.value = val;
        }
        const access = accessFromMembershipType(val);
        if (includesGymInput instanceof HTMLInputElement) includesGymInput.checked = access.gym;
        if (includesLaneInput instanceof HTMLInputElement) includesLaneInput.checked = access.shooting;
        if (includesShootingInput instanceof HTMLInputElement) includesShootingInput.checked = access.shooting;
        if (membershipTypeHint instanceof HTMLElement) {
            if (pkg) {
                membershipTypeHint.textContent = membershipLabelFromValue(val);
                membershipTypeHint.style.display = "";
            } else {
                membershipTypeHint.textContent = "";
                membershipTypeHint.style.display = "none";
            }
        }
    }

    function isGymLaneNumber(laneNumber) {
        return Number(laneNumber) === GYM_LANE_NUMBER;
    }

    function isGymLaneSelected() {
        return isGymLaneNumber(laneNumberInput?.value ?? 0);
    }

    function isGymPackageSelected() {
        const pkg = getSelectedBookingPackage();
        return Boolean(pkg && isGymPackage(pkg));
    }

    function isGymBookingMode() {
        // Trenajor: seçilmiş paket və ya aktiv aylıq Trenajor abunəsi.
        if (isGymPackageSelected()) return true;
        if (_receptionMonthlyActive?.isGym) return true;
        return false;
    }

    function isGymFixedWeeklyPackage(pkg) {
        return Boolean(pkg && isGymPackage(pkg)
            && (pkg.schedulingMode === "FixedWeekly" || Number(pkg.weeklyDaysCount || 0) >= 1));
    }

    function ensureGymLaneForPackage() {
        if (!(laneNumberInput instanceof HTMLSelectElement)) return;
        const pkg = getSelectedBookingPackage();
        if (pkg && isGymPackage(pkg)) {
            // Gizli Trenajor zolağı — UI-də option olmasa belə value saxlanır.
            let opt = Array.from(laneNumberInput.options).find(o => Number(o.value) === GYM_LANE_NUMBER);
            if (!opt) {
                opt = document.createElement("option");
                opt.value = String(GYM_LANE_NUMBER);
                opt.textContent = "Trenajor";
                opt.hidden = true;
                laneNumberInput.appendChild(opt);
            }
            laneNumberInput.value = String(GYM_LANE_NUMBER);
            lastValidLaneNumber = String(GYM_LANE_NUMBER);
            return;
        }
        if (pkg && !isGymPackage(pkg) && isGymLaneNumber(laneNumberInput.value)) {
            const fallback = lastValidLaneNumber && !isGymLaneNumber(lastValidLaneNumber)
                ? lastValidLaneNumber
                : "1";
            laneNumberInput.value = fallback;
            lastValidLaneNumber = fallback;
        }
    }

    function filterPackagesForBooking(packages) {
        // VIP paket növü artıq satılmır (Limitsiz var); köhnə VIP qeydlər siyahıda gizlədilir.
        return (Array.isArray(packages) ? packages : [])
            .filter(p => String(p?.billingType ?? "") !== "Vip");
    }

    function populateBookingPackageSelect() {
        if (!(bookingPackageSelect instanceof HTMLSelectElement)) return;
        const prev = bookingPackageSelect.value;
        const filtered = filterPackagesForBooking(bookingPackagesCache)
            .slice()
            .sort((a, b) => Number(a?.price ?? 0) - Number(b?.price ?? 0));
        bookingPackageSelect.innerHTML = '<option value="" selected disabled>Paket seçin</option>';
        for (const p of filtered) {
            const opt = document.createElement("option");
            opt.value = p.id;
            const price = p.price != null && p.price !== "" ? ` · ${p.price} ₼` : "";
            opt.textContent = `${p.name}${price}`;
            bookingPackageSelect.appendChild(opt);
        }
        if (prev && filtered.some(x => String(x.id) === String(prev))) {
            bookingPackageSelect.value = prev;
        } else {
            bookingPackageSelect.value = "";
        }
    }

    function isWalkInPackage(pkg) {
        if (!pkg) return false;
        if (isVipBillingPackage(pkg) || isUnlimitedBillingPackage(pkg)) return true;
        // Birdefəlik müddətsiz — birbaşa zolağa yazılır (abunə walk-in deyil)
        if (String(pkg.billingType) === "OneTime") return false;
        // Digər növlər müddətsizdirsə — həftəlik plan yox, gələndə yazılır
        return Number(pkg.sessionDurationMinutes) === 0;
    }

    function formatDateDisplayAz(iso) {
        const s = String(iso || "").trim();
        if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return "";
        const [y, m, d] = s.split("-");
        return `${d}.${m}.${y}`;
    }

    function getBookingSubEndDateIso() {
        if (!(bookingSubEndDate instanceof HTMLInputElement)) return "";
        const fromData = String(bookingSubEndDate.dataset.iso || "").trim();
        if (/^\d{4}-\d{2}-\d{2}$/.test(fromData)) return fromData;
        const v = String(bookingSubEndDate.value || "").trim();
        if (/^\d{4}-\d{2}-\d{2}$/.test(v)) return v;
        const m = /^(\d{2})\.(\d{2})\.(\d{4})$/.exec(v);
        if (m) return `${m[3]}-${m[2]}-${m[1]}`;
        return "";
    }

    function calcSubscriptionEndDateLocal(startIso, pkg) {
        if (!startIso) return "";
        const n = Math.min(12, Math.max(1, Number(bookingSubMonths?.value ?? 1) || 1));
        const start = new Date(`${startIso}T12:00:00`);
        if (String(pkg?.billingType) === "Yearly") {
            start.setFullYear(start.getFullYear() + n);
        } else {
            // Aylıq, Limitsiz (və köhnə VIP) — ay əlavə et.
            start.setMonth(start.getMonth() + n);
        }
        return start.toISOString().slice(0, 10);
    }

    function syncSubscriptionEndDateFromPeriod(pkg) {
        if (!(bookingSubEndDate instanceof HTMLInputElement)) return;
        const startIso = bookingSubStartDate instanceof HTMLInputElement ? bookingSubStartDate.value : "";
        const endIso = calcSubscriptionEndDateLocal(startIso, pkg || getSelectedBookingPackage());
        bookingSubEndDate.dataset.iso = endIso || "";
        bookingSubEndDate.value = endIso ? formatDateDisplayAz(endIso) : "";
    }

    function syncBookingPeriodUnitLabel(pkg) {
        const label = document.getElementById("bookingSubMonthsLabel");
        if (!(label instanceof HTMLElement)) return;
        label.textContent = String(pkg?.billingType) === "Yearly" ? "Neçə İL" : "Neçə AY";
    }

    function formatHhMmFromDigits(digits) {
        const d = String(digits || "").replace(/\D/g, "").slice(0, 4);
        if (d.length <= 2) return d;
        return `${d.slice(0, 2)}:${d.slice(2)}`;
    }

    function normalizeHhMmValue(value) {
        const d = String(value || "").replace(/\D/g, "").slice(0, 4);
        if (!d) return "";
        let hh;
        let mm;
        if (d.length <= 2) {
            hh = Number(d);
            mm = 0;
        } else {
            hh = Number(d.slice(0, 2));
            mm = Number(d.slice(2).padEnd(2, "0"));
        }
        if (!Number.isInteger(hh) || !Number.isInteger(mm) || hh > 23 || mm > 59) return null;
        return `${String(hh).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;
    }

    function attachHhMmTimeMask(input) {
        if (!(input instanceof HTMLInputElement) || input.dataset.hhmmBound === "1") return;
        input.dataset.hhmmBound = "1";
        input.setAttribute("inputmode", "numeric");
        input.setAttribute("autocomplete", "off");
        input.setAttribute("maxlength", "5");
        if (!input.placeholder) input.placeholder = "09:00";
        input.addEventListener("input", () => {
            const digits = String(input.value || "").replace(/\D/g, "").slice(0, 4);
            input.value = formatHhMmFromDigits(digits);
            try {
                const pos = input.value.length;
                input.setSelectionRange(pos, pos);
            } catch { /* ignore */ }
        });
        input.addEventListener("blur", () => {
            const raw = String(input.value || "").trim();
            if (!raw) return;
            const n = normalizeHhMmValue(raw);
            input.value = n || "";
        });
        input.addEventListener("keydown", (e) => {
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            const allow = ["Backspace", "Delete", "Tab", "Enter", "Escape", "ArrowLeft", "ArrowRight", "Home", "End"];
            if (allow.includes(e.key)) return;
            if (/^\d$/.test(e.key)) return;
            if (e.key === ":") {
                e.preventDefault();
                return;
            }
            e.preventDefault();
        });
    }

    function attachHhMmTimeMasks(root) {
        const scope = root instanceof Element || root instanceof Document ? root : document;
        scope.querySelectorAll(".hhmm-time, .booking-sub-day-time, .sub-day-time").forEach(attachHhMmTimeMask);
    }

    function isActiveVipReception() {
        return Boolean(_receptionWalkIn?.isActive && _receptionWalkIn?.isVip);
    }

    function shouldUseOpenEndedSession() {
        // Limitsiz (vaxtlı) aktiv abunə — hər gəlişdə dəqiqə sayılır.
        if (_receptionWalkIn?.isActive && _receptionWalkIn?.isUnlimited && Number(_receptionWalkIn.sessionDurationMinutes || 0) > 0) {
            return false;
        }
        // VIP və ya Limitsiz müddətsiz — stop-a qədər.
        if (_receptionWalkIn?.isActive && Number(_receptionWalkIn.sessionDurationMinutes || 0) === 0) {
            return true;
        }
        if (isActiveVipReception()) return true;
        const pkg = getSelectedBookingPackage();
        if (!pkg) return false;
        // Paketdə sessiya müddəti 0 = müddətsiz.
        return Number(pkg.sessionDurationMinutes) === 0;
    }

    function isActiveMonthlyReception() {
        return Boolean(_receptionMonthlyActive);
    }

    function hasActiveCustomerPackage() {
        return isActiveVipReception()
            || isActiveUnlimitedReception()
            || isActiveMonthlyReception()
            || Boolean(_receptionWalkIn?.isActive);
    }

    function resolveSessionDurationMinutes() {
        if (_receptionWalkIn?.isActive && _receptionWalkIn?.isUnlimited) {
            return Number(_receptionWalkIn.sessionDurationMinutes || durationMinutesInput?.value || 0);
        }
        if (shouldUseOpenEndedSession()) return 0;
        const pkg = getSelectedBookingPackage();
        if (isUnlimitedBillingPackage(pkg)) return Number(pkg.sessionDurationMinutes || durationMinutesInput?.value || 0);
        if (pkg) return Number(durationMinutesInput?.value ?? "0");
        if (isActiveMonthlyReception()) {
            return Number(_receptionMonthlyActive?.durationMinutes || durationMinutesInput?.value || 0);
        }
        return Number(durationMinutesInput?.value ?? "0");
    }

    function syncVipReceptionBookingUi() {
        const vipActive = isActiveVipReception();
        const unlimitedActive = isActiveUnlimitedReception();
        const monthlyActive = isActiveMonthlyReception();
        const packageSkip = vipActive || unlimitedActive || monthlyActive || Boolean(_receptionWalkIn?.isActive);
        if (bookingPackageSelect instanceof HTMLSelectElement) {
            bookingPackageSelect.disabled = packageSkip;
            if (packageSkip) {
                bookingPackageSelect.value = "";
            }
        }
        if (laneBookingHint instanceof HTMLElement) {
            laneBookingHint.textContent = "";
        }
        if (unlimitedActive) {
            const dur = Number(_receptionWalkIn?.sessionDurationMinutes || 0);
            const openEnded = dur === 0;
            if (registrationModeInput instanceof HTMLInputElement) {
                registrationModeInput.value = "instant";
            }
            if (durationMinutesInput instanceof HTMLInputElement) {
                durationMinutesInput.value = String(dur);
            }
            if (subscriptionPeriodRow instanceof HTMLElement) subscriptionPeriodRow.style.display = "none";
            if (bookingSubscriptionScheduleRow instanceof HTMLElement) bookingSubscriptionScheduleRow.style.display = "none";
            if (bookingWalkInHint instanceof HTMLElement) bookingWalkInHint.style.display = "none";
            if (bookingVipHint instanceof HTMLElement) {
                bookingVipHint.style.display = "none";
                bookingVipHint.textContent = "";
            }
            if (packageDurationHint instanceof HTMLElement) {
                packageDurationHint.textContent = "";
                packageDurationHint.style.display = "none";
            }
            if (sessionInfo instanceof HTMLElement) {
                sessionInfo.textContent = openEnded
                    ? "Limitsiz müddətsiz müştəri — zolaq seçib «Zolağa yaz» basın."
                    : `Limitsiz müştəri — zolaq seçib «Zolağa yaz» basın. ${dur} dəq geri sayım başlayacaq.`;
            }
        } else if (vipActive) {
            if (registrationModeInput instanceof HTMLInputElement) {
                registrationModeInput.value = "instant";
            }
            if (durationMinutesInput instanceof HTMLInputElement) {
                durationMinutesInput.value = "0";
            }
            if (subscriptionPeriodRow instanceof HTMLElement) subscriptionPeriodRow.style.display = "none";
            if (bookingSubscriptionScheduleRow instanceof HTMLElement) bookingSubscriptionScheduleRow.style.display = "none";
            if (bookingWalkInHint instanceof HTMLElement) bookingWalkInHint.style.display = "none";
            if (bookingVipHint instanceof HTMLElement) {
                bookingVipHint.style.display = "none";
                bookingVipHint.textContent = "";
            }
            if (packageDurationHint instanceof HTMLElement) {
                packageDurationHint.textContent = "";
                packageDurationHint.style.display = "none";
            }
            if (sessionInfo instanceof HTMLElement) {
                sessionInfo.textContent = "VIP müştəri — zolaq və vaxt seçib «Zolağa yaz» basın.";
            }
        } else if (monthlyActive) {
            const dur = Number(_receptionMonthlyActive?.durationMinutes || 0);
            if (registrationModeInput instanceof HTMLInputElement) {
                registrationModeInput.value = "instant";
            }
            if (durationMinutesInput instanceof HTMLInputElement && dur > 0) {
                durationMinutesInput.value = String(dur);
            }
            if (subscriptionPeriodRow instanceof HTMLElement) subscriptionPeriodRow.style.display = "none";
            if (bookingSubscriptionScheduleRow instanceof HTMLElement) bookingSubscriptionScheduleRow.style.display = "none";
            if (bookingWalkInHint instanceof HTMLElement) bookingWalkInHint.style.display = "none";
            if (bookingVipHint instanceof HTMLElement) {
                bookingVipHint.style.display = "none";
                bookingVipHint.textContent = "";
            }
            if (packageDurationHint instanceof HTMLElement) {
                packageDurationHint.textContent = "";
                packageDurationHint.style.display = "none";
            }
            if (sessionInfo instanceof HTMLElement) {
                sessionInfo.textContent = "";
            }
        } else if (bookingPackageSelect instanceof HTMLSelectElement) {
            bookingPackageSelect.disabled = false;
            if (bookingVipHint instanceof HTMLElement) {
                bookingVipHint.style.display = "none";
                bookingVipHint.textContent = "";
            }
        }
    }

    function syncBookingPackageUi() {
        if (hasActiveCustomerPackage()) {
            syncVipReceptionBookingUi();
            syncRegistrationModeUi();
            return;
        }
        if (_receptionWalkIn?.isActive && bookingPackageSelect instanceof HTMLSelectElement && bookingPackageSelect.value) {
            bookingPackageSelect.value = "";
            if (registrationModeInput instanceof HTMLInputElement) registrationModeInput.value = "";
            showSessionNotice(
                isActiveVipReception()
                    ? "VIP abunə aktivdir — paket seçməyin, zolaq seçib «Zolağa yaz» basın."
                    : "Limitsiz abunə aktivdir — paket seçməyin, zolaq seçib «Zolağa yaz» basın.",
                "ok");
            syncRegistrationModeUi();
            return;
        }
        const pkg = getSelectedBookingPackage();
        ensureGymLaneForPackage();
        applyMembershipFromPackage(pkg);
        const isSubscription = pkg && pkg.billingType !== "OneTime";
        const isWalkIn = isWalkInPackage(pkg);
        const isVip = isVipBillingPackage(pkg);
        const isUnlimited = isUnlimitedBillingPackage(pkg);
        const gymMode = isGymBookingMode();
        // Yalnız Trenajor birdəfəlik / köhnə Gym — həftə planı yox; aylıq Trenajor FixedWeekly — gün seçimi qalır.
        const hideWeeklySchedule = isWalkIn || (pkg && isGymPackage(pkg) && !isGymFixedWeeklyPackage(pkg));
        if (packageDurationHint instanceof HTMLElement) {
            packageDurationHint.textContent = "";
            packageDurationHint.style.display = "none";
        }
        if (subscriptionPeriodRow instanceof HTMLElement) {
            subscriptionPeriodRow.style.display = (isSubscription || isUnlimited) ? "flex" : "none";
        }
        if ((isSubscription || isUnlimited) && pkg) {
            syncBookingPeriodUnitLabel(pkg);
            if (bookingSubMonthsWrap instanceof HTMLElement) bookingSubMonthsWrap.style.display = "flex";
            if (bookingSubEndDateWrap instanceof HTMLElement) bookingSubEndDateWrap.style.display = "";
            syncBookingSubscriptionPeriodDefaults(pkg);
            syncSubscriptionEndDateFromPeriod(pkg);
        }
        if (bookingSubscriptionScheduleRow instanceof HTMLElement) {
            bookingSubscriptionScheduleRow.style.display = isSubscription && !hideWeeklySchedule ? "" : "none";
        }
        if (bookingWalkInHint instanceof HTMLElement) {
            bookingWalkInHint.style.display = "none";
        }
        if (bookingVipHint instanceof HTMLElement) {
            // Aktiv abunə/Limitsiz üçün əlavə uzun izah göstərmirik.
            bookingVipHint.style.display = "none";
            bookingVipHint.textContent = "";
        }
        if (isSubscription && pkg) {
            syncBookingSubscriptionPeriodDefaults(pkg);
            if (!hideWeeklySchedule) {
                renderBookingSubscriptionLaneTypesByDay();
            } else if (bookingSubscriptionLaneTypesByDayEl instanceof HTMLElement) {
                bookingSubscriptionLaneTypesByDayEl.innerHTML = "";
                document.querySelectorAll("#bookingSubscriptionDays .booking-sub-day").forEach(el => {
                    if (el instanceof HTMLInputElement) el.checked = false;
                });
            }
        }
        if (durationMinutesInput instanceof HTMLInputElement && isVip && !isUnlimited) {
            durationMinutesInput.value = "0";
        }
        if (durationMinutesInput instanceof HTMLInputElement && isUnlimited && pkg) {
            durationMinutesInput.value = String(pkg.sessionDurationMinutes || 0);
        }
        if (registrationModeInput instanceof HTMLInputElement) {
            if (!pkg) {
                registrationModeInput.value = "";
            } else if (isGymPackage(pkg)) {
                registrationModeInput.value = "subscription";
            } else if (pkg.billingType === "OneTime") {
                registrationModeInput.value = "instant";
            } else {
                registrationModeInput.value = "subscription";
            }
        }
        if (durationMinutesInput instanceof HTMLInputElement) {
            durationMinutesInput.value = pkg ? String(pkg.sessionDurationMinutes || 0) : "0";
        }
        syncComplimentaryCheckboxUi(pkg);
        syncPaymentFieldsUi(pkg);
        syncRegistrationModeUi();
        syncBookingSubscriptionDayLimit();
    }

    function isOneTimeBookingPackage(pkg) {
        return Boolean(pkg && String(pkg.billingType) === "OneTime" && !isActiveVipReception());
    }

    function isBillableBookingPackage(pkg) {
        // Artıq aktiv VIP/Limitsiz — yalnız zolağa yazılır, ödəniş/endirim yoxdur.
        // VIP/Aylıq/Limitsiz paket satışı isə billable-dir.
        return Boolean(pkg && !isActiveVipReception() && !isActiveUnlimitedReception());
    }

    function syncComplimentaryCheckboxUi(pkg) {
        if (!(bookingComplimentaryWrap instanceof HTMLElement) || !(bookingComplimentaryInput instanceof HTMLInputElement)) {
            return;
        }
        const show = receptionPermissions.canGrantComplimentary && isOneTimeBookingPackage(pkg);
        bookingComplimentaryWrap.style.display = show ? "" : "none";
        if (!show) {
            bookingComplimentaryInput.checked = false;
        }
    }

    function parsePaymentAmountInput(el) {
        const raw = el instanceof HTMLInputElement ? el.value.trim() : "";
        const n = Number(raw);
        return Number.isFinite(n) && n >= 0 ? n : 0;
    }

    function parseCashPaidInput() {
        return parsePaymentAmountInput(bookingAmountPaidCashInput);
    }

    function parseCardPaidInput() {
        return parsePaymentAmountInput(bookingAmountPaidCardInput);
    }


    function getEquipmentLineListPrice(issue) {
        const item = equipmentCatalogCache.find(x => String(x.id) === String(issue.equipmentItemId));
        const qty = Math.max(1, Number(issue?.quantity) || 1);
        return (Number(item?.unitPrice ?? item?.price) || 0) * qty;
    }

    function estimateEquipmentExtraDue() {
        let sum = 0;
        for (const issue of selectedEquipmentIssues) {
            sum += getEquipmentLineListPrice(issue);
        }
        return sum;
    }

    function getBookingEquipmentDiscountTotal() {
        return selectedEquipmentIssues.reduce(
            (sum, x) => sum + Math.max(0, Number(x?.discountAmount) || 0),
            0);
    }

    /** Ödəniş bölgüsü üçün: paket endirimi + avadanlıq sətir endirimləri. */
    function getBookingDiscountTotal() {
        return Math.max(0, parseDiscountInput()) + getBookingEquipmentDiscountTotal();
    }



    function countSubscriptionBillingMonths(startIso, endIso) {
        if (!startIso || !endIso) return 1;
        const start = new Date(`${startIso}T12:00:00`);
        const end = new Date(`${endIso}T12:00:00`);
        if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end < start) return 1;
        const months = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth());
        return Math.max(1, months);
    }

    function getBookingBillingMonths(pkg) {
        if (!pkg) return 1;
        if (String(pkg.billingType) === "OneTime") return 1;
        if (isUnlimitedBillingPackage(pkg)
            || isVipBillingPackage(pkg)
            || pkg.billingType === "Monthly"
            || pkg.billingType === "Yearly") {
            const n = Number(bookingSubMonths?.value ?? 1);
            return Number.isInteger(n) && n >= 1 && n <= 12 ? n : 1;
        }
        return 1;
    }

    function estimatePackageDue(pkg, includeEquipment = false) {
        if (!pkg) return 0;
        let due = (Number(pkg.price) || 0) * getBookingBillingMonths(pkg);
        if (includeEquipment) due += estimateEquipmentExtraDue();
        return due;
    }

    function refreshBookingPriceForPeriodChange() {
        const pkg = getSelectedBookingPackage();
        if (!pkg) return;
        syncBookingPeriodUnitLabel(pkg);
        syncSubscriptionEndDateFromPeriod(pkg);
        syncBookingListPriceDisplay(pkg);
        try { ensureBookingPaymentBinder().rebalance(); } catch { /* ignore */ }
        syncPaymentSummary(pkg);
    }

    function parseDiscountInput() {
        return PaymentSplit.parseAmount(bookingDiscountInput);
    }

    function estimateListPrice(pkg, includeEquipment = false) {
        return estimatePackageDue(pkg, includeEquipment);
    }

    function syncPaymentFieldsUi(pkg) {
        if (!(bookingPaymentRow instanceof HTMLElement)) return;
        const show = isBillableBookingPackage(pkg);
        bookingPaymentRow.style.display = show ? "" : "none";
        if (bookingDiscountWrap instanceof HTMLElement) {
            bookingDiscountWrap.style.display = show && receptionPermissions.canApplyDiscount ? "flex" : "none";
        }
        const complimentary = isOneTimeBookingPackage(pkg) && bookingComplimentaryInput instanceof HTMLInputElement && bookingComplimentaryInput.checked;
        const includeEquipment = selectedEquipmentIssues.length > 0;
        const listPrice = show ? estimateListPrice(pkg, includeEquipment) : 0;
        if (bookingListPriceInput instanceof HTMLInputElement) {
            bookingListPriceInput.value = show ? listPrice.toFixed(2) : "";
        }
        if (bookingDiscountInput instanceof HTMLInputElement) {
            bookingDiscountInput.disabled = complimentary;
            if (!show || complimentary) bookingDiscountInput.value = "";
        }
        if (bookingAmountPaidCashInput instanceof HTMLInputElement) {
            bookingAmountPaidCashInput.disabled = complimentary;
        }
        if (bookingAmountPaidCardInput instanceof HTMLInputElement) {
            bookingAmountPaidCardInput.disabled = complimentary;
        }
        if (complimentary) {
            if (bookingAmountPaidCashInput instanceof HTMLInputElement) bookingAmountPaidCashInput.value = "0.00";
            if (bookingAmountPaidCardInput instanceof HTMLInputElement) bookingAmountPaidCardInput.value = "0.00";
            syncPaymentSummary(pkg);
            return;
        }
        if (!show) {
            if (bookingAmountPaidCashInput instanceof HTMLInputElement) bookingAmountPaidCashInput.value = "";
            if (bookingAmountPaidCardInput instanceof HTMLInputElement) bookingAmountPaidCardInput.value = "";
        }

        // İlkin görünüşdə nağd/kart sahələri boş qalsın.
        // Bu, işçinin ödənişi qəsdən daxil etdiyini göstərir; daxil edilən kimi digər sahə avtomatik balanslanır.
        if (show) {
            if (bookingAmountPaidCashInput instanceof HTMLInputElement) bookingAmountPaidCashInput.value = "";
            if (bookingAmountPaidCardInput instanceof HTMLInputElement) bookingAmountPaidCardInput.value = "";
        }
        syncPaymentSummary(pkg);
    }

    function syncBookingListPriceDisplay(pkg) {
        const show = isBillableBookingPackage(pkg);
        const includeEquipment = selectedEquipmentIssues.length > 0;
        const listPrice = show ? estimateListPrice(pkg, includeEquipment) : 0;
        if (bookingListPriceInput instanceof HTMLInputElement) {
            bookingListPriceInput.value = show ? listPrice.toFixed(2) : "";
        }
    }

    function syncPaymentSummary(pkg) {
        if (!(bookingPaymentSummary instanceof HTMLElement)) return;
        const p = pkg || getSelectedBookingPackage();
        if (!isBillableBookingPackage(p)) {
            bookingPaymentSummary.textContent = "";
            syncScheduleButtonLabel();
            return;
        }
        if (isOneTimeBookingPackage(p) && bookingComplimentaryInput instanceof HTMLInputElement && bookingComplimentaryInput.checked) {
            bookingPaymentSummary.textContent = "Ödənişsiz sessiya — pul tutulmur.";
            syncScheduleButtonLabel();
            return;
        }
        const includeEquipment = selectedEquipmentIssues.length > 0;
        const listPrice = estimateListPrice(p, includeEquipment);
        const discount = Math.min(getBookingDiscountTotal(), listPrice);
        const payable = PaymentSplit.computePayable(listPrice, discount);
        const cash = parseCashPaidInput();
        const card = parseCardPaidInput();
        const paid = PaymentSplit.roundMoney(cash + card);
        const laneDue = Number(p?.price) || 0;
        const equipmentDue = includeEquipment ? estimateEquipmentExtraDue() : 0;
        const parts = [`Əsas: ${listPrice.toFixed(2)} AZN`];
        if (discount > PaymentSplit.Tolerance) parts.push(`Endirim: ${discount.toFixed(2)} AZN`);
        parts.push(`Ödəniləcək: ${payable.toFixed(2)} AZN`);
        parts.push(`Nağd: ${cash.toFixed(2)} · Kart: ${card.toFixed(2)} · Cəmi: ${paid.toFixed(2)}`);
        if (includeEquipment && (laneDue > 0 || equipmentDue > 0)) {
            parts.push(`(zolaq ${laneDue.toFixed(2)} + avadanlıq ${equipmentDue.toFixed(2)})`);
        }
        bookingPaymentSummary.textContent = parts.join(" · ");
        syncScheduleButtonLabel();
    }

    function buildPackagePaymentPayload(pkg, { includeEquipment = false } = {}) {
        if (!isBillableBookingPackage(pkg)) {
            return { isComplimentary: false, discountAmount: 0, amountPaidCash: 0, amountPaidCard: 0 };
        }
        const complimentary = isOneTimeBookingPackage(pkg)
            && bookingComplimentaryInput instanceof HTMLInputElement
            && bookingComplimentaryInput.checked;
        if (complimentary) {
            return { isComplimentary: true, discountAmount: 0, amountPaidCash: 0, amountPaidCard: 0 };
        }
        return {
            isComplimentary: false,
            discountAmount: parseDiscountInput(),
            amountPaidCash: parseCashPaidInput(),
            amountPaidCard: parseCardPaidInput()
        };
    }

    function isBookingPaymentEmpty() {
        const cashEmpty = !(bookingAmountPaidCashInput instanceof HTMLInputElement) || bookingAmountPaidCashInput.value.trim() === "";
        const cardEmpty = !(bookingAmountPaidCardInput instanceof HTMLInputElement) || bookingAmountPaidCardInput.value.trim() === "";
        return cashEmpty && cardEmpty;
    }

    function bookingPaymentMismatchError(payable, paid) {
        if (paid <= PaymentSplit.Tolerance || isBookingPaymentEmpty()) {
            return "Ödəniş daxil etmədiniz. Zəhmət olmasa ödəniş daxil edin.";
        }
        return `Ödəniş cəmi ${payable.toFixed(2)} AZN olmalıdır (nağd + kart).`;
    }

    function validatePackagePayment(pkg, { includeEquipment = false } = {}) {
        const payload = buildPackagePaymentPayload(pkg, { includeEquipment });
        if (!isBillableBookingPackage(pkg)) {
            return { ok: true, payload, listPrice: 0, payable: 0 };
        }
        if (payload.isComplimentary) {
            return { ok: true, payload, listPrice: 0, payable: 0 };
        }
        const listPrice = estimateListPrice(pkg, includeEquipment);
        const equipmentLineDiscount = includeEquipment ? getBookingEquipmentDiscountTotal() : 0;
        const packageDiscount = Math.min(payload.discountAmount, Math.max(0, listPrice - equipmentLineDiscount));
        const discount = Math.min(packageDiscount + equipmentLineDiscount, listPrice);
        if ((packageDiscount > PaymentSplit.Tolerance || equipmentLineDiscount > PaymentSplit.Tolerance)
            && !receptionPermissions.canApplyDiscount) {
            return { ok: false, error: "Endirim tətbiq etmək üçün icazəniz yoxdur." };
        }
        const payable = PaymentSplit.computePayable(listPrice, discount);
        const paid = PaymentSplit.roundMoney(payload.amountPaidCash + payload.amountPaidCard);
        if (payable > PaymentSplit.Tolerance && Math.abs(paid - payable) > PaymentSplit.Tolerance) {
            return { ok: false, error: bookingPaymentMismatchError(payable, paid) };
        }
        if (payable <= PaymentSplit.Tolerance && paid > PaymentSplit.Tolerance) {
            return { ok: false, error: "Endirim tam ödəniləcək məbləği əhatə edir; əlavə ödəniş daxil edilə bilməz." };
        }
        return { ok: true, payload: { ...payload, discountAmount: discount }, listPrice, payable };
    }

    function spreadPackagePaymentFields(pkg, { includeEquipment = false } = {}) {
        const payload = buildPackagePaymentPayload(pkg, { includeEquipment });
        return {
            discountAmount: payload.discountAmount,
            amountPaidCash: payload.amountPaidCash,
            amountPaidCard: payload.amountPaidCard,
            isComplimentary: payload.isComplimentary
        };
    }

    function spreadPackageOnlyPaymentFields(pkg) {
        const payload = buildPackagePaymentPayload(pkg);
        const packageList = Number(pkg?.price) || 0;
        const equipmentList = estimateEquipmentExtraDue();
        const equipmentDiscount = getBookingEquipmentDiscountTotal();
        const packageDiscount = Math.min(payload.discountAmount, packageList);
        const packageNet = Math.max(0, packageList - packageDiscount);
        const equipmentNet = Math.max(0, equipmentList - equipmentDiscount);
        const split = PaymentSplit.splitCombinedCheckout(
            packageNet,
            equipmentNet,
            0,
            payload.amountPaidCash,
            payload.amountPaidCard);
        return {
            discountAmount: packageDiscount,
            amountPaidCash: split.package.cash,
            amountPaidCard: split.package.card,
            isComplimentary: payload.isComplimentary
        };
    }



    async function recordBookingEquipmentSales(athleteId) {
        if (!selectedEquipmentIssues.length) return true;
        const payload = buildPackagePaymentPayload(getSelectedBookingPackage(), { includeEquipment: true });
        const packageList = Number(getSelectedBookingPackage()?.price) || 0;
        const equipmentList = estimateEquipmentExtraDue();
        const equipmentDiscount = getBookingEquipmentDiscountTotal();
        const packageDiscount = Math.min(payload.discountAmount, packageList);
        const packageNet = Math.max(0, packageList - packageDiscount);
        const equipmentNet = Math.max(0, equipmentList - equipmentDiscount);
        const paidCash = payload.amountPaidCash;
        const paidCard = payload.amountPaidCard;
        const split = PaymentSplit.splitCombinedCheckout(
            packageNet,
            equipmentNet,
            0,
            paidCash,
            paidCard);
        const response = await apiFetch("/equipment-sales/sale", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                athleteId,
                lines: selectedEquipmentIssues.map(x => ({
                    equipmentItemId: x.equipmentItemId,
                    quantity: Math.max(1, Number(x?.quantity) || 1),
                    discountAmount: Math.max(0, Number(x?.discountAmount) || 0)
                })),
                discountAmount: 0,
                amountPaidCash: split.equipment.cash,
                amountPaidCard: split.equipment.card
            })
        });
        if (!response.ok) {
            alert(await readErrorMessage(response) || "Avadanlıq satışı qeydə alınmadı.");
            return false;
        }
        clearSelectedEquipment();
        return true;
    }



    let bookingPaymentBinder = null;
    function ensureBookingPaymentBinder() {
        if (bookingPaymentBinder) return bookingPaymentBinder;
        bookingPaymentBinder = PaymentSplit.bindPair(
            bookingAmountPaidCashInput,
            bookingAmountPaidCardInput,
            () => {
                const pkg = getSelectedBookingPackage();
                const includeEquipment = selectedEquipmentIssues.length > 0;
                const complimentary = isOneTimeBookingPackage(pkg)
                    && bookingComplimentaryInput instanceof HTMLInputElement
                    && bookingComplimentaryInput.checked;
                if (complimentary) {
                    return { listPrice: 0, discount: 0 };
                }
                return {
                    listPrice: estimateListPrice(pkg, includeEquipment),
                    discount: getBookingDiscountTotal()
                };
