<link rel="stylesheet" href="/lib/flatpickr/flatpickr.min.css" />
<script defer src="/lib/flatpickr/flatpickr.min.js"></script>
<script defer src="/lib/flatpickr/l10n-az.js"></script>
<script src="/js/baku-time.js"></script>
<script src="/js/payment-split.js"></script>
<script defer src="/lib/signalr/signalr.min.js"></script>
<script>
    // Tarix və saat seçicilərini Azerbaycan dilində + 24 saat formatında istifadə et.
    (function () {
        function isFlatpickrReady() {
            return typeof window.flatpickr === "function";
        }
        function applyAzLocale() {
            try {
                if (isFlatpickrReady() && window.flatpickr.l10ns && window.flatpickr.l10ns.az) {
                    window.flatpickr.localize(window.flatpickr.l10ns.az);
                }
            } catch (e) { /* ignore */ }
        }
        function bindOne(el) {
            if (!(el instanceof HTMLInputElement)) return;
            if (el.dataset.fpBound === "1") return;
            var type = (el.getAttribute("type") || "").toLowerCase();
            if (type !== "date" && type !== "time" && type !== "datetime-local") return;
            if (el.getAttribute("data-no-flatpickr") === "1" || el.readOnly || el.disabled && el.id === "bookingSubEndDate") return;
            if (el.id === "bookingSubEndDate") return;
            // Saat: flatpickr əvəzinə rəqəm maskası (2115 → 21:15)
            if (type === "time") return;
            try {
                var opts = { locale: "az", allowInput: true, time_24hr: true, altInput: true };
                if (type === "datetime-local") {
                    opts.enableTime = true;
                    opts.dateFormat = "Y-m-d H:i";
                    opts.altFormat = "d.m.Y H:i";
                } else {
                    opts.dateFormat = "Y-m-d";
                    opts.altFormat = "d.m.Y";
                }
                opts.onReady = function (_selected, _str, instance) {
                    try {
                        if (instance.altInput) {
                            instance.altInput.disabled = !!el.disabled;
                            instance.altInput.readOnly = false;
                        }
                    } catch (e) { /* ignore */ }
                };
                window.flatpickr(el, opts);
                el.dataset.fpBound = "1";
            } catch (e) { /* ignore individual binding errors */ }
        }
        function bindAll(root) {
            if (!isFlatpickrReady()) return;
            applyAzLocale();
            var scope = (root instanceof Element || root instanceof Document) ? root : document;
            scope.querySelectorAll('input[type="date"], input[type="time"], input[type="datetime-local"]').forEach(bindOne);
        }
        window.applyFlatpickrAz = function () { bindAll(document); };
        function init() {
            bindAll(document);
            try {
                var fpPending = null;
                function shouldSkipFlatpickrNode(n) {
                    if (!(n instanceof Element)) return true;
                    if (n.closest && (n.closest("#laneGrid") || n.closest("#dashboardRows"))) return true;
                    return false;
                }
                var obs = new MutationObserver(function (mutations) {
                    if (!isFlatpickrReady()) return;
                    if (fpPending) clearTimeout(fpPending);
                    fpPending = setTimeout(function () {
                        fpPending = null;
                        for (var i = 0; i < mutations.length; i++) {
                            var m = mutations[i];
                            if (!m.addedNodes) continue;
                            for (var j = 0; j < m.addedNodes.length; j++) {
                                var n = m.addedNodes[j];
                                if (shouldSkipFlatpickrNode(n)) continue;
                                if (n.matches && n.matches('input[type="date"], input[type="time"], input[type="datetime-local"]')) {
                                    bindOne(n);
                                }
                                if (n.querySelectorAll) {
                                    n.querySelectorAll('input[type="date"], input[type="time"], input[type="datetime-local"]').forEach(bindOne);
                                }
                            }
                        }
                    }, 120);
                });
                obs.observe(document.body, { childList: true, subtree: true });
            } catch (e) { /* ignore observer errors */ }
        }
        function bootFlatpickr() {
            if (!isFlatpickrReady()) return;
            bindAll(document);
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", bootFlatpickr);
        } else {
            bootFlatpickr();
        }
        window.addEventListener("load", bootFlatpickr);
    })();
</script>
