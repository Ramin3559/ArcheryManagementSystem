    function showPlannedActivatePanel(sessionId, lanes, athleteId, cardStatus) {
        if (!(plannedSessionsBody instanceof HTMLElement) || !sessionId) return;
        clearPlannedLanePicker();
        const mainRow = plannedSessionsBody.querySelector(`tr[data-planned-session="${CSS.escape(String(sessionId))}"]`);
        if (!(mainRow instanceof HTMLTableRowElement)) return;

        const popover = mainRow.querySelector(`.planned-lane-popover[data-planned-lane-pick-for="${CSS.escape(String(sessionId))}"]`);
        if (!(popover instanceof HTMLElement)) return;

        const nums = (Array.isArray(lanes) ? lanes : [])
            .map(n => Number(n))
            .filter(n => Number.isFinite(n) && n > 0)
            .sort((a, b) => a - b);

        const categoryValue = cardStatus?.category ?? mainRow.getAttribute("data-athlete-category") ?? "";
        const categoryLabel = formatAthleteCategoryLabel(
            categoryValue,
            cardStatus?.categoryLabel ?? mainRow.getAttribute("data-athlete-category-label"));
        const categoryBlock = categoryLabel
            ? `<div class="planned-lane-pick__category">Növ: <span>${escapeHtml2(categoryLabel)}</span></div>`
            : "";

        const hasCard = !!cardStatus?.hasCard && !cardStatus?.clubCardNumber;
        const prefillType = clubCardTypeToSelectValue(cardStatus?.clubCardType);
        const prefillNum = (cardStatus?.clubCardNumber ?? "").toString();
        const cardBlock = hasCard
            ? `<div class="planned-lane-pick__card-ok">Kart var</div>`
            : `<div class="planned-lane-pick__card">
                    <select data-planned-card-type title="Kart növü">
                        <option value="">Kart növü</option>
                        <option value="0"${prefillType === "0" ? " selected" : ""}>Boz</option>
                        <option value="1"${prefillType === "1" ? " selected" : ""}>Qırmızı</option>
                        <option value="2"${prefillType === "2" ? " selected" : ""}>Qara</option>
                        <option value="3"${prefillType === "3" ? " selected" : ""}>VIP-Qızılı</option>
                    </select>
                    <input data-planned-card-number placeholder="Kart nömrəsi" maxlength="40" autocomplete="off" value="${escapeHtml2(prefillNum)}" />
               </div>`;

        const lanesBlock = nums.length
            ? `<div class="planned-lane-pick__label">Boş zolaq seçin:</div>
               <div class="planned-lane-pick__lanes">
                    ${nums.map(n => {
                        const pro = n >= 9;
                        return `<button type="button" class="planned-lane-chip${pro ? " planned-lane-chip--pro" : ""}" data-activate-session="${escapeHtml2(sessionId)}" data-activate-lane="${escapeHtml2(n)}" data-athlete-id="${escapeHtml2(athleteId || "")}" data-athlete-category="${escapeHtml2(categoryValue)}" data-needs-lane-pick="0">Zolaq ${escapeHtml2(n)}${pro ? " (P)" : ""}</button>`;
                    }).join("")}
               </div>`
            : `<div class="planned-lane-pick__label" style="color:#c21b33;">Boş zolaq yoxdur</div>`;

        popover.setAttribute("data-card-ready", hasCard ? "1" : "0");
        popover.setAttribute("data-athlete-category", String(categoryValue ?? ""));
        popover.innerHTML = `
            <div class="planned-lane-pick">
                ${categoryBlock}
                ${cardBlock}
                ${lanesBlock}
            </div>`;
        popover.classList.add("is-open");
    }

    async function loadPlannedSessionsToday() {
        if (!(plannedSessionsBody instanceof HTMLElement)) return;
        plannedSessionsBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#7a86a8;">Yüklənir...</td></tr>`;
        try {
            const today = getTodayLocalIso();
            const res = await apiFetch(`/sessions/by-date?dateLocal=${encodeURIComponent(today)}`, { timeoutMs: 20000 });
            if (!res.ok) {
                plannedSessionsBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#b91c1c;">${escapeHtml2(await readErrorMessage(res) || "Yüklənmədi.")}</td></tr>`;
                return;
            }
            const data = await res.json().catch(() => ({}));
            const rows = (Array.isArray(data?.sessions) ? data.sessions : [])
                .filter(x => String(x?.status ?? "") === "Scheduled");

            if (!rows.length) {
                plannedSessionsBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#7a86a8;">Bu gün üçün plan yoxdur.</td></tr>`;
                return;
            }

            plannedSessionsBody.innerHTML = rows.map(x => {
                const start = formatLocalTimeShort(new Date(x.startTimeUtc));
                const end = formatLocalTimeShort(new Date(x.endTimeUtc));
                const needsLanePick = !!x?.needsLanePick;
                const lane = Number(x.laneNumber) || 0;
                const laneLabel = needsLanePick ? "Seçiləcək" : (lane > 0 ? `Zolaq ${lane}` : "—");
                const athleteId = x.athleteId ?? "";
                const catLabel = formatAthleteCategoryLabel(x.athleteCategory, x.athleteCategoryLabel);
                const nameCell = catLabel
                    ? `${escapeHtml2(x.athleteName)} <span style="color:#667395;font-weight:700;">(${escapeHtml2(catLabel)})</span>`
                    : escapeHtml2(x.athleteName);
                return `
                    <tr data-planned-session="${escapeHtml2(x.sessionId)}" data-athlete-id="${escapeHtml2(athleteId)}" data-athlete-category="${escapeHtml2(x.athleteCategory ?? "")}" data-athlete-category-label="${escapeHtml2(catLabel)}" data-needs-lane-pick="${needsLanePick ? "1" : "0"}" data-lane-number="${escapeHtml2(lane)}">
                        <td style="white-space:nowrap;">${start}–${end}</td>
                        <td>${nameCell}</td>
                        <td style="white-space:nowrap;">${escapeHtml2(laneLabel)}</td>
                        <td style="white-space:nowrap;">${escapeHtml2(x.statusLabel)}</td>
                        <td class="planned-session-actions">
                            <div class="planned-session-actions__inner">
                                <button type="button" class="btn btn-primary btn-sm" data-activate-session="${escapeHtml2(x.sessionId)}" data-athlete-id="${escapeHtml2(athleteId)}" data-athlete-category="${escapeHtml2(x.athleteCategory ?? "")}" data-needs-lane-pick="${needsLanePick ? "1" : "0"}">Aktiv et</button>
                                <button type="button" class="btn btn-danger btn-sm" data-cancel-session="${escapeHtml2(x.sessionId)}">Ləğv et</button>
                                <div class="planned-lane-popover" data-planned-lane-pick-for="${escapeHtml2(x.sessionId)}"></div>
                            </div>
                        </td>
                    </tr>`;
            }).join("");
        } catch (e) {
            plannedSessionsBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#b91c1c;">Xəta baş verdi.</td></tr>`;
            console.error(e);
        }
    }

    async function activatePlannedSession(sessionId, laneNumber = 0, athleteId = null, needsLanePick = false, cardSnap = null) {
        if (!sessionId) return;
        showPlannedSessionsHint("", "warn");

        // Zolaq chip seçilib — kartı paneldən oxu və Aktiv et ilə göndər.
        if (Number(laneNumber) > 0) {
            const laneNum = Number(laneNumber);
            if (laneNum >= 9 && laneNum <= 11) {
                // Yalnız həqiqi müştəri kateqoriyası — forma select-i yox.
                let cat = NaN;
                const row = plannedSessionsBody?.querySelector(`tr[data-planned-session="${CSS.escape(String(sessionId))}"]`);
                const fromRow = Number(row?.getAttribute("data-athlete-category"));
                const fromBtn = Number(
                    plannedSessionsBody?.querySelector(
                        `.planned-lane-chip[data-activate-session="${CSS.escape(String(sessionId))}"][data-activate-lane="${CSS.escape(String(laneNum))}"]`
                    )?.getAttribute("data-athlete-category")
                );
                if (Number.isFinite(fromBtn)) cat = fromBtn;
                else if (Number.isFinite(fromRow)) cat = fromRow;
                if (!Number.isFinite(cat) && athleteId) {
                    const st = await fetchAthleteClubCardStatus(athleteId);
                    cat = Number(st?.category);
                }
                if (cat === 0) {
                    const okPro = window.confirm("Professional zolağa keçirmək istəyirsiniz?");
                    if (!okPro) return;
                }
            }

            const panel = cardSnap || readPlannedPanelCard(sessionId);
            let clubCardNumber = null;
            let clubCardType = null;

            if (panel.alreadyOnAthlete) {
                // Kart artıq müştəridədir — əlavə göndərmək lazım deyil.
            } else if (panel.hasCard) {
                clubCardNumber = panel.cardNumber;
                clubCardType = panel.cardType;
            } else if (receptionHasClubCardAssigned()) {
                clubCardNumber = (clubCardNumberInput?.value ?? "").toString().trim();
                clubCardType = readClubCardTypeValue(clubCardTypeInput);
            } else if (athleteId) {
                const status = await fetchAthleteClubCardStatus(athleteId);
                if (!status.hasCard) {
                    alert("Kart təqdim edilməyib");
                    return;
                }
            } else {
                alert("Kart təqdim edilməyib");
                return;
            }

            if (!panel.alreadyOnAthlete && !clubCardNumber && athleteId) {
                const status = await fetchAthleteClubCardStatus(athleteId);
                if (!status.hasCard) {
                    alert("Kart təqdim edilməyib");
                    return;
                }
            } else if (!panel.alreadyOnAthlete && clubCardNumber && (clubCardType === null || clubCardType === undefined)) {
                alert("Kart təqdim edilməyib");
                return;
            }

            const body = { laneNumber: Number(laneNumber) };
            if (clubCardNumber) {
                body.clubCardNumber = clubCardNumber;
                body.clubCardType = clubCardType;
            }

            const res = await apiFetch(`/sessions/${encodeURIComponent(sessionId)}/activate`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });
            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                const err = data?.error || await readErrorMessage(res) || "Aktiv edilmədi.";
                const lanes = Array.isArray(data?.availableLaneNumbers) ? data.availableLaneNumbers : [];
                const cardStatus = clubCardNumber
                    ? { hasCard: false, clubCardNumber, clubCardType }
                    : await fetchAthleteClubCardStatus(athleteId);
                if (lanes.length) {
                    showPlannedActivatePanel(sessionId, lanes, athleteId, cardStatus);
                } else {
                    clearPlannedLanePicker(sessionId);
                }
                showPlannedSessionsHint(err, "error");
                if (data?.clubCardHeld || /kart/i.test(String(err))) {
                    alert(err);
                }
                return;
            }
            if (clubCardNumber) {
                if (clubCardNumberInput instanceof HTMLInputElement) clubCardNumberInput.value = clubCardNumber;
                if (clubCardTypeInput instanceof HTMLSelectElement) clubCardTypeInput.value = String(clubCardType);
                try { refreshSelectedCustomerCard(); } catch { }
            }
            clearPlannedLanePicker(sessionId);
            showPlannedSessionsHint("Sessiya aktiv edildi.", "ok");
            await refreshReceptionPanelData({ force: true });
            await loadPlannedSessionsToday();
            return;
        }

        // Panel aç: kart + boş zolaqlar (aktivasiya yalnız zolaq seçiləndə).
        clearPlannedLanePicker(sessionId);
        const cardStatus = await fetchAthleteClubCardStatus(athleteId);
        let lanes = [];

        if (needsLanePick) {
            const probe = await probePlannedAvailableLanes(sessionId);
            if (probe.activated) {
                clearPlannedLanePicker(sessionId);
                showPlannedSessionsHint("Sessiya aktiv edildi.", "ok");
                await refreshReceptionPanelData({ force: true });
                await loadPlannedSessionsToday();
                return;
            }
            lanes = probe.lanes;
            if (probe.athleteCategory != null && probe.athleteCategory !== undefined) {
                cardStatus.category = probe.athleteCategory;
                cardStatus.categoryLabel = probe.athleteCategoryLabel
                    || formatAthleteCategoryLabel(probe.athleteCategory, null);
            }
            if (!lanes.length) {
                showPlannedActivatePanel(sessionId, [], athleteId, cardStatus);
                showPlannedSessionsHint(probe.error || "Boş zolaq yoxdur.", "error");
                return;
            }
        } else {
            const row = plannedSessionsBody?.querySelector(`tr[data-planned-session="${CSS.escape(String(sessionId))}"]`);
            const plannedLane = Number(row?.getAttribute("data-lane-number") || 0);
            if (plannedLane > 0) {
                lanes = [plannedLane];
            } else {
                const probe = await probePlannedAvailableLanes(sessionId);
                lanes = probe.lanes;
                if (probe.athleteCategory != null && probe.athleteCategory !== undefined) {
                    cardStatus.category = probe.athleteCategory;
                    cardStatus.categoryLabel = probe.athleteCategoryLabel
                        || formatAthleteCategoryLabel(probe.athleteCategory, null);
                }
            }
        }

        showPlannedActivatePanel(sessionId, lanes, athleteId, cardStatus);
        if (!cardStatus.hasCard) {
            showPlannedSessionsHint("Kart təqdim edilməyib", "warn");
        } else if (!lanes.length) {
            showPlannedSessionsHint("Boş zolaq yoxdur.", "error");
        } else {
            showPlannedSessionsHint("Boş zolaq seçin.", "warn");
        }
    }

    async function cancelPlannedSession(sessionId) {
        if (!sessionId) return;
        const ok = window.confirm("Bu planı ləğv etmək istəyirsiniz?");
        if (!ok) return;

        clearPlannedLanePicker(sessionId);
        const res = await apiFetch(`/sessions/${encodeURIComponent(sessionId)}/cancel`, { method: "POST" });
        if (!res.ok) {
            showPlannedSessionsHint(await readErrorMessage(res) || "Ləğv edilmədi.", "error");
            return;
        }
        showPlannedSessionsHint("Plan ləğv edildi.", "ok");
        await refreshReceptionPanel();
        await loadPlannedSessionsToday();
    }

    async function infoShow(options = {}) {
        const athleteIdOpt = options?.athleteId || null;
        const phone = normalizeDigits(infoPhone?.value);
        const email = normalizeText(infoEmail?.value);
        const idCardNumber = normalizeText(infoIdCard?.value);

        if (!athleteIdOpt && !phone && !email && !idCardNumber) {
            showInfoHint("Zəhmət olmasa bir məlumat daxil edin.", "warn");
            return;
        }

        showInfoHint("Yüklənir...", "warn");
        if (infoTableWrap instanceof HTMLElement) infoTableWrap.style.display = "none";
        if (infoTableBody instanceof HTMLElement) infoTableBody.innerHTML = "";
        if (infoDaysToolbar instanceof HTMLElement) infoDaysToolbar.style.display = "none";
        _infoDaysMode = "planned";
        _infoVisitedRows = [];

        const qs = new URLSearchParams();
        if (athleteIdOpt) qs.set("id", athleteIdOpt);
        if (phone) qs.set("phone", phone);
        if (email) qs.set("email", email);
        if (idCardNumber) qs.set("idCardNumber", idCardNumber);

        const res = await apiFetch(`/info/athlete?${qs.toString()}`);
        if (!res.ok) {
            const msg = await readErrorMessage(res);
            showInfoHint(msg || "Tapılmadı.", "error");
            return;
        }

        const data = await res.json().catch(() => ({}));
        const packages = Array.isArray(data?.packages) ? data.packages : [];
        const weeklySchedules = Array.isArray(data?.weeklySchedules) ? data.weeklySchedules : [];
        showInfoHint(
            data?.isActive === false
                ? `Müştəri tapıldı: ${data?.fullName ?? "—"} — «Silinmişlər» siyahısındadır. Yenidən aktiv etmək üçün adminə müraciət edin.`
                : `Müştəri tapıldı: ${data?.fullName ?? "—"}`,
            data?.isActive === false ? "warn" : "ok");

        if (!(infoTableBody instanceof HTMLElement) || !(infoTableWrap instanceof HTMLElement)) return;
        infoTableBody.innerHTML = "";
        _infoSchedulesById = {};

        _currentInfoAthleteName = data?.fullName || "—";
        _currentInfoAthleteId = data?.athleteId ?? null;
        _currentInfoIsSubscriber = Boolean(data?.isSubscriber);
        fillInfoProfileForm(data);

        if (infoVisitStats instanceof HTMLElement) {
            const vs = data?.visitStats;
            if (vs && (vs.hasActiveSubscription || Number(vs.visited) > 0)) {
                const visited = Number(vs.visited ?? 0);
                const rem = vs.remainingLabel != null ? String(vs.remainingLabel) : "—";
                const limit = vs.visitLimit != null ? Number(vs.visitLimit) : null;
                infoVisitStats.style.display = "block";
                infoVisitStats.innerHTML =
                    `Gəlib: <strong>${visited}</strong> dəfə` +
                    ` &nbsp;·&nbsp; Qalıb: <strong>${escapeHtml2(rem)}</strong>` +
                    (limit != null && !vs.isUnlimited ? ` &nbsp;·&nbsp; Limit: <strong>${limit}</strong>` : "") +
                    (vs.hasCarryover ? " <span style=\"color:#7a86a8;font-weight:600;\">(qalıq gediş)</span>" : "") +
                    (vs.isUnlimited ? " <span style=\"color:#7a86a8;font-weight:600;\">(limitsiz abunə)</span>" : "");
            } else {
                infoVisitStats.style.display = "none";
                infoVisitStats.innerHTML = "";
            }
        }

        if (infoPackagesSummary instanceof HTMLElement) {
            if (packages.length) {
                infoPackagesSummary.style.display = "block";
                infoPackagesSummary.innerHTML = packages.map(p => {
                    const fp = p.isFullPackage ? " <span style='color:#7a86a8'>(tam paket)</span>" : "";
                    return `<div><strong>${escapeHtml2(p.fromLocal)} — ${escapeHtml2(p.toLocal)}</strong> · ${escapeHtml2(p.days)}${fp}</div>`;
                }).join("");
            } else {
                infoPackagesSummary.style.display = "none";
                infoPackagesSummary.innerHTML = "";
            }
        }

        for (const s of weeklySchedules) {
            const sid = String(s?.scheduleId ?? "");
            if (!sid) continue;
            _infoSchedulesById[sid] = {
                dayOfWeek: s.dayOfWeek,
                startTimeLocal: s.startTimeLocal,
                durationMinutes: s.durationMinutes,
                preferredLaneType: s.preferredLaneType,
                laneNumber: s.laneNumber,
                activeFromDateLocal: s.activeFromDateLocal,
                activeToDateLocal: s.activeToDateLocal,
                isFullPackage: Boolean(s.isFullPackage)
            };
        }

        const occ = Array.isArray(data?.occurrencesFlat) ? data.occurrencesFlat : [];
        _occurrencesFlat = occ;
        _infoVisitedRows = Array.isArray(data?.lastSessions) ? data.lastSessions : [];
        _infoDaysMode = "planned";
        renderInfoDaysTable();

        infoTableBody.onclick = function (ev) {
            if (_infoDaysMode !== "planned") return;
            var t = ev && ev.target;
            if (!(t instanceof HTMLElement)) return;
            var scheduleId = t.getAttribute("data-edit-schedule");
            if (scheduleId) {
                openScheduleEditModal(scheduleId);
                return;
            }
            var disableId = t.getAttribute("data-disable-schedule");
            if (disableId) {
                disableScheduleFromInfo(disableId);
                return;
            }
            var es = t.getAttribute("data-edit-occurrence-schedule");
            var ed = t.getAttribute("data-edit-occurrence-date");
            if (es && ed) {
                openOccurrenceEditModal(es, ed);
                return;
            }
            var xs = t.getAttribute("data-exclude-occurrence-schedule");
            var xd = t.getAttribute("data-exclude-occurrence-date");
            if (xs && xd) {
                excludeOccurrenceFromInfo(xs, xd);
            }
        };

        infoTableWrap.style.display = "block";
    }

    async function disableScheduleFromInfo(scheduleId) {
        if (!scheduleId) return;
        const ok = window.confirm("Bu abunə gününü ləğv etmək istəyirsiniz?");
        if (!ok) return;
        const res = await apiFetch(`/subscriptions/schedules/${encodeURIComponent(scheduleId)}/disable`, {
            method: "POST"
        });
        if (!res.ok) {
            alert(await readErrorMessage(res) || "Abunə planı ləğv edilmədi.");
            return;
        }
        showInfoHint("Abunə planı ləğv edildi.", "ok");
        await infoShow();
    }

    var _infoSchedulesById = {};
    var _occurrencesFlat = [];
    var _infoVisitedRows = [];
    var _infoDaysMode = "planned"; // planned | visited
    var _currentInfoAthleteName = "—";
    var _currentInfoAthleteId = null;
    var _currentInfoIsActive = true;
    var _currentInfoIsSubscriber = false;
    var _editingScheduleId = null;

    function syncInfoDaysToolbar() {
        if (infoDaysToolbar instanceof HTMLElement) {
            infoDaysToolbar.style.display = "flex";
        }
        if (infoDaysTitle instanceof HTMLElement) {
            infoDaysTitle.textContent = _infoDaysMode === "visited"
                ? "Gəldiyi günlər"
                : "Planlaşdırılan Günlər";
        }
        if (infoDaysToggleBtn instanceof HTMLButtonElement) {
            infoDaysToggleBtn.textContent = _infoDaysMode === "visited"
                ? "Planlaşdırılan Günlər"
                : "Gəldiyi günlər";
        }
    }

    function renderInfoDaysTable() {
        if (!(infoTableBody instanceof HTMLElement) || !(infoTableWrap instanceof HTMLElement)) return;
        syncInfoDaysToolbar();
        infoTableBody.innerHTML = "";
        const todayIso = getTodayLocalIso();

        if (_infoDaysMode === "visited") {
            if (infoTableHead instanceof HTMLElement) {
                infoTableHead.innerHTML = `<tr>
                    <th>Tarix</th>
                    <th>Gün</th>
                    <th>Saat</th>
                </tr>`;
            }
            const rows = Array.isArray(_infoVisitedRows) ? _infoVisitedRows : [];
            if (!rows.length) {
                infoTableBody.innerHTML = `<tr><td colspan="3" style="text-align:center;color:#7a86a8;">Gəliş qeydi yoxdur.</td></tr>`;
            } else {
                for (const v of rows) {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td>${escapeHtml2(formatDateOnly(v?.dateLocal))}</td>
                        <td>${escapeHtml2(v?.dayLabel)}</td>
                        <td>${escapeHtml2(v?.startTime)}${v?.endTime ? "–" + escapeHtml2(v.endTime) : ""}</td>`;
                    infoTableBody.appendChild(tr);
                }
            }
            infoTableWrap.style.display = "block";
            return;
        }

        if (infoTableHead instanceof HTMLElement) {
            infoTableHead.innerHTML = `<tr>
                <th>Tarix</th>
                <th>Gün</th>
                <th>Saat</th>
                <th>Zolaq</th>
                <th>Əməliyyat</th>
            </tr>`;
        }

        const occ = Array.isArray(_occurrencesFlat) ? _occurrencesFlat : [];
        const futureOcc = occ.filter(o => String(o?.dateLocal ?? "") >= todayIso);
        if (futureOcc.length) {
            for (const o of futureOcc) {
                const sid = escapeHtml2(o?.scheduleId ?? "");
                const d = escapeHtml2(o?.dateLocal ?? "");
                const tr = document.createElement("tr");
                tr.setAttribute("data-date", String(o?.dateLocal ?? ""));
                if (String(o?.dateLocal ?? "") === todayIso) {
                    tr.style.background = "rgba(79,70,229,0.06)";
                }
                tr.innerHTML = `
                    <td>${escapeHtml2(formatDateOnly(o?.dateLocal))}</td>
                    <td>${escapeHtml2(o?.dayLabel)}</td>
                    <td>${escapeHtml2(o?.startTime)}–${escapeHtml2(o?.endTime)}</td>
                    <td>${escapeHtml2(o?.laneLabel)}</td>
                    <td style="white-space:nowrap;">
                        <button type="button" class="btn btn-ghost btn-sm" data-edit-occurrence-schedule="${sid}" data-edit-occurrence-date="${d}">Dəyişdir</button>
                        <button type="button" class="btn btn-danger btn-sm" data-exclude-occurrence-schedule="${sid}" data-exclude-occurrence-date="${d}">Ləğv et</button>
                    </td>`;
                infoTableBody.appendChild(tr);
            }
            requestAnimationFrame(() => {
                const todayRow = infoTableBody.querySelector(`tr[data-date="${todayIso}"]`);
                if (todayRow instanceof HTMLElement && infoTableWrap instanceof HTMLElement) {
                    todayRow.scrollIntoView({ block: "nearest" });
                }
            });
        } else {
            let emptyMsg;
            if (occ.length > 0) {
                emptyMsg = "Gələcək seans qalmayıb.";
            } else if (_currentInfoIsSubscriber) {
                emptyMsg = "Aktiv abunə planı tapılmadı. Resepsiyadan yeni abunə qeyd edə bilərsiniz.";
            } else {
                emptyMsg = "Aktiv abunə planı yoxdur.";
            }
            infoTableBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#7a86a8;">${emptyMsg}</td></tr>`;
        }
        infoTableWrap.style.display = "block";
    }

    function toggleInfoDaysMode() {
        _infoDaysMode = _infoDaysMode === "visited" ? "planned" : "visited";
        renderInfoDaysTable();
    }

    function setScheduleEditHint(text, kind) {
        var el = document.getElementById("scheduleEditHint");
        if (!(el instanceof HTMLElement)) return;
        el.textContent = text || "";
        el.style.display = text ? "block" : "none";
        el.className = kind === "ok" ? "notice notice--ok" : kind === "error" ? "notice notice--error" : "notice";
    }

    function openScheduleEditModal(scheduleId) {
        var item = _infoSchedulesById[scheduleId];
        if (!item) {
