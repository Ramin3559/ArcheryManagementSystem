    async function stopSession(sessionId) {
        try {
            const lane = (Array.isArray(latestLanes) ? latestLanes : [])
                .find(x => String(x.sessionId) === String(sessionId));
            // Planlı (aktiv edilməmiş) sessiya: ləğv et; aktiv olan: tamamla.
            const isPlannedOnly = lane
                && lane.isSessionActivated !== true
                && String(lane.status ?? "") === "Scheduled";
            const endpoint = isPlannedOnly
                ? `/sessions/${sessionId}/cancel`
                : `/sessions/${sessionId}/complete`;

            let response = await apiFetch(endpoint, { method: "POST" });

            // Ləğv icazəsi yoxdursa planlı sessiyanı də complete ilə bağlamağa çalış.
            if (!response.ok && isPlannedOnly) {
                response = await apiFetch(`/sessions/${sessionId}/complete`, { method: "POST" });
            }

            if (!response.ok) {
                const message = await readErrorMessage(response);
                alert(`Sessiya dayandırılmadı. ${message}`);
                return;
            }

            sessionInfo.textContent = `Sessiya dayandırıldı: ${sessionId}`;
            await refreshReceptionPanelData();
        } catch (error) {
            alert(`Sessiya dayandırılmadı. ${getExceptionMessage(error)}`);
        }
