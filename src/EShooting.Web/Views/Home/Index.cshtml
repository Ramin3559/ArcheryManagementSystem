    function defaultScheduledStartTimeValue() {
        const ms = Date.now() + 15 * 60000;
        if (typeof BakuTime !== "undefined") {
            return BakuTime.formatBakuFromUtcMs(ms, false);
        }
        const now = new Date(ms);
        const h = String(now.getHours()).padStart(2, "0");
        const m = String(now.getMinutes()).padStart(2, "0");
        return `${h}:${m}`;
    }

    function getSessionStartTimeRaw() {
        if (!(sessionStartTimeInput instanceof HTMLInputElement)) {
            return "";
        }
        const n = normalizeHhMmValue(sessionStartTimeInput.value);
        if (n) {
            sessionStartTimeInput.value = n;
            return n;
        }
        return String(sessionStartTimeInput.value || "").trim();
    }

    function syncSessionStartModeUi() {
        const scheduled = document.querySelector('input[name="sessionStartMode"]:checked')?.value === "scheduled";
        if (sessionStartTimeInput instanceof HTMLInputElement) {
            sessionStartTimeInput.disabled = !scheduled;
            if (scheduled) {
                attachHhMmTimeMask(sessionStartTimeInput);
                const current = String(getSessionStartTimeRaw() || "").trim();
                if (!current) {
                    sessionStartTimeInput.value = defaultScheduledStartTimeValue();
                }
                try { sessionStartTimeInput.focus({ preventScroll: true }); } catch { /* ignore */ }
            } else {
                sessionStartTimeInput.blur();
            }
        }
        if (shouldUseOpenEndedSession() && durationMinutesInput instanceof HTMLInputElement) {
            durationMinutesInput.value = "0";
        }
    }

    function resolveSessionStartTimeUtc() {
        const mode = document.querySelector('input[name="sessionStartMode"]:checked')?.value ?? "now";
        if (mode !== "scheduled") {
            return { ok: true, utc: new Date().toISOString() };
        }

        const timeRaw = getSessionStartTimeRaw();
        const parts = parseLocalTimeParts(timeRaw);
        if (!parts) {
            return { ok: false, error: "Başlama saatını seçin." };
        }

        const startUtcMs = (typeof BakuTime !== "undefined")
            ? BakuTime.bakuLocalTimeToUtcMs(parts.hour, parts.minute)
            : (() => {
                const now = new Date();
                return new Date(now.getFullYear(), now.getMonth(), now.getDate(), parts.hour, parts.minute, 0, 0).getTime();
            })();

        if (startUtcMs < Date.now() - 30 * 1000) {
            return { ok: false, error: "Geri vaxta yaza bilməzsiniz. «İndi başla» seçin və ya cari vaxtdan sonrakı saatı yazın." };
        }

        return { ok: true, utc: new Date(startUtcMs).toISOString() };
    }

    function shouldActivateSessionImmediately() {
        return (document.querySelector('input[name="sessionStartMode"]:checked')?.value ?? "now") !== "scheduled";
    }

