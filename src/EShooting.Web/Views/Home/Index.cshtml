    function populateOccurrenceEditDateSelect(selectedScheduleId, selectedDateLocal) {
        var sel = document.getElementById("occurrenceEditDateSelect");
        if (!(sel instanceof HTMLSelectElement)) return;
        var future = getFutureOccurrences();
        sel.innerHTML = "";
        for (var i = 0; i < future.length; i++) {
            var o = future[i];
            var opt = document.createElement("option");
            opt.value = String(o.scheduleId) + "|" + String(o.dateLocal);
            opt.textContent = formatDateOnly(o.dateLocal) + " · " + String(o.dayLabel || "") + " · " + String(o.startTime || "") + "–" + String(o.endTime || "");
            if (String(o.scheduleId) === String(selectedScheduleId) && String(o.dateLocal) === String(selectedDateLocal)) {
                opt.selected = true;
            }
            sel.appendChild(opt);
        }
    }

    function getOccurrenceEditDateBounds(scheduleId) {
        const today = getTodayLocalIso();
        const meta = _infoSchedulesById[String(scheduleId || "")];
        let min = today;
        let max = "";
        if (meta?.activeFromDateLocal && String(meta.activeFromDateLocal) > min) {
            min = String(meta.activeFromDateLocal);
        }
        if (meta?.activeToDateLocal) {
            max = String(meta.activeToDateLocal);
        }
        return { min, max };
    }

    function applyOccurrenceEditDateBounds(scheduleId) {
        const targetDateEl = document.getElementById("occurrenceEditTargetDate");
        if (!(targetDateEl instanceof HTMLInputElement)) return;
        const bounds = getOccurrenceEditDateBounds(scheduleId);
        targetDateEl.min = bounds.min || "";
        targetDateEl.max = bounds.max || "";
        try {
            if (targetDateEl._flatpickr) {
                if (bounds.min) targetDateEl._flatpickr.set("minDate", bounds.min);
                if (bounds.max) targetDateEl._flatpickr.set("maxDate", bounds.max);
                else targetDateEl._flatpickr.set("maxDate", null);
            }
        } catch { /* ignore */ }
    }

    function syncOccurrenceEditDateHint() {
        const dEl = document.getElementById("occurrenceEditDateLocal");
        const targetDateEl = document.getElementById("occurrenceEditTargetDate");
        const dateHint = document.getElementById("occurrenceEditDateHint");
        if (!(dateHint instanceof HTMLElement)) return;
        const source = dEl instanceof HTMLInputElement ? dEl.value.trim() : "";
        const target = targetDateEl instanceof HTMLInputElement ? targetDateEl.value.trim() : "";
        if (!target) {
            dateHint.textContent = "Tarix seçin (bu gün və ya paket sonuna qədər).";
            return;
        }
        if (target === source) {
            dateHint.textContent = "Eyni tarix: yalnız saat və zolaq dəyişir. Başqa gün seçsəniz seans ora köçürüləcək.";
            return;
        }
        dateHint.textContent = `«${formatDateOnly(source)}» abunə günü ləğv olunacaq, seans «${formatDateOnly(target)}» tarixinə köçürüləcək. Zolaq doludursa saxlanmayacaq.`;
    }

    function syncOccurrenceEditFieldsFromRow(row, prefill) {
        if (!row) return;
        var sidEl = document.getElementById("occurrenceEditScheduleId");
        var dEl = document.getElementById("occurrenceEditDateLocal");
        var st = document.getElementById("occurrenceEditStartTime");
        var dur = document.getElementById("occurrenceEditDuration");
        var lane = document.getElementById("occurrenceEditLaneNumber");
        var pkgHint = document.getElementById("occurrenceEditPackageHint");
        var rescheduleRow = document.getElementById("occurrenceEditRescheduleRow");
        var targetDateEl = document.getElementById("occurrenceEditTargetDate");
        if (sidEl instanceof HTMLInputElement) sidEl.value = String(row.scheduleId);
        if (dEl instanceof HTMLInputElement) dEl.value = String(row.dateLocal);
        var defaultTime = String(row.startTime || "").trim() || "10:00";
        if (st instanceof HTMLInputElement) {
            st.value = prefill?.startTime || defaultTime;
        }
        if (dur instanceof HTMLInputElement) dur.value = String(row.durationMinutes != null ? row.durationMinutes : 60);
        if (pkgHint instanceof HTMLElement) {
            pkgHint.textContent = "Paket vaxtı: " + (row.startTime || "—") + "–" + (row.endTime || "—") + " (müddət paketdən gəlir, dəyişdirilmir)";
        }
        if (rescheduleRow instanceof HTMLElement) {
            rescheduleRow.style.display = "block";
        }
        applyOccurrenceEditDateBounds(row.scheduleId);
        var preferredTarget = prefill?.rescheduleTargetDate || row.dateLocal;
        var bounds = getOccurrenceEditDateBounds(row.scheduleId);
        if (bounds.min && String(preferredTarget) < bounds.min) preferredTarget = bounds.min;
        if (bounds.max && String(preferredTarget) > bounds.max) preferredTarget = bounds.max;
        if (targetDateEl instanceof HTMLInputElement) {
            targetDateEl.value = String(preferredTarget || "");
            try {
                if (targetDateEl._flatpickr) {
                    targetDateEl._flatpickr.setDate(targetDateEl.value, false);
                }
            } catch { /* ignore */ }
        }
        syncOccurrenceEditDateHint();
        if (lane instanceof HTMLSelectElement) {
            var prefillLane = Number(prefill?.laneNumber ?? 0);
            var laneVal = prefillLane > 0 ? prefillLane : Number(row.laneNumber);
            lane.value = String(Number.isInteger(laneVal) && laneVal > 0 ? laneVal : 1);
        }
    }

    function onOccurrenceEditDateSelectChange() {
        var sel = document.getElementById("occurrenceEditDateSelect");
        if (!(sel instanceof HTMLSelectElement) || !sel.value) return;
        var parts = sel.value.split("|");
        if (parts.length < 2) return;
        var sid = parts[0];
        var d = parts[1];
        var row = getFutureOccurrences().find(function (o) {
            return String(o.scheduleId) === String(sid) && String(o.dateLocal) === String(d);
        });
        var st = document.getElementById("occurrenceEditStartTime");
        var lane = document.getElementById("occurrenceEditLaneNumber");
        var prefill = {};
        if (st instanceof HTMLInputElement && st.value) prefill.startTime = st.value;
        if (lane instanceof HTMLSelectElement && lane.value) prefill.laneNumber = Number(lane.value);
        if (row) syncOccurrenceEditFieldsFromRow(row, prefill);
    }

    function openOccurrenceEditModal(scheduleId, dateLocal, prefill) {
        var future = getFutureOccurrences();
        if (!future.length) {
            alert("Gələcək abunə seansı tapılmadı.");
            return;
        }
        var row = future.find(function (o) {
            return String(o && o.scheduleId) === String(scheduleId) && String(o && o.dateLocal) === String(dateLocal);
        });
        if (!row) {
            row = future.find(function (o) { return String(o && o.dateLocal) === String(dateLocal); }) || future[0];
            scheduleId = row.scheduleId;
            dateLocal = row.dateLocal;
        }
        var modal = document.getElementById("occurrenceEditModal");
        if (!(modal instanceof HTMLElement)) return;
        var ath = document.getElementById("occurrenceEditAthlete");
        if (ath instanceof HTMLElement) ath.textContent = "Müştəri: " + _currentInfoAthleteName;
        _occurrenceEditCreateSessionAfterSave = Boolean(prefill?.createSessionAfterSave);
        populateOccurrenceEditDateSelect(scheduleId, dateLocal);
        syncOccurrenceEditFieldsFromRow(row, prefill);
        setOccurrenceEditHint("", "");
        modal.style.display = "block";
        if (typeof window.applyFlatpickrAz === "function") {
            window.applyFlatpickrAz(modal);
        }
        applyOccurrenceEditDateBounds(scheduleId);
        syncOccurrenceEditDateHint();
    }

    async function createSessionAfterOccurrenceEdit(dateLocal, startTimeLocal, durationMinutes, laneNumber) {
        var athleteId = _currentInfoAthleteId;
        if (!athleteId) return { ok: false, error: "Müştəri tapılmadı." };
        try {
            var activeRes = await apiFetch("/sessions/active-by-athlete/" + encodeURIComponent(athleteId), { timeoutMs: 30000 });
            if (activeRes.ok) {
                return { ok: true, skipped: true };
            }
        } catch { /* ignore */ }
        var parts = String(dateLocal).split("-").map(Number);
        var timeParts = String(startTimeLocal).split(":").map(Number);
        if (parts.length < 3 || timeParts.length < 2) return { ok: false, error: "Tarix və ya saat yanlışdır." };
        var localStart = new Date(parts[0], parts[1] - 1, parts[2], timeParts[0], timeParts[1], 0, 0);
        var equipPayload = typeof buildSessionEquipmentPayload === "function" ? buildSessionEquipmentPayload() : {};
        try {
            var res = await apiFetch("/sessions", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                timeoutMs: 90000,
                body: JSON.stringify({
                    athleteId: athleteId,
                    laneNumber: laneNumber,
                    preferredLaneType: preferredLaneTypeFromLane(laneNumber),
                    startTimeUtc: localStart.toISOString(),
                    durationMinutes: durationMinutes,
                    ...equipPayload
                })
            });
            if (!res.ok) {
                var msg = await readErrorMessage(res);
                return { ok: false, error: msg || "Sessiya yaradılmadı." };
            }
            return { ok: true };
        } catch (e) {
            return { ok: false, error: getExceptionMessage(e) };
        }
    }

    async function saveOccurrenceOverride() {
        var sel = document.getElementById("occurrenceEditDateSelect");
        var sidEl = document.getElementById("occurrenceEditScheduleId");
        var dEl = document.getElementById("occurrenceEditDateLocal");
        var targetDateEl = document.getElementById("occurrenceEditTargetDate");
        if (sel instanceof HTMLSelectElement && sel.value) {
            var parts = sel.value.split("|");
            if (parts.length >= 2) {
                if (sidEl instanceof HTMLInputElement) sidEl.value = parts[0];
                if (dEl instanceof HTMLInputElement) dEl.value = parts[1];
            }
        }
        var sid = sidEl instanceof HTMLInputElement ? sidEl.value.trim() : "";
        var sourceDateLocal = dEl instanceof HTMLInputElement ? dEl.value.trim() : "";
        var targetDateLocal = targetDateEl instanceof HTMLInputElement ? targetDateEl.value.trim() : "";
        var startTimeLocal = String(document.getElementById("occurrenceEditStartTime")?.value || "").trim();
        var duration = Number(document.getElementById("occurrenceEditDuration")?.value || 0);
        var laneNumber = Number(document.getElementById("occurrenceEditLaneNumber")?.value || 0);
        if (!sid || !sourceDateLocal) return;
        if (!targetDateLocal) { setOccurrenceEditHint("Seans tarixini seçin.", "error"); return; }
        if (!startTimeLocal) { setOccurrenceEditHint("Saatı daxil edin.", "error"); return; }
        if (!Number.isInteger(duration) || duration <= 0) { setOccurrenceEditHint("Paket müddəti tapılmadı.", "error"); return; }
        if (!Number.isInteger(laneNumber) || laneNumber <= 0) { setOccurrenceEditHint("Zolaq seçin.", "error"); return; }

        var bounds = getOccurrenceEditDateBounds(sid);
        if (bounds.min && targetDateLocal < bounds.min) {
            setOccurrenceEditHint("Tarix bu gündən əvvəl ola bilməz.", "error");
            return;
        }
        if (bounds.max && targetDateLocal > bounds.max) {
            setOccurrenceEditHint("Tarix paket sonundan sonra ola bilməz.", "error");
            return;
        }

        var isReschedule = targetDateLocal !== sourceDateLocal;
        var sessionDateLocal = isReschedule ? targetDateLocal : sourceDateLocal;
        var createSession = _occurrenceEditCreateSessionAfterSave;
        setOccurrenceEditHint("Yadda saxlanılır...", "warn");
        try {
            var res;
            if (isReschedule) {
                res = await apiFetch("/subscriptions/schedules/" + encodeURIComponent(sid) + "/reschedule-occurrence", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        sourceDateLocal: sourceDateLocal,
                        targetDateLocal: targetDateLocal,
                        startTimeLocal: startTimeLocal,
                        laneNumber: laneNumber,
                        durationMinutes: duration
                    })
                });
            } else {
                res = await apiFetch("/subscriptions/schedules/" + encodeURIComponent(sid) + "/occurrence-override", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        dateLocal: sourceDateLocal,
                        startTimeLocal: startTimeLocal,
                        laneNumber: laneNumber,
                        durationMinutes: duration
                    })
                });
            }
            if (!res.ok) {
                var msg = await readErrorMessage(res);
                setOccurrenceEditHint(msg || "Yadda saxlanılmadı.", "error");
                return;
            }

            if (createSession) {
                var sessionResult = await createSessionAfterOccurrenceEdit(sessionDateLocal, startTimeLocal, duration, laneNumber);
                if (!sessionResult.ok) {
                    setOccurrenceEditHint("Abunə yeniləndi, amma sessiya yaradılmadı: " + (sessionResult.error || ""), "warn");
                    await infoShow();
                    return;
                }
            }

            setOccurrenceEditHint(isReschedule ? "Seans yeni tarixə köçürüldü və yazıldı." : "Uğurla yadda saxlanıldı.", "ok");
            _occurrenceEditCreateSessionAfterSave = false;
            await infoShow();
            if (createSession) {
                clearReceptionPersonFields();
                await refreshReceptionPanelData();
            }
            setTimeout(closeOccurrenceEditModal, 600);
        } catch (e) {
            setOccurrenceEditHint("Xəta: " + getExceptionMessage(e), "error");
        }
    }

