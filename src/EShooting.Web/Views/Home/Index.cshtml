    async function persistClubCardValuesToAthlete(athleteId, cardNumber, cardType) {
        if (!athleteId) return false;
        const card = (cardNumber ?? "").toString().trim();
        if (!card || cardType === null || cardType === undefined || cardType === "") return false;
        try {
            const res = await apiFetch(`/athletes/${encodeURIComponent(athleteId)}`, { timeoutMs: 20000 });
            if (!res.ok) return false;
            const data = await res.json();
            const put = await apiFetch(`/athletes/${encodeURIComponent(athleteId)}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    firstName: data?.firstName ?? "",
                    lastName: data?.lastName ?? "",
                    phoneNumber: data?.phoneNumber ?? "",
                    email: data?.email ?? "",
                    idCardNumber: data?.idCardNumber ?? "",
                    clubCardNumber: card,
                    clubCardType: Number(cardType),
                    category: Number(data?.category ?? 0),
                    isSubscriber: Boolean(data?.isSubscriber),
                    membershipType: Number(data?.membershipType ?? 0),
                    isVip: Boolean(data?.isVip)
                })
            });
            if (put.ok) {
                if (clubCardNumberInput instanceof HTMLInputElement) clubCardNumberInput.value = card;
                if (clubCardTypeInput instanceof HTMLSelectElement) clubCardTypeInput.value = String(cardType);
                try { refreshSelectedCustomerCard(); } catch { }
            }
            return put.ok;
        } catch {
            return false;
        }
    }

    function readPlannedPanelCard(sessionId) {
        if (!(plannedSessionsBody instanceof HTMLElement) || !sessionId) {
            return { hasCard: false, cardNumber: "", cardType: null };
        }
        const popover = plannedSessionsBody.querySelector(
            `.planned-lane-popover[data-planned-lane-pick-for="${CSS.escape(String(sessionId))}"]`
        );
        if (!(popover instanceof HTMLElement)) {
            return { hasCard: false, cardNumber: "", cardType: null };
        }
        if (popover.getAttribute("data-card-ready") === "1") {
            return { hasCard: true, cardNumber: "", cardType: null, alreadyOnAthlete: true };
        }
        const typeSel = popover.querySelector("[data-planned-card-type]");
        const numInp = popover.querySelector("[data-planned-card-number]");
        const cardType = readClubCardTypeValue(typeSel);
        const cardNumber = (numInp instanceof HTMLInputElement ? numInp.value : "").trim();
        return {
            hasCard: Boolean(cardNumber) && cardType !== null,
            cardNumber,
            cardType
        };
    }

    async function ensurePlannedActivateCard(sessionId, athleteId) {
        const panel = readPlannedPanelCard(sessionId);
        if (panel.alreadyOnAthlete) return true;
        if (panel.hasCard) {
            const ok = await persistClubCardValuesToAthlete(athleteId, panel.cardNumber, panel.cardType);
            if (!ok) {
                alert("Kart təqdim edilməyib");
                return false;
            }
            return true;
        }
        if (receptionHasClubCardAssigned()) {
            return persistReceptionClubCardToAthlete(athleteId);
        }
        if (athleteId) {
            const status = await fetchAthleteClubCardStatus(athleteId);
            if (status.hasCard) return true;
        }
        alert("Kart təqdim edilməyib");
        return false;
    }

    async function probePlannedAvailableLanes(sessionId) {
        const probe = await apiFetch(`/sessions/${encodeURIComponent(sessionId)}/activate`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ laneNumber: 0 })
        });
        if (probe.ok) {
            // Gözlənilməz uğur — zolaq artıq təyinli ola bilər.
            return { activated: true, lanes: [], error: null, athleteCategory: null, athleteCategoryLabel: null };
        }
        const data = await probe.json().catch(() => ({}));
        const lanes = Array.isArray(data?.availableLaneNumbers) ? data.availableLaneNumbers : [];
        return {
            activated: false,
            lanes,
            error: data?.error || await readErrorMessage(probe) || "Boş zolaq yoxdur.",
            athleteCategory: data?.athleteCategory ?? null,
            athleteCategoryLabel: data?.athleteCategoryLabel ?? null
        };
    }

    function formatAthleteCategoryLabel(categoryRaw, labelRaw) {
