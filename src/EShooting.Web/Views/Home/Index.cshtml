    async function tryAutofillReceptionFromLookup() {
        if (isAutoFillingReception) return;
        const phoneQ = normalizeDigits(phoneNumberInput?.value);
        const emailQ = normalizeText(emailInput?.value);
        const idQ = normalizeText(idCardNumberInput?.value);

        // Minimum input lengths to avoid noisy matches
        const hasQuery = (phoneQ && phoneQ.length >= 3) || (emailQ && emailQ.length >= 4) || (idQ && idQ.length >= 3);
        if (!hasQuery) {
            receptionMatchedAthleteId = null;
            receptionMatchedSnapshot = null;
            syncUpdateAthleteButton();
            setLookupHint("");
            return;
        }

        let best = null;
        try {
            const qs = new URLSearchParams();
            if (phoneQ) qs.set("phone", phoneQ);
            if (emailQ) qs.set("email", emailQ);
            if (idQ) qs.set("idCardNumber", idQ);
            const res = await apiFetch(`/athletes/lookup?${qs.toString()}`);
            if (!res.ok) {
                // Not found or error: clear selection but keep typed data
                receptionMatchedAthleteId = null;
                receptionMatchedSnapshot = null;
                syncUpdateAthleteButton();
                setLookupHint("Müştəri tapılmadı.");
                return;
            }
            best = await res.json();
        } catch {
            return;
        }

        if (!best) return;

        isAutoFillingReception = true;
        try {
            receptionMatchedAthleteId = best.id ?? null;
            if (firstNameInput instanceof HTMLInputElement) firstNameInput.value = best.firstName ?? (best.fullName?.split(" ")[0] ?? "");
            if (lastNameInput instanceof HTMLInputElement) lastNameInput.value = best.lastName ?? (best.fullName?.split(" ").slice(1).join(" ") ?? "");
            if (phoneNumberInput instanceof HTMLInputElement) phoneNumberInput.value = best.phoneNumber ?? "";
            if (emailInput instanceof HTMLInputElement) emailInput.value = best.email ?? "";
            if (idCardNumberInput instanceof HTMLInputElement) idCardNumberInput.value = best.idCardNumber ?? "";
            if (clubCardNumberInput instanceof HTMLInputElement) clubCardNumberInput.value = best.clubCardNumber ?? "";
            if (clubCardTypeInput instanceof HTMLSelectElement) clubCardTypeInput.value = clubCardTypeToSelectValue(best.clubCardType);
            if (categoryInput instanceof HTMLSelectElement && best.category !== undefined && best.category !== null && String(best.category) !== "") {
                // server returns enum as string (e.g., "Amateur") OR number; handle both
                const catVal = typeof best.category === "number"
                    ? String(best.category)
                    : (String(best.category).toLowerCase() === "amateur" ? "0" : String(best.category).toLowerCase() === "professional" ? "1" : "2");
                categoryInput.value = catVal;
                refreshLaneOptions();
            }
            if (membershipTypeInput instanceof HTMLSelectElement && best.membershipType !== undefined && best.membershipType !== null && String(best.membershipType) !== "") {
                const mVal = membershipToSelectValue(best.membershipType);
                membershipTypeInput.value = mVal;
                const access = accessFromMembershipType(mVal);
                if (includesLaneInput instanceof HTMLInputElement) includesLaneInput.checked = access.shooting;
                if (includesShootingInput instanceof HTMLInputElement) includesShootingInput.checked = access.shooting;
                if (includesGymInput instanceof HTMLInputElement) includesGymInput.checked = access.gym;
            }
            if (isVipInput instanceof HTMLInputElement) {
                isVipInput.checked = Boolean(best.isVip);
            }
            receptionMatchedSnapshot = buildReceptionCurrentSnapshot();
            const displayName = (best.fullName ?? `${best.firstName ?? ""} ${best.lastName ?? ""}`.trim()) || "—";
            if (customerSearchInput instanceof HTMLInputElement && displayName !== "—") {
                customerSearchInput.value = displayName;
            }
            setLookupHint(`Müştəri tapıldı: ${displayName}`);
            applyReceptionWalkInFromAthlete(best);
            refreshSelectedCustomerCard();
            syncUpdateAthleteButton();
        } finally {
            isAutoFillingReception = false;
        }
    }

    async function updateAthleteFromReception(opts = {}) {
        const id = receptionMatchedAthleteId;
        if (!id) {
            alert("Yeniləmə üçün bazadan seçilmiş şəxs yoxdur (axtarış edin).");
            return false;
        }

        const firstName = firstNameInput?.value?.trim() ?? "";
        const lastName = lastNameInput?.value?.trim() ?? "";
        const phoneNumber = phoneNumberInput?.value?.trim() ?? "";
        if (!hasRequiredCustomerContactFields()) {
            alert(customerRequiredFieldsMessage);
            return false;
        }

        const membershipTypeRaw = membershipTypeInput?.value || membershipValueFromPackage(getSelectedBookingPackage()) || "0";
        const categoryRaw = categoryInput?.value ?? "";
        if (!categoryRaw) { alert("Kateqoriya seçin."); return false; }

        const clubCardNumber = clubCardNumberInput?.value?.trim() || "";
        const clubCardType = readClubCardTypeValue(clubCardTypeInput);
        if (!validateClubCardFields(clubCardNumber, clubCardType)) return false;

        const response = await apiFetch(`/athletes/${encodeURIComponent(id)}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                firstName,
                lastName,
                phoneNumber,
                email: emailInput?.value?.trim() || "",
                idCardNumber: idCardNumberInput?.value?.trim() || "",
                clubCardNumber,
                clubCardType,
                category: Number(categoryRaw),
                isSubscriber: registrationModeInput?.value === "subscription",
                membershipType: Number(membershipTypeRaw),
                isVip: Boolean(isVipInput?.checked)
            })
        });

        if (!response.ok) {
            const message = await readErrorMessage(response);
            alert(message);
            return false;
        }

        const data = await response.json().catch(() => ({}));
        if (!opts?.silentSuccess) {
            alert(data?.message || "Məlumatlar uğurla yeniləndi.");
        }
        // refresh cache immediately
        allAthletesCache = [];
        athletesCacheLoadedAtMs = 0;
        await ensureAthletesCacheFresh();
        receptionMatchedSnapshot = buildReceptionCurrentSnapshot();
        setLookupHint(`Məlumatlar yeniləndi: ${(firstNameInput?.value ?? "").trim()} ${(lastNameInput?.value ?? "").trim()}`.trim());
        syncUpdateAthleteButton();
        return true;
    }

    // Backenddən gələn idmançını reception xanalarına yerləşdirir və "matched" snapshot-u qurur.
    async function applyAthleteToReception(best) {
        console.log("[autocomplete] applyAthleteToReception çağrıldı", best);
        if (!best) {
            console.warn("[autocomplete] applyAthleteToReception: boş obyekt verildi", best);
            return;
        }
        isAutoFillingReception = true;
        try {
            receptionMatchedAthleteId = best.id || null;

            const fullName = best.fullName || "";
            const fnFromFull = fullName ? fullName.split(" ")[0] : "";
            const lnFromFull = fullName ? fullName.split(" ").slice(1).join(" ") : "";

            // Sadə dəyər təyini: heç bir hadisə dispatch etmirik ki, başqa listenerlər
            // nəyisə təkrar yoxlamaya başlamasın və dəyərləri silməsin.
            if (firstNameInput instanceof HTMLInputElement) {
                firstNameInput.value = best.firstName != null ? best.firstName : fnFromFull;
            }
            if (lastNameInput instanceof HTMLInputElement) {
                lastNameInput.value = best.lastName != null ? best.lastName : lnFromFull;
            }
            if (phoneNumberInput instanceof HTMLInputElement) {
                phoneNumberInput.value = best.phoneNumber || "";
            }
            if (emailInput instanceof HTMLInputElement) {
                emailInput.value = best.email || "";
            }
            if (idCardNumberInput instanceof HTMLInputElement) {
                idCardNumberInput.value = best.idCardNumber || "";
            }
            if (clubCardNumberInput instanceof HTMLInputElement) {
                clubCardNumberInput.value = best.clubCardNumber || "";
            }
            if (clubCardTypeInput instanceof HTMLSelectElement) {
                clubCardTypeInput.value = clubCardTypeToSelectValue(best.clubCardType);
            }

            if (categoryInput instanceof HTMLSelectElement && best.category !== undefined && best.category !== null && String(best.category) !== "") {
                const catRaw = best.category;
                const catVal = (typeof catRaw === "number")
                    ? String(catRaw)
                    : (String(catRaw).toLowerCase() === "amateur" ? "0"
                        : String(catRaw).toLowerCase() === "professional" ? "1"
                        : String(catRaw).toLowerCase() === "coach" ? "2"
                        : String(catRaw));
                categoryInput.value = catVal;
                try { refreshLaneOptions(); } catch (e) { /* ignore */ }
            }
            if (membershipTypeInput instanceof HTMLSelectElement && best.membershipType !== undefined && best.membershipType !== null && String(best.membershipType) !== "") {
                const mVal = membershipToSelectValue(best.membershipType);
                membershipTypeInput.value = mVal;
                const access = accessFromMembershipType(mVal);
                if (includesLaneInput instanceof HTMLInputElement) includesLaneInput.checked = access.shooting;
                if (includesShootingInput instanceof HTMLInputElement) includesShootingInput.checked = access.shooting;
                if (includesGymInput instanceof HTMLInputElement) includesGymInput.checked = access.gym;
            }
            if (isVipInput instanceof HTMLInputElement) {
                isVipInput.checked = Boolean(best.isVip);
            }

            receptionMatchedSnapshot = buildReceptionCurrentSnapshot();
            const displayName = fullName || (`${best.firstName || ""} ${best.lastName || ""}`).trim() || "—";
            if (customerSearchInput instanceof HTMLInputElement) {
                customerSearchInput.value = displayName === "—" ? "" : displayName;
            }
            setLookupHint(`Müştəri seçildi: ${displayName}`);
            syncUpdateAthleteButton();
            applyReceptionWalkInFromAthlete(best);
            await refreshReceptionWalkInStatus(receptionMatchedAthleteId);
            try { syncSubscriptionAthleteNameFromReception(); } catch (e) { /* ignore */ }
            refreshSelectedCustomerCard();
            syncGroupAddButtonUi();
            console.log("[autocomplete] xanalar dolduruldu", {
                first: firstNameInput && firstNameInput.value,
                last: lastNameInput && lastNameInput.value,
                phone: phoneNumberInput && phoneNumberInput.value,
                email: emailInput && emailInput.value,
                idCard: idCardNumberInput && idCardNumberInput.value
            });
        } catch (err) {
            console.error("[autocomplete] applyAthleteToReception failed", err);
        } finally {
            isAutoFillingReception = false;
        }
    }

    // ====== Reception sahələri üçün avtomatik tamamlama (yazdıqca açılan siyahı) ======
    const _athleteSuggestEl = (function () {
        const el = document.createElement("div");
        el.className = "athlete-suggest";
        el.style.display = "none";
        el.setAttribute("role", "listbox");
        document.body.appendChild(el);
        return el;
    })();
    let _athleteSuggestAnchor = null;
    let _athleteSuggestItems = [];

    function hideAthleteSuggest() {
        _athleteSuggestEl.style.display = "none";
        _athleteSuggestEl.innerHTML = "";
        _athleteSuggestAnchor = null;
        _athleteSuggestItems = [];
    }

    function escapeForHtml(s) {
        return String(s ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function renderAthleteSuggestItems(items) {
        // Köhnə listenerlərin yığılmaması üçün hər render əvvəli içəriyi tamamilə təmizləyirik.
        while (_athleteSuggestEl.firstChild) {
            _athleteSuggestEl.removeChild(_athleteSuggestEl.firstChild);
        }
        if (!Array.isArray(items) || items.length === 0) {
            const empty = document.createElement("div");
            empty.className = "athlete-suggest__empty";
            empty.textContent = "Uyğun nəticə yoxdur";
            _athleteSuggestEl.appendChild(empty);
            return;
        }

        items.forEach(function (it) {
            const fullName = it.fullName || (`${it.firstName || ""} ${it.lastName || ""}`).trim() || "—";
            const isInactive = it.isActive === false;
            const row = document.createElement("div");
            row.className = "athlete-suggest__row" + (isInactive ? " is-inactive" : "");
            if (isInactive) {
                row.style.opacity = "0.85";
            }

            const nameEl = document.createElement("div");
            nameEl.className = "athlete-suggest__name";
            nameEl.textContent = fullName
                + (it.isVip ? " · VIP" : "")
                + (isInactive ? " · (Silinmişlər)" : "");
            row.appendChild(nameEl);

            const metaParts = [];
            if (it.phoneNumber) metaParts.push(it.phoneNumber);
            if (it.email) metaParts.push(it.email);
            if (it.idCardNumber) metaParts.push("FİN: " + it.idCardNumber);
            if (metaParts.length) {
                const meta = document.createElement("div");
                meta.className = "athlete-suggest__meta";
                meta.textContent = metaParts.join(" · ");
                row.appendChild(meta);
            }

            // Birbaşa hər sətrə öz handler-i — delegasiya yox.
            const onSelect = function (ev) {
                if (ev) {
                    try { ev.preventDefault(); } catch (e) { /* ignore */ }
                    try { ev.stopPropagation(); } catch (e) { /* ignore */ }
                }
                if (isInactive) {
                    alert("Bu şəxs «Silinmişlər» siyahısındadır. Yenidən aktiv etmək üçün adminə müraciət edin.");
                    hideAthleteSuggest();
                    return;
                }
                applyAthleteToReception(it);
                hideAthleteSuggest();
            };
            row.addEventListener("mousedown", function (ev) {
                _isClickingAthleteSuggest = true;
                onSelect(ev);
            });
            row.addEventListener("touchend", function (ev) { onSelect(ev); });

            _athleteSuggestEl.appendChild(row);
        });
    }

    function positionAthleteSuggest(anchorInput) {
        if (!(anchorInput instanceof HTMLElement)) return;
        const rect = anchorInput.getBoundingClientRect();
        const top = rect.bottom + 4;
        const maxLeft = Math.max(8, window.innerWidth - 320);
        const left = Math.min(rect.left, maxLeft);
        _athleteSuggestEl.style.top = top + "px";
        _athleteSuggestEl.style.left = left + "px";
        _athleteSuggestEl.style.minWidth = Math.max(260, rect.width) + "px";
    }

    async function fetchAthleteSearch(q) {
        try {
            const res = await apiFetch(`/athletes/search?q=${encodeURIComponent(q)}&limit=10`);
            if (!res.ok) return [];
            const list = await res.json();
            return Array.isArray(list) ? list : [];
        } catch (e) { return []; }
    }

    const debouncedAthleteSearch = debounce(async function (input) {
        if (!(input instanceof HTMLInputElement)) return;
        // Avtomatik dolduran zaman yenidən axtarış göstərmək lazım deyil.
        if (isAutoFillingReception) return;
        const q = (input.value || "").trim();
        if (q.length < 2) { hideAthleteSuggest(); return; }
        const items = await fetchAthleteSearch(q);
        // İstifadəçi başqa xanaya keçibsə, nəticə artıq aktual deyil.
        if (document.activeElement !== input) return;
        _athleteSuggestItems = items;
        _athleteSuggestAnchor = input;
        renderAthleteSuggestItems(items);
        positionAthleteSuggest(input);
        _athleteSuggestEl.style.display = "block";
    }, 180);

    let _isClickingAthleteSuggest = false;

    function attachAthleteAutocomplete() {
        const inputs = [customerSearchInput]
            .filter(x => x instanceof HTMLInputElement);
        inputs.forEach(function (input) {
            input.addEventListener("input", function () { debouncedAthleteSearch(input); });
            input.addEventListener("focus", function () {
                const q = (input.value || "").trim();
                if (q.length >= 2) debouncedAthleteSearch(input);
            });
            input.addEventListener("blur", function () {
                // Popover sətri üzərinə klik edirsə blur-da bağlama (mousedown _isClickingAthleteSuggest qoyur).
                setTimeout(function () {
                    if (_isClickingAthleteSuggest) {
                        _isClickingAthleteSuggest = false;
                        return;
                    }
                    hideAthleteSuggest();
                }, 200);
            });
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") hideAthleteSuggest();
        });
        // Pəncərə resize / scroll olduqda popover yerini itirməsin deyə bağlayırıq.
        window.addEventListener("resize", hideAthleteSuggest);
        document.addEventListener("scroll", function (e) {
            // Popover öz daxili scroll-u olarsa onu nəzərə alma.
            if (_athleteSuggestEl.contains(e.target)) return;
            hideAthleteSuggest();
        }, true);

        // Pəncərənin başqa yerində klik olarsa popoveri bağla.
        document.addEventListener("mousedown", function (e) {
            const t = e.target;
            if (!(t instanceof Node)) return;
            if (_athleteSuggestEl.contains(t)) return; // popoverin öz daxili klik
            if (inputs.some(function (inp) { return inp === t; })) return; // input özüdür
            hideAthleteSuggest();
        });
    }

    function debounce(fn, waitMs) {
        let t = null;
        return (...args) => {
            if (t) clearTimeout(t);
            t = setTimeout(() => fn(...args), waitMs);
        };
    }

    function containsAtSign(value) {
        return String(value ?? "").indexOf("\u0040") >= 0;
    }

    async function resolveManageCustomerLookupFields() {
        let phone = normalizeDigits(phoneNumberInput?.value ?? "");
        let email = normalizeText(emailInput?.value ?? "");
        let idCardNumber = normalizeText(idCardNumberInput?.value ?? "");
        const searchRaw = (customerSearchInput?.value ?? "").trim();

        if (searchRaw) {
            const searchDigits = normalizeDigits(searchRaw);
            if (searchDigits.length >= 7) {
                phone = phone || searchDigits;
            } else if (containsAtSign(searchRaw)) {
                email = email || searchRaw.toLowerCase();
            }
        }

        if (!phone && !email && !idCardNumber && receptionMatchedAthleteId) {
            try {
                const athlete = await fetchAthleteById(receptionMatchedAthleteId);
                if (athlete) {
                    phone = phone || normalizeDigits(athlete.phoneNumber ?? "");
                    email = email || normalizeText(athlete.email ?? "");
                    idCardNumber = idCardNumber || normalizeText(athlete.idCardNumber ?? "");
                }
            } catch { /* ignore */ }
        }

        if (!phone && !email && !idCardNumber && searchRaw.length >= 2) {
            try {
                const lookupQs = new URLSearchParams();
                const searchDigits = normalizeDigits(searchRaw);
                if (searchDigits.length >= 7) lookupQs.set("phone", searchDigits);
                if (containsAtSign(searchRaw)) lookupQs.set("email", searchRaw.toLowerCase());
                if ([...lookupQs.keys()].length) {
                    const lookupRes = await apiFetch(`/athletes/lookup?${lookupQs.toString()}`, { timeoutMs: 20000 });
                    if (lookupRes.ok) {
                        const found = await lookupRes.json();
                        phone = phone || normalizeDigits(found?.phoneNumber ?? "");
                        email = email || normalizeText(found?.email ?? "");
                        idCardNumber = idCardNumber || normalizeText(found?.idCardNumber ?? "");
                    }
                }
                if (!phone && !email && !idCardNumber) {
                    const searchRes = await apiFetch(`/athletes/search?q=${encodeURIComponent(searchRaw)}&limit=5`, { timeoutMs: 20000 });
                    if (searchRes.ok) {
                        const items = await searchRes.json().catch(() => []);
                        const first = Array.isArray(items) && items.length ? items[0] : null;
                        if (first) {
                            phone = normalizeDigits(first.phoneNumber ?? "");
                            email = normalizeText(first.email ?? "");
                            idCardNumber = normalizeText(first.idCardNumber ?? "");
                        }
                    }
                }
            } catch { /* ignore */ }
        }

        if (infoPhone instanceof HTMLInputElement) infoPhone.value = phone;
        if (infoEmail instanceof HTMLInputElement) infoEmail.value = email;
        if (infoIdCard instanceof HTMLInputElement) infoIdCard.value = idCardNumber;

        return Boolean(phone || email || idCardNumber);
    }

