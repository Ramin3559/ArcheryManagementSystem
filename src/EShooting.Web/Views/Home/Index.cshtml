    async function refreshDayStats() {
        try {
            const res = await apiFetch("/dashboard/day-stats", { timeoutMs: 15000 });
            if (!res.ok) return;
            const s = await res.json();
            if (incomingCustomersTodayEl) incomingCustomersTodayEl.textContent = String(s.incomingCustomersToday ?? 0);
            if (activeSessionsEl) activeSessionsEl.textContent = String(s.activeSessions ?? 0);
            if (scheduledSessionsEl) scheduledSessionsEl.textContent = String(s.scheduledSessionsToday ?? 0);
            if (completedSessionsEl) completedSessionsEl.textContent = String(s.completedSessionsToday ?? 0);
        } catch (e) {
