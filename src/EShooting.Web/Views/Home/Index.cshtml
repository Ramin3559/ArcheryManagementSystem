        }

        const data = await response.json();
        sessionInfo.textContent = `Abunəlik dayandırıldı. Söndürülən plan sayı: ${data.cancelledSchedules}`;
        closeCancelSubscriptionModal();
        try { allAthletesCache = []; } catch { }
        try { athletesCacheLoadedAtMs = 0; } catch { }
        await ensureAthletesCacheFresh();
        return true;
    }

    async function readErrorMessage(response) {
        const raw = await response.text();
        if (!raw) {
            return "Naməlum xəta";
        }

        try {
            const parsed = JSON.parse(raw);
            if (parsed?.error) {
                return parsed.error;
            }

            const validationErrors = parsed?.errors;
            if (validationErrors && typeof validationErrors === "object") {
                const parts = [];
                for (const [field, messages] of Object.entries(validationErrors)) {
                    const list = Array.isArray(messages) ? messages : [messages];
                    for (const msg of list) {
                        if (msg) parts.push(`${field}: ${msg}`);
                    }
                }
                if (parts.length) {
                    return parts.join("\n");
                }
            }

            return parsed?.title ?? raw;
        } catch {
            return raw;
        }
    }

    function getExceptionMessage(error) {
        if (error instanceof Error && error.message) {
            return error.message;
        }

        return "Naməlum xəta";
    }

    function isRingSessionActivated(ringEl) {
        if (!(ringEl instanceof HTMLElement)) return true;
        return ringEl.dataset.activated !== "0";
    }

    function isPlannedLaneRing(ringEl, status) {
        return status === "Scheduled" || !isRingSessionActivated(ringEl);
    }

    function updateCountdownRings() {
        document.querySelectorAll("[data-countdown-ring]").forEach(el => {
            if (!(el instanceof HTMLElement)) {
                return;
            }

            const start = el.dataset.start ?? "";
            const end = el.dataset.end ?? "";
            const status = el.dataset.status ?? "";
            const pendingRental = el.dataset.pendingRentalEquipment === "1";
            const timerEl = el.querySelector("[data-role=\"timer\"]");
            const captionEl = el.querySelector("[data-role=\"caption\"]");
            const progressEl = el.querySelector(".countdown-ring__progress");
            if (!timerEl || !(progressEl instanceof SVGGraphicsElement)) {
                return;
            }

            const card = el.closest(".lane-card");
            const bottomHint = card instanceof HTMLElement ? card.querySelector("[data-role=\"lane-bottom-hint\"]") : null;
            const setBottomHint = (text, kind) => {
                if (!(bottomHint instanceof HTMLElement)) return;
                bottomHint.textContent = text || "";
                bottomHint.classList.toggle("is-show", Boolean(text));
                bottomHint.classList.toggle("is-warn", kind === "warn");
                bottomHint.classList.toggle("is-critical", kind === "critical");
            };
            const setEquipmentReturnHint = () => {
                if (pendingRental) {
                    setBottomHint("Avadanlıq təhvil alınmalıdır", "critical");
                    return true;
                }
                return false;
            };

            el.classList.remove("is-live", "is-pending", "is-warn", "is-critical", "is-done", "is-idle", "is-open-ended");

            const vipMode = isOpenEndedRing(el);
            if (vipMode && start) {
                const startMs = parseApiDate(start).getTime();
                const nowMs = Date.now();

                if (isPlannedLaneRing(el, status)) {
                    el.classList.add("is-pending", "is-open-ended");
                    timerEl.textContent = (typeof BakuTime !== "undefined")
                        ? BakuTime.formatBakuFromUtcMs(startMs, false)
                        : new Date(startMs).toLocaleTimeString("az-AZ", { hour: "2-digit", minute: "2-digit" });
                    if (captionEl) captionEl.textContent = "Planlı";
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 1);
                    return;
                }

                if (status === "Completed") {
                    el.classList.add("is-done");
                    timerEl.textContent = "Bitib";
                    if (captionEl) captionEl.textContent = "Sessiya";
                    if (!setEquipmentReturnHint()) setBottomHint("", "");
                    applyRingRemaining(progressEl, 0);
                    return;
                }

                if (Number.isNaN(startMs)) {
                    el.classList.add("is-idle");
                    timerEl.textContent = "—";
                    if (captionEl) captionEl.textContent = "Boş";
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 0);
                    return;
                }

                if (nowMs < startMs) {
                    el.classList.add("is-pending", "is-open-ended");
                    timerEl.textContent = (typeof BakuTime !== "undefined")
                        ? BakuTime.formatBakuFromUtcMs(startMs, false)
                        : new Date(startMs).toLocaleTimeString("az-AZ", { hour: "2-digit", minute: "2-digit" });
                    if (captionEl) captionEl.textContent = "Başlayır";
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 1);
                    return;
                }

                el.classList.add("is-live", "is-open-ended");
                const elapsedMs = Math.max(0, nowMs - startMs);
                timerEl.textContent = formatSeconds(elapsedMs);
                if (captionEl) captionEl.textContent = "Keçən vaxt";
                setBottomHint("", "");
                applyRingRemaining(progressEl, 1);
                return;
            }

            const startMs = parseApiDate(start).getTime();
            const endMs = parseApiDate(end).getTime();
            const nowMs = Date.now();
            const timedSession = hasValidTimeWindow(startMs, endMs);
            const totalMs = timedSession ? endMs - startMs : 0;

            if (!start || !end || !timedSession) {
                if (isPlannedLaneRing(el, status)) {
                    el.classList.add("is-pending");
                    const untilStartMs = Number.isFinite(startMs) ? Math.max(0, startMs - nowMs) : 0;
                    timerEl.textContent = untilStartMs > 0 ? formatSeconds(untilStartMs) : "—";
                    if (captionEl) {
                        captionEl.textContent = untilStartMs > 0 ? "Başlayır" : "Planlı";
                    }
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 1);
                    return;
                }

                if (status === "Completed") {
                    el.classList.add("is-done");
                    timerEl.textContent = "Bitib";
                    if (captionEl) {
                        captionEl.textContent = "Sessiya";
                    }
                    if (!setEquipmentReturnHint()) {
                        setBottomHint("", "");
                    }
                    applyRingRemaining(progressEl, 0);
                    return;
                }

                if (status === "Active") {
                    el.classList.add("is-live");
                    const elapsedMs = Number.isFinite(startMs)
                        ? Math.max(0, nowMs - startMs)
                        : 0;
                    timerEl.textContent = formatSeconds(elapsedMs);
                    if (captionEl) {
                        captionEl.textContent = "Keçən vaxt";
                    }
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 1);
                    return;
                }

                el.classList.add("is-idle");
                timerEl.textContent = "—";
                if (captionEl) {
                    captionEl.textContent = "Boş";
                }
                setBottomHint("", "");
                applyRingRemaining(progressEl, 0);
                return;
            }

            if (isPlannedLaneRing(el, status)) {
                el.classList.add("is-pending");
                const startLocal = new Date(startMs);
                timerEl.textContent = startLocal.toLocaleTimeString("az-AZ", { hour: "2-digit", minute: "2-digit" });
                if (captionEl) {
                    captionEl.textContent = "Planlı";
                }
                setBottomHint("", "");
                applyRingRemaining(progressEl, 1);
                return;
            }

            if (status === "Completed") {
                el.classList.add("is-done");
                timerEl.textContent = "Bitib";
                if (captionEl) {
                    captionEl.textContent = "Sessiya";
                }
                if (!setEquipmentReturnHint()) {
                    setBottomHint("", "");
                }
                applyRingRemaining(progressEl, 0);
                return;
            }

            if (nowMs < startMs) {
                el.classList.add("is-pending");
                const untilMs = startMs - nowMs;
                const untilSec = Math.floor(untilMs / 1000);
                const startLocal = new Date(startMs);

                // Prevent absurd countdowns (e.g., bad time zones or far future): show planned time instead.
                if (untilSec > 24 * 3600) {
                    timerEl.textContent = startLocal.toLocaleTimeString("az-AZ", { hour: "2-digit", minute: "2-digit" });
                    if (captionEl) captionEl.textContent = "Planlı";
                    setBottomHint("", "");
                    applyRingRemaining(progressEl, 1);
                    return;
                }

                // 5 dəqiqəlik xəbərdarlıq
                if (untilSec <= 120) {
                    el.classList.add("is-critical");
                } else if (untilSec <= 300) {
                    el.classList.add("is-warn");
                }

                // Pending cards: show only start time (e.g., 17:00). No "Başlayır" line inside ring.
                timerEl.textContent = startLocal.toLocaleTimeString("az-AZ", { hour: "2-digit", minute: "2-digit" });
                if (captionEl) {
                    captionEl.textContent = "Başlayır";
                }
                if (untilSec <= 300) {
                    const minLeft = Math.max(0, Math.ceil(untilSec / 60));
                    setBottomHint(`${minLeft} dəqiqə qaldı`, untilSec <= 120 ? "critical" : "warn");
                } else {
                    setBottomHint("", "");
                }
                applyRingRemaining(progressEl, 1);
                return;
            }

            if (nowMs >= endMs) {
                el.classList.add("is-done");
                timerEl.textContent = "00:00";
                if (captionEl) {
                    captionEl.textContent = "Vaxt bitib";
                }
                if (!setEquipmentReturnHint()) {
                    setBottomHint("", "");
                }
                applyRingRemaining(progressEl, 0);
                return;
            }

            // For Active sessions, show remaining TRAINING time (exclude 10-min buffer).
            // Buffer is a reservation rule, not the customer's training time.
            const trainingEndMs = Math.max(startMs, endMs - SESSION_BUFFER_MS);
            const trainingRemainingMs = trainingEndMs - nowMs;
            const trainingRemainingSec = Math.floor(trainingRemainingMs / 1000);

            // If training already ended, we're in cleanup/buffer window.
            if (trainingRemainingMs <= 0) {
                const bufferRemainingMs = Math.max(0, endMs - nowMs);
                el.classList.add("is-idle");
                timerEl.textContent = "00:00";
                if (captionEl) captionEl.textContent = "Təmizlik";
                if (!setEquipmentReturnHint()) {
                    setBottomHint("", "");
                }
                applyRingRemaining(progressEl, 0);
                return;
            }

            const frac = (trainingEndMs - startMs) > 0 ? trainingRemainingMs / (trainingEndMs - startMs) : 0;
            el.classList.add("is-live");
            if (trainingRemainingSec <= COUNTDOWN_CRIT_SEC) {
                el.classList.add("is-critical");
            } else if (trainingRemainingSec <= COUNTDOWN_WARN_SEC) {
                el.classList.add("is-warn");
            }

            timerEl.textContent = formatSeconds(trainingRemainingMs);
            if (captionEl) captionEl.textContent = "Qalan vaxt";

            if (trainingRemainingSec <= COUNTDOWN_WARN_SEC) {
                const minLeft = Math.max(0, Math.ceil(trainingRemainingSec / 60));
                setBottomHint(`${minLeft} dəqiqə qaldı`, trainingRemainingSec <= COUNTDOWN_CRIT_SEC ? "critical" : "warn");
            } else {
                setBottomHint("", "");
            }

            applyRingRemaining(progressEl, frac);
        });
    }

    function restoreLaneDrafts() {
        document.querySelectorAll(".lane-score-input").forEach(input => {
            const sid = input.getAttribute("data-session-id");
            if (!sid) {
                return;
            }

            const key = `session-${sid}`;
            if (Object.prototype.hasOwnProperty.call(laneScoreDraft, key)) {
                input.value = laneScoreDraft[key];
            }
        });
    }

    let laneEventsDelegated = false;

    // HTML yenilənəndə təkrar listener yığmır (yeniləmə yavaşlayırdı).
    function ensureLaneEventDelegation() {
        if (laneEventsDelegated) return;
        laneEventsDelegated = true;

        const onScoreInput = (event) => {
            const target = event.target;
            if (!(target instanceof HTMLInputElement) || !target.classList.contains("lane-score-input")) {
                return;
            }
            const laneNumber = target.getAttribute("data-lane-number");
            const sessionId = target.getAttribute("data-session-id");
            if (!laneNumber && !sessionId) return;
            const key = sessionId ? `session-${sessionId}` : `lane-${laneNumber}`;
            laneScoreDraft[key] = target.value;
        };

        const onLanePanelClick = async (event) => {
            const raw = event.target;
            if (!(raw instanceof HTMLElement)) return;

            const submitBtn = raw.closest("[data-submit-lane-score]");
            if (submitBtn instanceof HTMLButtonElement) {
                const sessionId = submitBtn.getAttribute("data-session-id");
                const laneNumber = Number(submitBtn.getAttribute("data-lane-number"));
                const nextRound = Number(submitBtn.getAttribute("data-next-round"));
                if (!sessionId) {
                    alert("Bu zolaqda aktiv sessiya yoxdur.");
                    return;
                }
                const key = `session-${sessionId}`;
                const value = Number(laneScoreDraft[key] ?? "");
                if (!Number.isFinite(value) || value < 0 || value > 10) {
                    alert("Xal 0 ilə 10 arasında olmalıdır.");
                    return;
                }
                await submitLaneScore(sessionId, laneNumber, nextRound, value);
                return;
            }

            const pickBtn = raw.closest(".pick-session");
            if (pickBtn instanceof HTMLElement) {
                const selected = pickBtn.getAttribute("data-session-id");
                if (!selected) return;
                const pickedLane = latestLanes.find(x => x.sessionId === selected);
                if (pickedLane?.laneNumber && tabletLaneNumberInput) {
                    tabletLaneNumberInput.value = String(pickedLane.laneNumber);
                }
                if (tabletSessionIdInput) {
                    tabletSessionIdInput.value = selected;
                }
                syncTabletScoreContext();
                return;
            }

            const stopBtn = raw.closest("[data-stop-session]");
            if (stopBtn instanceof HTMLElement) {
                const selected = stopBtn.getAttribute("data-stop-session");
                if (!selected) return;
                const pendingRental = stopBtn.getAttribute("data-pending-rental-equipment") === "1";
                if (pendingRental) {
                    alert("Stop etmək üçün əvvəlcə icarə avadanlığını planşetdən təhvil alın.");
                    return;
                }
                const ok = window.confirm(buildStopSessionConfirmMessage(selected));
                if (!ok) return;
                await stopSession(selected);
            }
        };

        laneGrid?.addEventListener("input", onScoreInput);
        dashboardRows?.addEventListener("input", onScoreInput);
        laneGrid?.addEventListener("click", onLanePanelClick);
        dashboardRows?.addEventListener("click", onLanePanelClick);
    }

    function formatHeaderDate(value) {
        const d = value instanceof Date ? value : new Date();
        const day = String(d.getDate()).padStart(2, "0");
        const month = String(d.getMonth() + 1).padStart(2, "0");
        const year = d.getFullYear();
        return `${day}.${month}.${year}`;
    }

    function startCountdownTicker() {
        if (countdownTimerId) {
            clearInterval(countdownTimerId);
        }

        const tick = () => {
            const now = new Date();
            const wall = document.getElementById("wallClock");
            const wallDate = document.getElementById("wallDate");
            if (wallDate) {
                wallDate.textContent = formatHeaderDate(now);
            }
            if (wall) {
                wall.textContent = now.toLocaleTimeString("az-AZ", {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                });
            }
            updateCountdownRings();
        };

        tick();
        countdownTimerId = setInterval(tick, 1000);
    }

