    async function cancelSubscription(athleteId) {
        const response = await apiFetch("/subscriptions/cancel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ athleteId })
        });

        if (!response.ok) {
