    function parseWeeklyDaysCsv(csv) {
        if (!csv) return [];
        return String(csv)
            .split(/[,;\s-]+/)
            .map(x => Number.parseInt(x, 10))
            .filter(n => Number.isInteger(n) && n >= 0 && n <= 6);
    }

    function getPackageWeeklyDaysLimit(pkg) {
        const n = Number(pkg?.weeklyDaysCount ?? 0);
        return Number.isInteger(n) && n >= 1 && n <= 7 ? n : null;
    }

    function syncBookingSubscriptionDayLimit() {
        const pkg = getSelectedBookingPackage();
        const limit = getPackageWeeklyDaysLimit(pkg);
        const hint = document.getElementById("bookingSubscriptionDaysHint");
        const boxes = Array.from(document.querySelectorAll("#bookingSubscriptionDays .booking-sub-day"))
            .filter(el => el instanceof HTMLInputElement);
        if (limit == null) {
            boxes.forEach(b => { b.disabled = false; });
            if (hint instanceof HTMLElement) {
                hint.textContent = "Həftə günlərini seçin. Seçdiyin hər gün üçün aşağıda saat (və peşəkar/məşqçi üçün zolaq qrupu) təyin edin. Konkret zolaq müştəri gələndə seçilir.";
            }
            return;
        }
        if (hint instanceof HTMLElement) {
            hint.textContent = `Bu paket həftədə ${limit} gün üçündür — ${limit} gün seçin. Seçdiyin hər gün üçün saat (və zolaq qrupu) təyin edin.`;
        }
        let checked = boxes.filter(b => b.checked);
        if (checked.length > limit) {
            for (let i = limit; i < checked.length; i++) {
                checked[i].checked = false;
            }
            checked = boxes.filter(b => b.checked);
        }
        const atLimit = checked.length >= limit;
        boxes.forEach(b => {
            b.disabled = atLimit && !b.checked;
        });
    }

